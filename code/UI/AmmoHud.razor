@using Sandbox;
@using Sandbox.UI;
@using Minimal.Toolgun;
@using Minimal.Weapons;
@inherits PanelComponent
@namespace Sandbox

<root>
	@if (ShouldShow)
	{
		<div class="ammo-panel">
			<div class="ammo-value @(!IsToolgun && CurrentAmmo <= 0 ? "empty" : "")">@AmmoDisplayText</div>
		</div>
	}
</root>

@code
{
	Weapon CurrentWeapon => Player.Local?.CurrentWeapon;
	bool IsToolgun => CurrentWeapon is WeaponToolgun;
	bool ShouldShow => Player.Local?.IsDead != true && CurrentWeapon != null && (CurrentWeapon.UsesAmmunition || IsToolgun);
	int CurrentAmmo => CurrentWeapon?.Ammo ?? 0;
	/// <summary>Запас патронов вне магазина (поле <see cref="Weapon.TotalReserveAmmo"/>).</summary>
	int TotalAmmo => CurrentWeapon?.TotalReserveAmmo ?? 0;
	string AmmoDisplayText => IsToolgun
		? GetSelectedToolTitle()
		: $"{CurrentAmmo}/{TotalAmmo}";

	string GetSelectedToolTitle()
	{
		var tool = ToolgunClientState.SelectedTool;
		return tool is null ? GameLocalization.Phrase( "ui.common.none", "None" ) : GameLocalization.Phrase( $"tool.{tool.Id}.title", tool.Title );
	}

	protected override int BuildHash() => System.HashCode.Combine(
		Player.Local?.CurrentWeapon?.GetHashCode() ?? 0,
		CurrentWeapon?.Ammo ?? 0,
		CurrentWeapon?.TotalReserveAmmo ?? 0,
		ToolgunClientState.SelectedToolId,
		ToolgunClientState.Version,
		Player.Local?.IsDead ?? false,
		GameLocalization.CurrentCode
	);
}
