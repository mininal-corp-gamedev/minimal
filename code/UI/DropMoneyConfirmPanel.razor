@using Sandbox
@using Sandbox.UI
@using System
@inherits PanelComponent
@namespace Sandbox

<root>
	@if ( IsOpen && UiModalManager.IsActive( ModalId ) )
	{
		<div class="money-confirm-overlay">
			<div class="money-confirm-panel" @ref="FocusSinkRef">
				<div class="panel-title">Выкинуть деньги</div>
				<div class="panel-subtitle">Сумма будет создана перед тобой.</div>

				<div class="field-label">Сумма</div>
				<TextEntry class="money-input" Value:bind="@AmountInput" Placeholder="Например: 250" onsubmit="@Submit"></TextEntry>

				<div class="actions">
					<button class="secondary" onclick=@Close>Закрыть</button>
					<button class="primary" onclick=@Submit>Выкинуть</button>
				</div>
			</div>
		</div>
	}
</root>

@code
{
	private const string ModalId = nameof( DropMoneyConfirmPanel );
	public static DropMoneyConfirmPanel Instance { get; private set; }

	[Property] public float DropCooldown { get; set; } = 5f;

	private bool IsOpen { get; set; }
	private string AmountInput { get; set; } = "";
	private Panel FocusSinkRef { get; set; }
	private TimeUntil _nextDropAllowed;

	public static void Open()
	{
		EnsureInstance();
		Instance?.OpenInternal();
	}

	private static void EnsureInstance()
	{
		if ( Instance.IsValid() )
			return;

		var scene = Game.ActiveScene;
		if ( scene is null )
			return;

		var panelObject = scene.CreateObject();
		panelObject.Name = "DropMoneyConfirmPanel";
		panelObject.Components.Create<DropMoneyConfirmPanel>();
	}

		private void SetOpen( bool open )
	{
		if ( open )
			UiModalManager.Open( ModalId );
		else
			UiModalManager.Close( ModalId );

		IsOpen = open;

		Crosshair.SetBlocked( ModalId, open );

		UiModalManager.UpdateMouseVisibility();
		StateHasChanged();
	}

	private void OpenInternal()
	{
		AmountInput = "";
		SetOpen(true);
	}

	private void Close()
	{
		SetOpen(false);
		FocusSinkRef?.Focus();
	}

	private void Submit()
	{
		FocusSinkRef?.Focus();

		if ( !_nextDropAllowed )
		{
			Notification.Error( $"Подожди ещё {_nextDropAllowed:F1} сек.", 3.5f );
			return;
		}

		if ( !TryParseAmount( AmountInput, out var amount ) )
		{
			Notification.Error( "Укажи корректную сумму.", 3.5f );
			return;
		}

		_nextDropAllowed = DropCooldown;
		Close();
		Player.Local?.RequestDropMoney( amount );
	}

	private static bool TryParseAmount( string text, out int amount )
	{
		amount = 0;
		return int.TryParse( (text ?? "").Trim(), out amount ) && amount > 0;
	}

	protected override void OnStart()
	{
		if ( Instance.IsValid() && Instance != this )
			return;

		Instance = this;
		UiModalManager.ActiveModalChanged += OnActiveModalChanged;
	}

	protected override void OnDestroy()
	{
		UiModalManager.ActiveModalChanged -= OnActiveModalChanged;
		ReleaseCrosshairBlock();

		if ( Instance == this )
			Instance = null;
	}

	protected override void OnDisabled()
	{
		ReleaseCrosshairBlock();
	}

	private void ReleaseCrosshairBlock()
	{
		IsOpen = false;
		Crosshair.SetBlocked( ModalId, false );
		UiModalManager.Close( ModalId );
	}

	private void OnActiveModalChanged( string activeModal )
	{
		if ( activeModal == ModalId || !IsOpen )
			return;

		IsOpen = false;
		AmountInput = "";
		FocusSinkRef?.Focus();
		Crosshair.SetBlocked( ModalId, false );
		StateHasChanged();
	}

	protected override int BuildHash() => HashCode.Combine( IsOpen, UiModalManager.Version, AmountInput );
}
