	private static IReadOnlyList<string> GetClanLogoPaneStyles( ClanBackgroundType type, string color1, string color2, string color3, string color4 )
	{
		var c1 = ColorCss( ClanPalette.NormalizeColorId( color1, "black" ) );
		var c2 = ColorCss( ClanPalette.NormalizeColorId( color2, "black" ) );
		var c3 = ColorCss( ClanPalette.NormalizeColorId( color3, "black" ) );
		var c4 = ColorCss( ClanPalette.NormalizeColorId( color4, "black" ) );

		return type switch
		{
			ClanBackgroundType.VerticalTwo => new[]
			{
				PaneStyle( 0, 0, 50, 100, c1 ),
				PaneStyle( 50, 0, 50, 100, c2 )
			},
			ClanBackgroundType.VerticalThree => new[]
			{
				PaneStyle( 0, 0, 33.34f, 100, c1 ),
				PaneStyle( 33.34f, 0, 33.33f, 100, c2 ),
				PaneStyle( 66.67f, 0, 33.33f, 100, c3 )
			},
			ClanBackgroundType.HorizontalTwo => new[]
			{
				PaneStyle( 0, 0, 100, 50, c1 ),
				PaneStyle( 0, 50, 100, 50, c2 )
			},
			ClanBackgroundType.HorizontalThree => new[]
			{
				PaneStyle( 0, 0, 100, 33.34f, c1 ),
				PaneStyle( 0, 33.34f, 100, 33.33f, c2 ),
				PaneStyle( 0, 66.67f, 100, 33.33f, c3 )
			},
			ClanBackgroundType.Quarter => new[]
			{
				PaneStyle( 0, 0, 50, 50, c1 ),
				PaneStyle( 50, 0, 50, 50, c2 ),
				PaneStyle( 0, 50, 50, 50, c3 ),
				PaneStyle( 50, 50, 50, 50, c4 )
			},
			_ => new[]
			{
				PaneStyle( 0, 0, 100, 100, c1 )
			}
		};
	}

