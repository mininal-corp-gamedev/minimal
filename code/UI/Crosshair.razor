@using Sandbox
@using Sandbox.UI
@inherits PanelComponent
@namespace Sandbox

<root>
	@if ( ShouldShow )
	{
		<div class="crosshair"></div>
	}
</root>

@code
{
	bool ShouldShow => !UiModalManager.HasActiveModal && Player.Local?.IsDead != true;

	protected override void OnStart()
	{
		UiModalManager.ActiveModalChanged += OnModalChanged;
	}

	protected override void OnDestroy()
	{
		UiModalManager.ActiveModalChanged -= OnModalChanged;
	}

	private void OnModalChanged( string _ )
	{
		StateHasChanged();
	}

	/// <summary>Legacy API — menus already use <see cref="UiModalManager"/>.</summary>
	public static void SetBlocked( string source, bool blocked )
	{
	}

	public static void EnsureExists()
	{
		CrosshairRuntime.EnsureExists();
	}

	public void SetVisible( bool visible )
	{
	}

	protected override int BuildHash()
	{
		return HashCode.Combine(
			ShouldShow,
			UiModalManager.Version,
			Player.Local?.IsDead == true,
			GameLocalization.CurrentCode );
	}
}
