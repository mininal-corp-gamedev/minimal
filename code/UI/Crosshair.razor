@using Sandbox
@using Sandbox.UI
@inherits PanelComponent

<root>
	@if (ShowCrosshair)
	{
		<div class="crosshair"></div>
	}
</root>

<style>
root {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 100%;
	height: 100%;
	pointer-events: none;
}

.crosshair {
	position: absolute;
	left: 50%;
	top: 50%;
	width: 6px;
	height: 6px;
	margin-left: -3px;
	margin-top: -3px;
	background-color: white;
	border-radius: 3px;
}
</style>

@code
{
	[Property] public bool ShowCrosshair { get; set; } = true;

	public void SetVisible( bool visible )
	{
		ShowCrosshair = visible;
		StateHasChanged();
	}

	protected override int BuildHash()
	{
		return ShowCrosshair ? 1 : 0;
	}
}