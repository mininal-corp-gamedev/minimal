@using Sandbox;
@using Sandbox.UI;
@using System;
@inherits PanelComponent
@namespace Sandbox

<root>
	@if ( Door is null )
	{
	}
	else if ( Door.IsBlocked )
	{
		@if ( !string.IsNullOrWhiteSpace( Door.Header ) )
		{
			<div class="header-only">@Door.Header</div>
		}
	}
	else if ( Door.HasOnlyJobs )
	{
		<div class="panel">
			<div class="title">@Door.Header</div>
			@if ( Door.IsLocalPlayerJobAllowed )
			{
				<div class="status">
					@if ( Door.LockState == Door.DoorLockState.Locked )
					{
						<div class="status-locked">@GameLocalization.Phrase( "ui.door.locked" )</div>
					}
					else
					{
						<div class="status-unlocked">@GameLocalization.Phrase( "ui.door.unlocked" )</div>
					}
				</div>
			}
		</div>
	}
	else if ( !Door.HasOwner )
	{
		<div class="panel">
			<div class="title">@Door.Header</div>
			<div class="price">$@Door.BuyPrice</div>
		</div>
	}
	else
	{
		<div class="panel">
			<div class="title">@Door.OwnerDisplayName</div>
			@if ( Door.IsLocalPlayerOwner || Door.IsLocalPlayerRoommate )
			{
				<div class="status">
					@if ( Door.LockState == Door.DoorLockState.Locked )
					{
						<div class="status-locked">@GameLocalization.Phrase( "ui.door.locked" )</div>
					}
					else
					{
						<div class="status-unlocked">@GameLocalization.Phrase( "ui.door.unlocked" )</div>
					}
				</div>
				@if ( Door.IsLocalPlayerRoommate && !Door.IsLocalPlayerOwner )
				{
					<div class="status-roommate">@GameLocalization.Phrase( "ui.door.you_are_roommate" )</div>
				}
			}
		</div>
	}
</root>

@code
{
	[Property] public Door Door { get; set; }

	public void WorldHudRefresh() => StateHasChanged();

	protected override int BuildHash()
	{
		var h = new HashCode();
		h.Add( Door );
		h.Add( GameLocalization.CurrentCode );
		h.Add( Door?.Header );
		h.Add( Door?.IsBlocked );
		h.Add( Door?.HasOnlyJobs );
		h.Add( Door?.IsLocalPlayerJobAllowed );
		h.Add( Door?.HasOwner );
		h.Add( Door?.OwnerDisplayName );
		h.Add( Door?.LockState );
		h.Add( Door?.IsLocalPlayerOwner );
		h.Add( Door?.IsLocalPlayerRoommate );
		h.Add( Door?.BuyPrice );
		return h.ToHashCode();
	}
}
