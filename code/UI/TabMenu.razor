	private void PromoteClanMember( ClanMemberSummary member )
	{
		if ( member is null || !CanPromoteClanMember( member ) )
			return;

		ClanManager.RpcRequestSetMemberRank( member.SteamId, Math.Clamp( (int)member.Rank + 1, 0, (int)ClanRank.DeputyLeader ) );
	}

	private void DemoteClanMember( ClanMemberSummary member )
	{
		if ( member is null || !CanDemoteClanMember( member ) )
			return;

		ClanManager.RpcRequestSetMemberRank( member.SteamId, Math.Clamp( (int)member.Rank - 1, 0, (int)ClanRank.DeputyLeader ) );
	}

	private bool CanManageClanMember( ClanMemberSummary member )
	{
		if ( member is null || member.SteamId == LocalSteamId() || member.Rank == ClanRank.Leader )
			return false;

		var rank = Player.Local?.ClanRank ?? ClanRank.Soldier;
		return rank == ClanRank.Leader || (rank == ClanRank.DeputyLeader && member.Rank < ClanRank.DeputyLeader);
	}

	private bool CanPromoteClanMember( ClanMemberSummary member )
	{
		if ( !CanManageClanMember( member ) )
			return false;

		var rank = Player.Local?.ClanRank ?? ClanRank.Soldier;
		if ( rank == ClanRank.DeputyLeader )
			return member.Rank < ClanRank.Officer;

		return member.Rank < ClanRank.DeputyLeader;
	}

	private bool CanDemoteClanMember( ClanMemberSummary member )
	{
		return CanManageClanMember( member ) && member.Rank > ClanRank.Soldier;
	}

	private long LocalSteamId() => Connection.Local?.SteamId.Value ?? 0L;

	private static string GetRankName( ClanRank rank ) => rank switch
	{
		ClanRank.Leader => "Leader",
		ClanRank.DeputyLeader => "Deputy Leader",
		ClanRank.Officer => "Officer",
		_ => "Soldier"
	};

	private static string ClampText( string value, int maxLength )
	{
		var text = value ?? string.Empty;
		return text.Length <= maxLength ? text : text[..maxLength];
	}

	private static string FormatClanDate( string rawDate )
	{
		if ( DateTimeOffset.TryParse( rawDate, CultureInfo.InvariantCulture, DateTimeStyles.AssumeUniversal, out var value ) )
			return value.LocalDateTime.ToString( "dd-MM-yyyy HH:mm", CultureInfo.InvariantCulture );

		return string.IsNullOrWhiteSpace( rawDate ) ? "-" : rawDate;
	}

