@using Sandbox
@using Sandbox.UI
@using System
@using System.Collections.Generic
@using System.Linq
@inherits PanelComponent
@namespace Sandbox

<root>
	@if ( IsOpen && UiModalManager.IsActive( ModalId ) )
	{
		<div class="overlay">
			<div class="admin-panel" @ref="FocusSinkRef">
				<button class="close-btn" onclick=@(() => SetOpen( false ))>X</button>
				<div class="sidebar">
					<div class="sidebar-profile">
						<div class="sb-name">@(Connection.Local?.DisplayName ?? "-")</div>
						<div class="sb-rank">@GameLocalization.Format( "ui.admin.rank", "Rank {0}: {1}", CurrentRank, AdminManager.GetRankName( CurrentRank ) )</div>
					</div>

					<div class="sidebar-nav">
						@foreach ( var ability in VisibleAbilities )
						{
							<button class="tab-btn @(ActiveAbility == ability.Id ? "active" : "")" onclick=@(() => SelectAbility( ability.Id ))>@GetAbilityTitle( ability )</button>
						}
					</div>
				</div>

				<div class="content-area">
					@if ( ActiveDefinition is null )
					{
						<div class="page">
							<div class="page-title">@GameLocalization.Phrase( "ui.admin.title" )</div>
							<div class="page-placeholder">@GameLocalization.Phrase( "ui.admin.no_abilities" )</div>
						</div>
					}
					else
					{
						<div class="page">
							<div class="page-title">@GetAbilityTitle( ActiveDefinition )</div>
							<div class="page-subtitle">@GetAbilityDescription( ActiveDefinition )</div>

							@if ( ActiveDefinition.NeedsOnlinePlayer )
							{
								<div class="field-label">@GameLocalization.Phrase( "ui.admin.online_player" )</div>
								<div class="player-list-area">
									<div class="player-list">
										@foreach ( var conn in CachedPlayers )
										{
											<button class="player-row @(SelectedSteamId == conn.SteamId.Value ? "active" : "")" onclick=@(() => SelectPlayer( conn.SteamId.Value ))>
												<div class="player-avatar" style="background-image: url( avatar:@conn.SteamId.Value )"></div>
												<div class="player-main">
													<div class="player-name">@conn.DisplayName</div>
													<div class="player-steamid">@conn.SteamId.Value</div>
												</div>
												@if ( SelectedSteamId == conn.SteamId.Value )
												{
													<div class="player-selected">@GameLocalization.Phrase( "ui.admin.selected" )</div>
												}
												<div class="player-ping">@conn.Ping ms</div>
											</button>
										}
									</div>
									<div class="scrollbar-placeholder"></div>
								</div>
							}

							@if ( ActiveDefinition.NeedsSteamIdInput )
							{
								<div class="field-label">SteamId</div>
								<TextEntry @ref="SteamIdEntryRef" class="admin-input" Value:bind="@SteamIdInput" Placeholder="SteamId" onsubmit="@SubmitActiveAbility"></TextEntry>
							}

							@if ( ActiveDefinition.NeedsValue )
							{
								<div class="field-label">@GetAbilityValueLabel( ActiveDefinition )</div>
								<TextEntry @ref="ValueEntryRef" class="admin-input" Value:bind="@ValueInput" Placeholder="@GetAbilityValuePlaceholder( ActiveDefinition )" onsubmit="@SubmitActiveAbility"></TextEntry>
							}

							@if ( ActiveDefinition.NeedsReason )
							{
								<div class="field-label">@GameLocalization.Phrase( "ui.admin.reason" )</div>
								<TextEntry @ref="ReasonEntryRef" class="admin-input" Value:bind="@ReasonInput" Placeholder="@GameLocalization.Phrase( "ui.admin.reason", "Reason" )" onsubmit="@SubmitActiveAbility"></TextEntry>
							}

							<button class="execute-btn" onclick=@(() => SubmitActiveAbility())>@GameLocalization.Phrase( "ui.admin.execute" )</button>
						</div>
					}
				</div>
			</div>
		</div>
	}
</root>

@code
{
	private const string ModalId = nameof( AdminPanel );
	private readonly List<AdminAbilityDefinition> Abilities = new()
	{
		new( "kick", "Kick", "Kick an online player from the server.", 1, true, false, false, true, "", "" ),
		new( "ban", "Ban", "Ban a SteamId permanently.", 2, false, true, false, true, "", "" ),
		new( "unban", "Unban", "Remove a SteamId from the ban list.", 2, false, true, false, false, "", "" ),
		new( "spawn", "Spawn", "Respawn an online player.", 1, true, false, false, false, "", "" ),
		new( "setmoney", "Set Money", "Set money for an online player.", 2, true, false, true, false, "Money", "Value" ),
		new( "sethp", "Set HP", "Set health for an online player.", 2, true, false, true, false, "Health", "Value" ),
		new( "kill", "Kill", "Kill an online player.", 2, true, false, false, false, "", "" ),
		new( "setjob", "Set Job", "Set job for an online player by job id.", 2, true, false, true, false, "Job ID", "citizen" ),
		new( "selldoor", "Sell Door", "Force-sell the door you are looking at.", 1, false, false, false, false, "", "" ),
		new( "goto", "Goto", "Teleport yourself to an online player.", 1, true, false, false, false, "", "" ),
		new( "tp", "TP", "Teleport an online player to you.", 1, true, false, false, false, "", "" ),
		new( "return", "Return", "Return a teleported player to the saved position.", 1, true, false, false, false, "", "" ),
		new( "giverank", "Give Rank", "Give an admin rank to a SteamId.", 3, false, true, true, false, "Rank", "0-3" )
	};

	private bool IsOpen { get; set; }
	private string ActiveAbility { get; set; } = "";
	private List<Connection> CachedPlayers { get; set; } = new();
	private long SelectedSteamId { get; set; }
	private string SteamIdInput { get; set; } = "";
	private string ValueInput { get; set; } = "";
	private string ReasonInput { get; set; } = "";
	private int PlayersVersion { get; set; }
	private Panel FocusSinkRef { get; set; }
	private TextEntry SteamIdEntryRef { get; set; }
	private TextEntry ValueEntryRef { get; set; }
	private TextEntry ReasonEntryRef { get; set; }

	private int CurrentRank => Player.Local?.AdminRank ?? 0;
	private IEnumerable<AdminAbilityDefinition> VisibleAbilities => Abilities.Where( x => CurrentRank >= x.RequiredRank );
	private AdminAbilityDefinition ActiveDefinition => Abilities.FirstOrDefault( x => x.Id == ActiveAbility && CurrentRank >= x.RequiredRank );

	private static string GetAbilityTitle( AdminAbilityDefinition ability )
	{
		return ability is null ? string.Empty : GameLocalization.Phrase( $"admin.ability.{ability.Id}.title", ability.Title );
	}

	private static string GetAbilityDescription( AdminAbilityDefinition ability )
	{
		return ability is null ? string.Empty : GameLocalization.Phrase( $"admin.ability.{ability.Id}.description", ability.Description );
	}

	private static string GetAbilityValueLabel( AdminAbilityDefinition ability )
	{
		return ability is null ? string.Empty : GameLocalization.Phrase( $"admin.ability.{ability.Id}.value_label", ability.ValueLabel );
	}

	private static string GetAbilityValuePlaceholder( AdminAbilityDefinition ability )
	{
		return ability is null ? string.Empty : GameLocalization.Phrase( $"admin.ability.{ability.Id}.value_placeholder", ability.ValuePlaceholder );
	}

	private void SetOpen( bool open )
	{
		if ( open )
			UiModalManager.Open( ModalId );
		else
			UiModalManager.Close( ModalId );

		IsOpen = open;
		Crosshair.SetBlocked( ModalId, open );
		UiModalManager.UpdateMouseVisibility();
		StateHasChanged();
	}

	private void OnActiveModalChanged( string activeModal )
	{
		if ( activeModal == ModalId || !IsOpen )
			return;

		IsOpen = false;
		ClearFormState();
		CachedPlayers.Clear();
		Crosshair.SetBlocked( ModalId, false );
		StateHasChanged();
	}

	private void SelectAbility( string id )
	{
		ActiveAbility = id;
		ClearTextFocus();
		ClearFormState();
		RefreshPlayers();
	}

	private void SelectPlayer( long steamId )
	{
		ClearTextFocus();
		SelectedSteamId = steamId;
		SteamIdInput = steamId.ToString();
	}

	private void RefreshPlayers()
	{
		CachedPlayers = Connection.All.ToList();
		PlayersVersion++;
	}

	private void ClearFormState()
	{
		SelectedSteamId = 0;
		SteamIdInput = "";
		ValueInput = "";
		ReasonInput = "";
	}

	private void ClearTextFocus()
	{
		SteamIdEntryRef?.Blur();
		ValueEntryRef?.Blur();
		ReasonEntryRef?.Blur();
	}

	private long GetTargetSteamId()
	{
		if ( ActiveDefinition?.NeedsOnlinePlayer == true )
			return SelectedSteamId;

		if ( long.TryParse( (SteamIdInput ?? "").Trim(), out var steamId ) && steamId > 0 )
			return steamId;

		return 0;
	}

	private void SubmitActiveAbility()
	{
		ClearTextFocus();

		var ability = ActiveDefinition;
		if ( ability is null )
			return;

		if ( CurrentRank < ability.RequiredRank )
		{
			Notification.Error( GameLocalization.Phrase( "notify.admin.access_denied", "Access denied." ), 3f );
			return;
		}

		var steamId = GetTargetSteamId();
		if ( (ability.NeedsOnlinePlayer || ability.NeedsSteamIdInput) && steamId == 0 )
		{
			Notification.Error( GameLocalization.Phrase( "notify.admin.invalid_steamid", "Invalid SteamId." ), 3f );
			return;
		}

		switch ( ability.Id )
		{
			case "kick":
				AdminManager.RpcRequestKick( steamId, ReasonInput );
				break;
			case "ban":
				AdminManager.RpcRequestBan( steamId, ReasonInput );
				break;
			case "unban":
				AdminManager.RpcRequestUnban( steamId );
				break;
			case "spawn":
				AdminManager.RpcRequestSpawn( steamId );
				break;
			case "setmoney":
				if ( int.TryParse( ValueInput, out var money ) ) AdminManager.RpcRequestSetMoney( steamId, money );
				else Notification.Error( GameLocalization.Phrase( "notify.admin.invalid_money", "Invalid money value." ), 3f );
				break;
			case "sethp":
				if ( float.TryParse( ValueInput, out var hp ) ) AdminManager.RpcRequestSetHp( steamId, hp );
				else Notification.Error( GameLocalization.Phrase( "notify.admin.invalid_hp", "Invalid hp value." ), 3f );
				break;
			case "kill":
				AdminManager.RpcRequestKill( steamId );
				break;
			case "setjob":
				AdminManager.RpcRequestSetJob( steamId, ValueInput );
				break;
			case "selldoor":
				SendSellDoorRequest();
				break;
			case "goto":
				AdminManager.RpcRequestGoto( steamId );
				break;
			case "tp":
				AdminManager.RpcRequestTp( steamId );
				break;
			case "return":
				AdminManager.RpcRequestReturn( steamId );
				break;
			case "giverank":
				if ( int.TryParse( ValueInput, out var rank ) ) AdminManager.RpcRequestGiveRank( steamId, rank );
				else Notification.Error( GameLocalization.Phrase( "notify.admin.invalid_rank", "Invalid rank value." ), 3f );
				break;
		}
	}

	private void SendSellDoorRequest()
	{
		var controller = Player.Local?.Controller;
		if ( controller.IsValid() )
		{
			var eye = controller.EyeTransform;
			AdminManager.RpcRequestSellDoorAt( eye.Position, eye.Forward );
			return;
		}

		AdminManager.RpcRequestSellDoor();
	}

	protected override void OnUpdate()
	{
		if ( CurrentRank <= 0 )
		{
			if ( IsOpen )
				SetOpen( false );

			UiModalManager.UpdateMouseVisibility();

			return;
		}

		if ( Input.Pressed( "AdminPanel" ) )
		{
			SetOpen( !IsOpen );
			if ( IsOpen )
			{
				ClearFormState();
				RefreshPlayers();
				if ( string.IsNullOrEmpty( ActiveAbility ) || ActiveDefinition is null )
					ActiveAbility = VisibleAbilities.FirstOrDefault()?.Id ?? "";
			}
		}

		UiModalManager.UpdateMouseVisibility();
	}

	protected override void OnStart()
	{
		UiModalManager.ActiveModalChanged += OnActiveModalChanged;
	}

	protected override void OnDisabled()
	{
		ReleaseCrosshairBlock();
	}

	protected override void OnDestroy()
	{
		UiModalManager.ActiveModalChanged -= OnActiveModalChanged;
		ReleaseCrosshairBlock();
	}

	private void ReleaseCrosshairBlock()
	{
		IsOpen = false;
		Crosshair.SetBlocked( ModalId, false );
		UiModalManager.Close( ModalId );
	}

	protected override int BuildHash()
	{
		var fieldsHash = HashCode.Combine(
			SteamIdInput,
			ValueInput,
			ReasonInput,
			PlayersVersion,
			CachedPlayers.Count );

		return HashCode.Combine(
			IsOpen,
			IsOpen ? (int)Time.Now : 0,
			UiModalManager.Version,
			ActiveAbility,
			CurrentRank,
			GameLocalization.CurrentCode,
			SelectedSteamId,
			fieldsHash );
	}
}
