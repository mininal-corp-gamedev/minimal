@using Sandbox;
@using Sandbox.UI;
@using System;
@inherits PanelComponent
@namespace Sandbox

<root>
	<div class="slot-panel @VisualState">
		<div class="slot-core frame">
			<div class="multiplier">x(@Multiplier)</div>
		</div>
		<div class="slot-core payout">
			<div class="label">Payout</div>
			<div class="price">$@PotentialPayout</div>
		</div>
		<div class="status">@StatusText</div>
		<div class="hint">E</div>
	</div>
</root>

@code
{
	SlotMachine Machine => Components.Get<SlotMachine>( FindMode.EverythingInSelfAndAncestors );

	int Multiplier => Math.Max( 1, Machine?.LocalMultiplier ?? 1 );
	int PotentialPayout => Math.Max( 0, Machine?.LocalPotentialPayout ?? 0 );
	string StatusText => string.IsNullOrWhiteSpace( Machine?.LocalStatusText ) ? "Ready" : Machine.LocalStatusText;
	string VisualState => Machine?.LocalVisualState ?? "idle";

	protected override int BuildHash() => HashCode.Combine( Multiplier, PotentialPayout, StatusText, VisualState );
}
