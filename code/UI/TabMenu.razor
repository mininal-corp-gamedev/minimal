	private static Player FindPlayerBySteamId( long steamId )
	{
		var scene = Game.ActiveScene;
		if ( scene is null )
			return null;

		foreach ( var player in scene.GetAllComponents<Player>() )
		{
			if ( player.GameObject.Network.Owner?.SteamId.Value == steamId )
				return player;
		}

		return null;
	}

	protected override void OnStart()
	{
		UiModalManager.ActiveModalChanged += OnActiveModalChanged;
		ClanManager.ClanResultReceived += OnClanResultReceived;
		LoadJobs();
		LoadShop();
	}

	protected override void OnDisabled()
	{
		ReleaseCrosshairBlock();
	}

	protected override void OnDestroy()
	{
		UiModalManager.ActiveModalChanged -= OnActiveModalChanged;
		ClanManager.ClanResultReceived -= OnClanResultReceived;
		ReleaseCrosshairBlock();
	}

	private void ReleaseCrosshairBlock()
	{
		IsOpen = false;
		Crosshair.SetBlocked( ModalId, false );
		UiModalManager.Close( ModalId );
	}

	private void SetOpen( bool open )
	{
		if ( open )
		{
			LoadJobs();
			UiModalManager.Open( ModalId );
		}
		else
		{
			UiModalManager.Close( ModalId );
		}

		IsOpen = open;

		Crosshair.SetBlocked( ModalId, open );
		UiModalManager.UpdateMouseVisibility();
		StateHasChanged();
	}

	private void OnActiveModalChanged( string activeModal )
	{
		if ( activeModal == ModalId || !IsOpen )
			return;

		IsOpen = false;
		Crosshair.SetBlocked( ModalId, false );
		StateHasChanged();
	}

	private void OnClanResultReceived( string message, bool success, string context )
	{
		if ( !string.Equals( context, ClanManager.CreateClanResultContext, StringComparison.Ordinal ) )
			return;

		if ( success )
			ClearCreateClanError();
		else
			SetCreateClanError( message );
	}

	protected override void OnUpdate()
	{
		if ( Input.Pressed( "Score" ) )
			SetOpen( !IsOpen );

		if ( IsDiscordOpening && DiscordCloseAt <= 0f )
		{
			IsDiscordOpening = false;
			StateHasChanged();
		}

		UiModalManager.UpdateMouseVisibility();
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( IsOpen );
		hash.Add( UiModalManager.Version );
		hash.Add( ActiveTab );
		hash.Add( Player.Local?.ClanId ?? -1 );
		hash.Add( Player.Local?.ClanHeader );
		hash.Add( Player.Local?.ClanColorId );
		hash.Add( Player.Local?.ClanRank );
		hash.Add( ClanManager.Instance?.ClanVersion ?? 0 );
		hash.Add( ClanManager.Instance?.PendingInviteVersion ?? 0 );
		hash.Add( ClanManager.Instance?.PendingInviteClanId ?? -1 );
		hash.Add( CreateClanError );
		hash.Add( CreateClanHeader );
		hash.Add( CreateClanDescription );
		hash.Add( CreateClanColorId );
		hash.Add( CreateClanIconPath );
		hash.Add( CreateClanBackgroundType );
		hash.Add( CreateClanBackgroundColor1 );
		hash.Add( CreateClanBackgroundColor2 );
		hash.Add( CreateClanBackgroundColor3 );
		hash.Add( CreateClanBackgroundColor4 );
		hash.Add( EditClanDescription );
		hash.Add( EditClanColorId );
		hash.Add( EditClanIconPath );
		hash.Add( EditClanBackgroundType );
		hash.Add( EditClanBackgroundColor1 );
		hash.Add( EditClanBackgroundColor2 );
		hash.Add( EditClanBackgroundColor3 );
		hash.Add( EditClanBackgroundColor4 );
		hash.Add( GameLocalization.CurrentCode );
		hash.Add( Player.Local?.Money ?? 0 );
		hash.Add( Player.Local?.Job?.JobId );
		hash.Add( Player.Local?.Job?.JobDefinition?.Header );
		hash.Add( GetInventoryHash() );
		hash.Add( Connection.Local?.DisplayName );
		hash.Add( Connection.All.Count );
		hash.Add( GetJobsPopulationHash() );
		hash.Add( GetPlayersJobHash() );
		hash.Add( AvailableJobs.Count );
		hash.Add( VisibleJobs.Count() );
		hash.Add( AvailableShopItems.Count );
		hash.Add( VisibleShopItems.Count() );
		hash.Add( JobsVersion );
		hash.Add( ShopVersion );
		hash.Add( PlayersVersion );
		return hash.ToHashCode();
	}
