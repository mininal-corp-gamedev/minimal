@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Collections.Generic;
@using System.Linq;
@using Minimal.Shop;
@using Ambi.Storage;
@inherits PanelComponent
@namespace Sandbox

<root>
	@if ( IsDiscordOpening )
	{
		<WebPanel class="discord-webpanel" Url="https://discord.gg/minimalrp" />
	}
	@if ( IsOpen && UiModalManager.IsActive( ModalId ) )
	{
		<div class="overlay">
			<div class="tm-panel">

				<div class="sidebar">
					<div class="sidebar-profile">
						<div class="sb-name">@(Connection.Local?.DisplayName ?? "-")</div>
						<div class="sb-job">@GetLocalJobName()</div>
						<div class="sb-money">$@(Player.Local?.Money ?? 0)</div>
					</div>
					<div class="sidebar-nav">
						<button class="tab-btn @(ActiveTab == 0 ? "active" : "")" onclick=@(() => SelectJobsTab())>@GameLocalization.Phrase( "ui.tab.jobs" )</button>
						<button class="tab-btn @(ActiveTab == 1 ? "active" : "")" onclick=@(() => ActiveTab = 1)>@GameLocalization.Phrase( "ui.tab.shop" )</button>
						<button class="tab-btn @(ActiveTab == 2 ? "active" : "")" onclick=@(() => SelectPlayersTab())>@GameLocalization.Phrase( "ui.tab.players" )</button>
						<button class="tab-btn @(ActiveTab == 3 ? "active" : "")" onclick=@(() => ActiveTab = 3)>@GameLocalization.Phrase( "ui.tab.help" )</button>
					</div>
					<div class="sidebar-spacer"></div>
					<div class="sidebar-bottom">
						<button class="bottom-btn">@GameLocalization.Phrase( "ui.sidebar.rules" )</button>
						<button class="bottom-btn">@GameLocalization.Phrase( "ui.sidebar.donate" )</button>
						<button class="bottom-btn" onclick=@OpenDiscord>Discord</button>
						<div class="language-switcher">
							<button class="language-btn @(IsLanguage( GameLocalization.EnglishCode ) ? "active" : "")" onmousedown=@(() => SetLanguage( GameLocalization.EnglishCode )) onclick=@(() => SetLanguage( GameLocalization.EnglishCode ))>EN</button>
							<button class="language-btn @(IsLanguage( GameLocalization.RussianCode ) ? "active" : "")" onmousedown=@(() => SetLanguage( GameLocalization.RussianCode )) onclick=@(() => SetLanguage( GameLocalization.RussianCode ))>RU</button>
						</div>
					</div>
				</div>

				<div class="content-area">

					@if ( ActiveTab == 0 )
					{
						<div class="page">
							<div class="page-title">@GameLocalization.Phrase( "ui.tab.jobs" )</div>
							<div class="jobs-grid">
								@foreach ( var job in VisibleJobs )
								{
									var count = GetJobPlayersCount( job.Id );
									var isLimited = job.MaxCount > 0;
									var atLimit = isLimited && count >= job.MaxCount;
									var isCurrent = string.Equals( Player.Local?.Job?.JobId, job.Id, StringComparison.Ordinal );
									var isArrested = Player.Local?.IsArrested == true;
									var jobHeader = GameLocalization.JobHeader( job );
									var shortDescription = GetShortDescription( GameLocalization.JobDescription( job ) );

									<div class="job-card @(isCurrent ? "current" : "")">
										<div class="job-head">
											<div class="job-title">@jobHeader</div>
											<div class="job-limit">@(isLimited ? $"{count}/{job.MaxCount}" : GameLocalization.Phrase( "ui.jobs.no_limit", "No limit" ))</div>
										</div>
										<div class="job-description">@shortDescription</div>
										<button
											class="job-take-btn"
											disabled=@(isCurrent || atLimit || isArrested)
											onclick=@(() => RequestJoinJob( job.Id ))>
											@(isCurrent ? GameLocalization.Phrase( "ui.jobs.current", "Current" ) : (isArrested ? GameLocalization.Phrase( "ui.jobs.arrested", "Arrested" ) : GameLocalization.Phrase( "ui.jobs.take", "Take" )))
										</button>
									</div>
								}
							</div>
						</div>
					}
					else if ( ActiveTab == 1 )
					{
						<div class="page">
							<div class="page-title">@GameLocalization.Phrase( "ui.tab.shop" )</div>
							<div class="shop-grid">
								@foreach ( var shop in VisibleShopItems )
								{
									var canAfford = (Player.Local?.Money ?? 0) >= shop.Price;
									var canFitItem = CanFitShopItem( shop );
									var hasPurchaseAction = HasShopPurchaseAction( shop );
									var disabled = !canAfford || !canFitItem || !hasPurchaseAction;
									var shopHeader = GameLocalization.ShopHeader( shop );
									var shopCategory = GameLocalization.Category( shop.Category );
									var shortDescription = GetShortDescription( GameLocalization.ShopDescription( shop ) );
									var status = GetShopStatus( shop, canAfford, canFitItem, hasPurchaseAction );

									<div class="shop-card @(disabled ? "locked" : "")">
										<div class="shop-card-main">
											<div class="shop-icon" style="@(GetShopIconStyle( shop ))"></div>
											<div class="shop-info">
												<div class="shop-head">
													<div class="shop-title">@shopHeader</div>
													<div class="shop-price">$@shop.Price</div>
												</div>
												<div class="shop-category">@shopCategory</div>
												<div class="shop-description">@shortDescription</div>
											</div>
										</div>
										<div class="shop-actions">
											<div class="shop-status @(disabled ? "bad" : "good")">@status</div>
											<button
												class="shop-buy-btn"
												disabled=@disabled
												onclick=@(() => RequestPurchase( shop ))>
												@GameLocalization.Phrase( "ui.shop.buy" )
											</button>
										</div>
									</div>
								}
							</div>
						</div>
					}
					else if ( ActiveTab == 2 )
					{
						<div class="page">
							<div class="page-title">@GameLocalization.Phrase( "ui.tab.players" )</div>
							<div class="players-count">@GameLocalization.Format( "ui.players.online", "Online: {0}", CachedPlayers.Count )</div>
							<div class="player-list">
								@foreach ( var conn in CachedPlayers )
								{
									var jobName = GetPlayerJobName( conn );

									<div class="player-row">
										<div class="player-avatar" style="background-image: url( avatar:@conn.SteamId.Value )" onclick=@(() => Game.Overlay.ShowPlayer( conn.SteamId.Value, "" ))></div>
										<div class="player-info">
											<div class="player-name">@conn.DisplayName</div>
											<div class="player-job">@jobName</div>
										</div>
										<div class="player-ping">@conn.Ping ms</div>
									</div>
								}
							</div>
						</div>
					}
					else if ( ActiveTab == 3 )
					{
						<div class="page">
							<div class="page-title">@GameLocalization.Phrase( "ui.tab.help" )</div>
							<div class="help-list">
								<div class="help-row"><div class="help-key">Tab</div><div class="help-desc">@GameLocalization.Phrase( "ui.help.menu" )</div></div>
								<div class="help-row"><div class="help-key">WASD</div><div class="help-desc">@GameLocalization.Phrase( "ui.help.movement" )</div></div>
								<div class="help-row"><div class="help-key">Space</div><div class="help-desc">@GameLocalization.Phrase( "ui.help.jump" )</div></div>
								<div class="help-row"><div class="help-key">F</div><div class="help-desc">@GameLocalization.Phrase( "ui.help.interact" )</div></div>
								<div class="help-row"><div class="help-key">1-9</div><div class="help-desc">@GameLocalization.Phrase( "ui.help.hotbar" )</div></div>
								<div class="help-row"><div class="help-key">Enter</div><div class="help-desc">@GameLocalization.Phrase( "ui.help.chat" )</div></div>
							</div>
						</div>
					}

				</div>
			</div>
		</div>
	}
</root>

@code
{
	const string ModalId = nameof( TabMenu );
	bool IsOpen { get; set; } = false;
	TimeUntil DiscordCloseAt { get; set; } = 0f;
	bool IsDiscordOpening { get; set; } = false;

	private void OpenDiscord()
	{
		IsDiscordOpening = true;
		DiscordCloseAt = 5f;
		StateHasChanged();
	}
	int ActiveTab { get; set; } = 0;
	List<Connection> CachedPlayers { get; set; } = new();
	List<JobDefinition> AvailableJobs { get; set; } = new();
	List<ShopDefinition> AvailableShopItems { get; set; } = new();
	IEnumerable<JobDefinition> VisibleJobs => AvailableJobs.Where( CanLocalSeeJob );
	IEnumerable<ShopDefinition> VisibleShopItems => AvailableShopItems.Where( IsShopAllowed );
	int PlayersVersion { get; set; } = 0;
	int JobsVersion { get; set; } = 0;
	int ShopVersion { get; set; } = 0;

	private bool IsLanguage( string code ) => string.Equals( GameLocalization.CurrentCode, code, StringComparison.OrdinalIgnoreCase );

	private void SetLanguage( string code )
	{
		GameLocalization.SetLanguage( code );
		RpcSetLanguage( code );
		StateHasChanged();
	}

	[Rpc.Host]
	private static void RpcSetLanguage( string code )
	{
		GameLocalization.SetLanguage( code );
	}

	private string GetLocalJobName()
	{
		return GameLocalization.JobHeader( Player.Local?.Job?.JobDefinition );
	}

	void SelectPlayersTab()
	{
		ActiveTab = 2;
		CachedPlayers = Connection.All.ToList();
		PlayersVersion++;
	}

	void SelectJobsTab()
	{
		ActiveTab = 0;
		LoadJobs();
	}

	private void LoadJobs()
	{
		AvailableJobs = ResourceLibrary
			.GetAll<JobDefinition>()
			.OrderBy( x => GameLocalization.Category( x.Category ) )
			.ThenBy( GameLocalization.JobHeader )
			.ToList();

		JobsVersion++;
	}

	private void LoadShop()
	{
		AvailableShopItems = ResourceLibrary
			.GetAll<ShopDefinition>()
			.OrderBy( x => GameLocalization.Category( x.Category ) )
			.ThenBy( GameLocalization.ShopHeader )
			.ToList();

		ShopVersion++;
	}

	private static string GetShortDescription( string description )
	{
		var text = (description ?? string.Empty).Trim();
		if ( text.Length <= 0 )
			return GameLocalization.Phrase( "common.no_description", "No description" );

		const int maxLen = 110;
		return text.Length <= maxLen ? text : $"{text[..maxLen]}...";
	}

	private int GetJobPlayersCount( string jobId )
	{
		var scene = Game.ActiveScene;
		if ( scene is null || string.IsNullOrWhiteSpace( jobId ) )
			return 0;

		var count = 0;
		foreach ( var player in scene.GetAllComponents<Player>() )
		{
			if ( string.Equals( player?.Job?.JobId, jobId, StringComparison.Ordinal ) )
				count++;
		}

		return count;
	}

	private int GetJobsPopulationHash()
	{
		var hash = 17;
		foreach ( var job in VisibleJobs )
		{
			hash = HashCode.Combine( hash, job.Id, GetJobPlayersCount( job.Id ) );
		}

		return hash;
	}

	private bool CanLocalSeeJob( JobDefinition job )
	{
		if ( job is null )
			return false;

		if ( job.FromJobs is null || job.FromJobs.Count <= 0 )
			return true;

		var localJobId = Player.Local?.Job?.JobId;
		if ( string.IsNullOrWhiteSpace( localJobId ) )
			return false;

		return job.FromJobs.Any( allowedJob => allowedJob is not null && string.Equals( allowedJob.Id, localJobId, StringComparison.Ordinal ) );
	}

	private string GetPlayerJobName( Connection connection )
	{
		if ( connection is null )
			return GameLocalization.Phrase( "common.no_job", "No Job" );

		return GameLocalization.JobHeader( FindPlayerBySteamId( connection.SteamId.Value )?.Job?.JobDefinition );
	}

	private int GetPlayersJobHash()
	{
		var hash = 17;
		foreach ( var connection in CachedPlayers )
		{
			hash = HashCode.Combine( hash, connection.SteamId.Value, GetPlayerJobName( connection ) );
		}

		return hash;
	}

	private void RequestJoinJob( string jobId )
	{
		var normalized = (jobId ?? string.Empty).Trim();
		if ( normalized.Length <= 0 )
			return;

		var job = AvailableJobs.FirstOrDefault( x => x is not null && string.Equals( x.Id, normalized, StringComparison.Ordinal ) );
		if ( job is not null && !CanLocalSeeJob( job ) )
		{
			Notification.Error( GameLocalization.Phrase( "notify.jobs.not_allowed_from_job", "This job is not available to you." ), 3.5f );
			return;
		}

		RpcRequestJoinJob( normalized );
	}

	private bool IsShopAllowed( ShopDefinition shop )
	{
		if ( shop is null )
			return false;

		if ( shop.IsAllowEveryone )
			return true;

		var localJob = Player.Local?.Job?.JobDefinition;
		if ( localJob is null || shop.JobsAllow is null || shop.JobsAllow.Count == 0 )
			return false;

		return shop.JobsAllow.Any( x => x is not null && string.Equals( x.Id, localJob.Id, StringComparison.Ordinal ) );
	}

	private bool CanFitShopItem( ShopDefinition shop )
	{
		var itemId = shop?.ItemDefinition?.Id;
		if ( string.IsNullOrWhiteSpace( itemId ) )
			return true;

		return Player.Local?.Inventory?.CanAddItem( itemId, 1 ) ?? false;
	}

	private bool HasShopPurchaseAction( ShopDefinition shop )
	{
		return shop is not null && (shop.ItemDefinition is not null || shop.HasPostPurchased);
	}

	private string GetShopStatus( ShopDefinition shop, bool canAfford, bool canFitItem, bool hasPurchaseAction )
	{
		if ( !canAfford )
			return GameLocalization.Phrase( "ui.shop.not_enough_money", "Not enough money" );

		if ( !canFitItem )
			return GameLocalization.Phrase( "ui.shop.inventory_full", "Inventory full" );

		if ( !hasPurchaseAction )
			return GameLocalization.Phrase( "ui.shop.unavailable", "Unavailable" );

		if ( shop?.HasPostPurchased == true && shop.ItemDefinition is null )
			return GameLocalization.Phrase( "ui.shop.spawns_in_world", "Spawns in world" );

		return GameLocalization.Phrase( "ui.shop.available", "Available" );
	}

	private string GetShopIconStyle( ShopDefinition shop )
	{
		var icon = string.IsNullOrWhiteSpace( shop?.IconPath ) ? "icons/items/default.vtex" : shop.IconPath;
		return $"background-image: url({icon})";
	}

	private int GetInventoryHash()
	{
		var inventory = Player.Local?.Inventory;
		if ( inventory is null )
			return 0;

		var hash = 17;
		foreach ( var slot in inventory.Slots )
		{
			hash = HashCode.Combine( hash, slot.Item?.Id, slot.Item?.Count ?? 0 );
		}

		return hash;
	}

	private void RequestPurchase( ShopDefinition shop )
	{
		var normalized = (shop?.Id ?? string.Empty).Trim();
		if ( normalized.Length <= 0 )
			return;

		if ( !IsShopAllowed( shop ) )
		{
			Notification.Error( GameLocalization.Phrase( "notify.shop.job_cannot_buy", "Your job cannot buy this." ), 3.5f );
			return;
		}

		if ( (Player.Local?.Money ?? 0) < shop.Price )
		{
			Notification.Error( GameLocalization.Format( "notify.shop.need_money", "Need ${0}.", shop.Price ), 3.5f );
			return;
		}

		if ( !CanFitShopItem( shop ) )
		{
			Notification.Error( GameLocalization.Phrase( "notify.inventory.full", "Inventory is full." ), 3.5f );
			return;
		}

		if ( !HasShopPurchaseAction( shop ) )
		{
			Notification.Error( GameLocalization.Phrase( "notify.shop.unavailable", "Shop item is unavailable." ), 3.5f );
			return;
		}

		ShopManager.RpcRequestPurchase( normalized );
	}

	[Rpc.Host]
	private static void RpcRequestJoinJob( string jobId )
	{
		var caller = Rpc.Caller;
		if ( caller is null )
			return;

		var normalized = (jobId ?? string.Empty).Trim();
		if ( string.IsNullOrEmpty( normalized ) )
		{
			NotifyCaller( caller, GameLocalization.Phrase( "notify.jobs.empty_id", "Job id is empty." ), false );
			return;
		}

		var jobDefinition = JobDatabase.Get( normalized );
		if ( jobDefinition is null )
		{
			NotifyCaller( caller, GameLocalization.Phrase( "notify.jobs.not_found", "Job not found." ), false );
			return;
		}

		var callerPlayer = FindPlayerBySteamId( caller.SteamId.Value );
		if ( !callerPlayer.IsValid() || !callerPlayer.Job.IsValid() )
		{
			NotifyCaller( caller, GameLocalization.Phrase( "notify.player.not_ready", "Your player is not ready." ), false );
			return;
		}

		if ( callerPlayer.IsArrested )
		{
			NotifyCaller( caller, GameLocalization.Phrase( "notify.player.arrested", "You are arrested." ), false );
			return;
		}

		if ( string.Equals( callerPlayer.Job.JobId, normalized, StringComparison.Ordinal ) )
		{
			NotifyCaller( caller, GameLocalization.Phrase( "notify.jobs.already_have", "You already have this job." ), true );
			return;
		}

		if ( !VoteManager.CanTakeJob( callerPlayer, jobDefinition, out var reason ) )
		{
			NotifyCaller( caller, reason, false );
			return;
		}

		if ( jobDefinition.Vote && Connection.All.Count > 2 )
		{
			if ( VoteManager.TryStartJobVote( callerPlayer, jobDefinition ) )
				NotifyCaller( caller, GameLocalization.Format( "notify.vote.started_for", "Vote started for {0}.", GameLocalization.JobHeader( jobDefinition ) ), true );
			else
				NotifyCaller( caller, GameLocalization.Phrase( "notify.vote.could_not_start", "Could not start vote." ), false );

			return;
		}

		callerPlayer.Job.SetJob( normalized );
		NotifyCaller( caller, GameLocalization.Format( "notify.jobs.joined", "You joined: {0}.", GameLocalization.JobHeader( jobDefinition ) ), true );
	}

	private static Player FindPlayerBySteamId( long steamId )
	{
		var scene = Game.ActiveScene;
		if ( scene is null )
			return null;

		foreach ( var player in scene.GetAllComponents<Player>() )
		{
			if ( player.GameObject.Network.Owner?.SteamId.Value == steamId )
				return player;
		}

		return null;
	}

	private static void NotifyCaller( Connection caller, string text, bool success )
	{
		using ( Rpc.FilterInclude( x => x.SteamId.Value == caller.SteamId.Value ) )
		{
			RpcReceiveJoinJobResult( text, success );
		}
	}

	[Rpc.Broadcast]
	private static void RpcReceiveJoinJobResult( string text, bool success )
	{
		if ( success )
			Notification.Info( text, 3.5f );
		else
			Notification.Error( text, 3.5f );
	}

	protected override void OnStart()
	{
		UiModalManager.ActiveModalChanged += OnActiveModalChanged;
		LoadJobs();
		LoadShop();
	}

	protected override void OnDisabled()
	{
		ReleaseCrosshairBlock();
	}

	protected override void OnDestroy()
	{
		UiModalManager.ActiveModalChanged -= OnActiveModalChanged;
		ReleaseCrosshairBlock();
	}

	private void ReleaseCrosshairBlock()
	{
		IsOpen = false;
		Crosshair.SetBlocked( ModalId, false );
		UiModalManager.Close( ModalId );
	}

	private void SetOpen( bool open )
	{
		if ( open )
		{
			LoadJobs();
			UiModalManager.Open( ModalId );
		}
		else
		{
			UiModalManager.Close( ModalId );
		}

		IsOpen = open;

		Crosshair.SetBlocked( ModalId, open );
		UiModalManager.UpdateMouseVisibility();
		StateHasChanged();
	}

	private void OnActiveModalChanged( string activeModal )
	{
		if ( activeModal == ModalId || !IsOpen )
			return;

		IsOpen = false;
		Crosshair.SetBlocked( ModalId, false );
		StateHasChanged();
	}

		protected override void OnUpdate()
	{
		if ( Input.Pressed( "Score" ) )
			SetOpen( !IsOpen );

		if ( IsDiscordOpening && DiscordCloseAt <= 0f )
		{
			IsDiscordOpening = false;
			StateHasChanged();
		}

		UiModalManager.UpdateMouseVisibility();
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( IsOpen );
		hash.Add( UiModalManager.Version );
		hash.Add( ActiveTab );
		hash.Add( GameLocalization.CurrentCode );
		hash.Add( Player.Local?.Money ?? 0 );
		hash.Add( Player.Local?.Job?.JobId );
		hash.Add( Player.Local?.Job?.JobDefinition?.Header );
		hash.Add( GetInventoryHash() );
		hash.Add( Connection.Local?.DisplayName );
		hash.Add( Connection.All.Count );
		hash.Add( GetJobsPopulationHash() );
		hash.Add( GetPlayersJobHash() );
		hash.Add( AvailableJobs.Count );
		hash.Add( VisibleJobs.Count() );
		hash.Add( AvailableShopItems.Count );
		hash.Add( VisibleShopItems.Count() );
		hash.Add( JobsVersion );
		hash.Add( ShopVersion );
		hash.Add( PlayersVersion );
		return hash.ToHashCode();
	}
}
