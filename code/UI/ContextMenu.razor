@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Linq;
@using Minimal.Clan;
@inherits PanelComponent
@namespace Sandbox

<root>
	@if ( IsOpen && UiModalManager.IsActive( ModalId ) )
	{
		<div class="context-overlay">
			<div class="context-wheel">
				<div class="wheel-ring"></div>
				@foreach ( var action in Actions )
				{
					@if ( IsActionVisible( action ) )
					{
						<button class="context-action @action.PositionClass @(ActiveAction == action.Id ? "active" : "")" onmouseover=@(() => ActiveAction = action.Id) onclick=@(() => RunAction( action.Id ))>
							<div class="action-icon @action.IconClass"></div>
							<div class="action-title">@GetActionTitle( action.Id )</div>
							<div class="action-subtitle">@GetActionSubtitle( action.Id )</div>
						</button>
					}
				}

				<div class="center-info">
					<div class="center-label">@GameLocalization.Phrase( "ui.context.action" )</div>
				</div>
			</div>

			<div class="context-hint">@GameLocalization.Phrase( "ui.context.hint" )</div>

			@if ( ShowClanInviteMenu )
			{
				<div class="clan-context-panel">
					<div class="clan-context-title">Clan Invite</div>
					@foreach ( var conn in GetClanInviteCandidates() )
					{
						<button class="clan-context-player" onclick=@(() => InviteToClan( conn.SteamId.Value ))>
							<div class="clan-context-avatar" style="background-image: url( avatar:@conn.SteamId.Value )"></div>
							<div class="clan-context-name">@conn.DisplayName</div>
						</button>
					}
					@if ( !GetClanInviteCandidates().Any() )
					{
						<div class="clan-context-empty">No available players</div>
					}
				</div>
			}
		</div>

		@if ( VotePanel.HasOpenVote )
		{
			<div class="context-vote-panel">
				<div class="context-vote-header">@VotePanel.CurrentHeader</div>

				@if ( VotePanel.CanAnswer )
				{
					<div class="context-vote-actions">
						<button class="vote-yes" onclick=@(() => VotePanel.SubmitCurrent( true ))>@GameLocalization.Phrase( "ui.common.yes" )</button>
						<button class="vote-no" onclick=@(() => VotePanel.SubmitCurrent( false ))>@GameLocalization.Phrase( "ui.common.no" )</button>
					</div>
				}
			</div>
		}
	}
</root>

@code
{
	const string ModalId = nameof( ContextMenu );
	bool IsOpen { get; set; }
	string ActiveAction { get; set; } = "drop_money";
	bool ShowClanInviteMenu { get; set; }

	static readonly ContextAction[] Actions =
	{
		new( "drop_money", "pos-left", "money" ),
		new( "transfer_money", "pos-right", "money" ),
		new( "dice", "pos-top", "dice" ),
		new( "demote", "pos-bottom", "job" ),
		new( "clan_invite", "pos-clan", "clan" )
	};

	static string GetActionTitle( string id ) => id switch
	{
		"drop_money" => GameLocalization.Phrase( "ui.context.drop_money", "Drop Money" ),
		"transfer_money" => GameLocalization.Phrase( "ui.context.transfer_money", "Transfer Money" ),
		"dice" => GameLocalization.Phrase( "ui.context.dice", "Dice" ),
		"demote" => GameLocalization.Phrase( "ui.context.demote", "Demote" ),
		"clan_invite" => "Clan",
		_ => string.Empty
	};

	static string GetActionSubtitle( string id ) => id switch
	{
		"drop_money" => GameLocalization.Phrase( "ui.context.cash", "Cash" ),
		"transfer_money" => GameLocalization.Phrase( "ui.context.player_ahead", "Player ahead" ),
		"dice" => GameLocalization.Phrase( "ui.context.casino", "Casino" ),
		"demote" => GameLocalization.Phrase( "ui.context.vote", "Vote" ),
		"clan_invite" => "Invite",
		_ => string.Empty
	};

	bool IsActionVisible( ContextAction action )
	{
		if ( action.Id == "dice" )
			return Player.Local?.IsCasino ?? false;

		if ( action.Id == "clan_invite" )
			return ClanManager.CanInviteRank( Player.Local?.ClanRank ?? ClanRank.Soldier );

		return true;
	}

	void RunAction( string id )
	{
		ActiveAction = id;

		if ( id == "clan_invite" )
		{
			ShowClanInviteMenu = !ShowClanInviteMenu;
			StateHasChanged();
			return;
		}

		Close();

		if ( id == "drop_money" )
		{
			DropMoneyConfirmPanel.Open();
			return;
		}

		if ( id == "transfer_money" )
			TransferMoneyConfirmPanel.TryOpenForLookTarget();

		if ( id == "dice" )
			DiceConfirmPanel.TryOpenForLookTarget();

		if ( id == "demote" )
			DemotePanel.Open();
	}

	void Close()
	{
		ShowClanInviteMenu = false;
		SetOpen( false );
	}

		private void SetOpen( bool open )
	{
		if ( open )
			UiModalManager.Open( ModalId );
		else
			UiModalManager.Close( ModalId );

		IsOpen = open;

		Crosshair.SetBlocked( ModalId, open );
		if ( !open )
			ShowClanInviteMenu = false;

		UiModalManager.UpdateMouseVisibility();
		StateHasChanged();
	}

	private void OnActiveModalChanged( string activeModal )
	{
		if ( activeModal == ModalId || !IsOpen )
			return;

			IsOpen = false;
			ShowClanInviteMenu = false;
			Crosshair.SetBlocked( ModalId, false );
			StateHasChanged();
	}

	private Connection[] GetClanInviteCandidates()
	{
		var localSteamId = Connection.Local?.SteamId.Value ?? 0L;
		return Connection.All
			.Where( x => x is not null && x.SteamId.Value != localSteamId )
			.Where( x =>
			{
				var player = Player.FindPlayerBySteamId( x.SteamId.Value );
				return player.IsValid() && player.ClanId < 0;
			} )
			.ToArray();
	}

	private void InviteToClan( long steamId )
	{
		ClanManager.RpcRequestInvite( steamId );
		Close();
	}

	protected override void OnUpdate()
	{
		if ( Input.Pressed( "Context" ) )
		{
			SetOpen( !IsOpen );
		}

		if ( IsOpen )
		{
			UiModalManager.UpdateMouseVisibility();
		}
	}

	protected override void OnStart()
	{
		UiModalManager.ActiveModalChanged += OnActiveModalChanged;
	}

	protected override void OnDisabled()
	{
		ReleaseCrosshairBlock();
	}

	protected override void OnDestroy()
	{
		UiModalManager.ActiveModalChanged -= OnActiveModalChanged;
		ReleaseCrosshairBlock();
	}

	private void ReleaseCrosshairBlock()
	{
		IsOpen = false;
		Crosshair.SetBlocked( ModalId, false );
		UiModalManager.Close( ModalId );
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( IsOpen );
		hash.Add( UiModalManager.Version );
		hash.Add( ActiveAction );
		hash.Add( Player.Local?.Money ?? 0 );
		hash.Add( Player.Local?.Job?.JobDefinition?.Header );
		hash.Add( GameLocalization.CurrentCode );
		hash.Add( GameLocalization.Version );
		hash.Add( Player.Local?.Health ?? 0f );
		hash.Add( Player.Local?.IsCasino ?? false );
		hash.Add( Player.Local?.ClanId ?? -1 );
		hash.Add( Player.Local?.ClanRank );
		hash.Add( ShowClanInviteMenu );
		hash.Add( Connection.All.Count );
		hash.Add( VotePanel.HasOpenVote );
		hash.Add( VotePanel.CanAnswer );
		hash.Add( VotePanel.CurrentHeader );
		return hash.ToHashCode();
	}

	sealed class ContextAction
	{
		public string Id { get; }
		public string PositionClass { get; }
		public string IconClass { get; }

		public ContextAction( string id, string positionClass, string iconClass )
		{
			Id = id;
			PositionClass = positionClass;
			IconClass = iconClass;
		}
	}
}
