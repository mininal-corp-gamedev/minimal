@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Collections.Generic;
@using System.Linq;
@inherits PanelComponent
@namespace Sandbox

<root>
	@if ( IsOpen && UiModalManager.IsActive( ModalId ) )
	{
		<div class="demote-overlay">
			<div class="demote-panel">
				<button class="close-btn" onclick=@(() => Close())>X</button>

				<div class="panel-title">@GameLocalization.Phrase( "ui.demote.title" )</div>
				<div class="panel-subtitle">@GameLocalization.Phrase( "ui.demote.subtitle" )</div>

				<div class="demote-table">
					@if ( EligiblePlayers.Count == 0 )
					{
						<div class="empty-row">@GameLocalization.Phrase( "ui.demote.empty" )</div>
					}
					else
					{
						@foreach ( var player in EligiblePlayers )
						{
							var owner = player.GameObject.Network.Owner;
							var steamId = owner?.SteamId.Value ?? 0;
							var name = owner?.DisplayName ?? GameLocalization.Phrase( "common.player", "Player" );
							var jobName = GameLocalization.JobHeader( player.Job?.JobDefinition );

							<div class="player-row">
								<div class="player-avatar" style="background-image: url( avatar:@steamId )"></div>
								<div class="player-info">
									<div class="player-name">@name</div>
									<div class="player-job">@jobName</div>
								</div>
								<button class="demote-btn" onclick=@(() => RequestDemote( steamId ))>@GameLocalization.Phrase( "ui.demote.action" )</button>
							</div>
						}
					}
				</div>
			</div>
		</div>
	}
</root>

@code
{
	private const string ModalId = nameof( DemotePanel );
	public static DemotePanel Instance { get; private set; }

	private bool IsOpen { get; set; }
	private List<Player> EligiblePlayers { get; set; } = new();

	public static void Open()
	{
		EnsureInstance();
		Instance?.OpenInternal();
	}

	private static void EnsureInstance()
	{
		if ( Instance.IsValid() )
			return;

		var scene = Game.ActiveScene;
		if ( scene is null )
			return;

		var obj = scene.CreateObject();
		obj.Name = "DemotePanel";
		obj.Components.Create<DemotePanel>();
	}

	private void OpenInternal()
	{
		RefreshPlayers();
		SetOpen( true );
	}

	private void Close()
	{
		SetOpen( false );
	}

	private void SetOpen( bool open )
	{
		if ( open )
			UiModalManager.Open( ModalId );
		else
			UiModalManager.Close( ModalId );

		IsOpen = open;
		Crosshair.SetBlocked( ModalId, open );

		UiModalManager.UpdateMouseVisibility();
		StateHasChanged();
	}

	private void RefreshPlayers()
	{
		var local = Player.Local;
		var scene = Game.ActiveScene;
		EligiblePlayers.Clear();

		if ( scene is null || !local.IsValid() )
			return;

		foreach ( var player in scene.GetAllComponents<Player>() )
		{
			if ( !player.IsValid() || player == local )
				continue;

			if ( !VoteManager.CanDemoteTarget( player, out _ ) )
				continue;

			EligiblePlayers.Add( player );
		}

		EligiblePlayers = EligiblePlayers
			.OrderBy( x => x.GameObject.Network.Owner?.DisplayName ?? "" )
			.ToList();
	}

	private void RequestDemote( long steamId )
	{
		if ( steamId <= 0 )
			return;

		Close();
		RpcRequestDemote( steamId );
	}

	[Rpc.Host]
	private static void RpcRequestDemote( long targetSteamId )
	{
#if SERVER
		if ( !Networking.IsHost )
			return;

		var caller = Rpc.Caller;
		if ( caller is null )
			return;

		if ( caller.SteamId.Value == targetSteamId )
		{
			NotifyCaller( caller, GameLocalization.Phrase( "notify.demote.self", "You cannot demote yourself." ), false );
			return;
		}

		var target = Player.FindPlayerBySteamId( targetSteamId );
		if ( !target.IsValid() )
		{
			NotifyCaller( caller, GameLocalization.Phrase( "notify.player.not_found", "Player not found." ), false );
			return;
		}

		if ( !VoteManager.CanDemoteTarget( target, out var reason ) )
		{
			NotifyCaller( caller, reason, false );
			return;
		}

		if ( VoteManager.TryStartDemoteVote( target ) )
			NotifyCaller( caller, GameLocalization.Phrase( "notify.demote.started", "Demote vote started." ), true );
		else
			NotifyCaller( caller, GameLocalization.Phrase( "notify.vote.could_not_start", "Could not start vote." ), false );
#endif
	}

#if SERVER
	private static void NotifyCaller( Connection caller, string text, bool success )
	{
		using ( Rpc.FilterInclude( x => x.SteamId.Value == caller.SteamId.Value ) )
		{
			RpcReceiveDemoteResult( text, success );
		}
	}
#endif

	[Rpc.Broadcast]
	private static void RpcReceiveDemoteResult( string text, bool success )
	{
		if ( success )
			Notification.Info( text, 3.5f );
		else
			Notification.Error( text, 3.5f );
	}

	protected override void OnStart()
	{
		if ( Instance.IsValid() && Instance != this )
			return;

		Instance = this;
		UiModalManager.ActiveModalChanged += OnActiveModalChanged;
	}

	protected override void OnDisabled()
	{
		ReleaseCrosshairBlock();
	}

	protected override void OnDestroy()
	{
		UiModalManager.ActiveModalChanged -= OnActiveModalChanged;
		ReleaseCrosshairBlock();

		if ( Instance == this )
			Instance = null;
	}

	private void ReleaseCrosshairBlock()
	{
		IsOpen = false;
		EligiblePlayers.Clear();
		Crosshair.SetBlocked( ModalId, false );
		UiModalManager.Close( ModalId );
	}

	private void OnActiveModalChanged( string activeModal )
	{
		if ( activeModal == ModalId || !IsOpen )
			return;

		IsOpen = false;
		EligiblePlayers.Clear();
		Crosshair.SetBlocked( ModalId, false );
		StateHasChanged();
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( IsOpen );
		hash.Add( UiModalManager.Version );
		hash.Add( EligiblePlayers.Count );
		hash.Add( GameLocalization.CurrentCode );

		foreach ( var player in EligiblePlayers )
		{
			hash.Add( player.GameObject.Network.Owner?.SteamId.Value ?? 0 );
			hash.Add( player.GameObject.Network.Owner?.DisplayName );
			hash.Add( player.Job?.JobId );
			hash.Add( player.Job?.JobDefinition?.Header );
		}

		return hash.ToHashCode();
	}
}
