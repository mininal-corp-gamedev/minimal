@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent
@namespace Sandbox

<root>
    <div class="badge">
        <div class="title">@GameLocalization.Phrase( "ui.beta.title" )</div>
        <div class="sub">@GameLocalization.Phrase( "ui.beta.subtitle" )</div>
    </div>
</root>

@code
{
    protected override int BuildHash() => GameLocalization.CurrentCode.GetHashCode();
}
