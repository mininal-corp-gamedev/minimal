@using Sandbox;
@using Sandbox.UI;
@using System.Threading.Tasks;
@inherits PanelComponent
@namespace Sandbox

<root>
	<div class="wrap-bottom">
		<div class="bottom">
			<div>💵 @_player.Money</div>
			<div>❤️ @_player.Health.ToString("F0") / @_player.MaxHealth</div>
		</div>
	</div>

	<div class="wrap-main">
		<div class="main">
			@foreach (var slot in _player.Inventory.Slots)
			{
				<div>@slot.ToString()</div>
			}
		</div>
	</div>
</root>

@code
{
	[Property] private Player _player;
	private bool _isShow = false;
	private TimeUntil _delaySum = 0f;

	public void Show() => _isShow = true;

	public void Hide() => _isShow = false;

	public void Show(float delayForHide)
	{
		_delaySum = delayForHide;

		Show();
	}

	private void ShowDelayUpdate()
	{
		//Log.Info(_delaySum.ToString());
		if (!_isShow) return;

		if (_delaySum)
			Hide();
	}

	protected override int BuildHash() => System.HashCode.Combine(_isShow, _player.Money, _player.Health, _player.MaxHealth);

	protected override void OnStart()
	{
		if (_player is null)
			_player = GetComponent<Player>();
	}

	protected override void OnUpdate()
	{
		ShowDelayUpdate();
	}
}
