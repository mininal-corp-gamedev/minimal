@using Sandbox;
@using Sandbox.UI;
@using Ambi.Storage;
@inherits PanelComponent
@namespace Sandbox

<root>
	@if ( !IsDead )
	{
		<div class="hotbar">
			@for ( int i = 0; i < HotbarCount; i++ )
			{
				Slot slot = GetSlot( i );
				<div class="slot @SlotClass( i ) @(slot is not null && !slot.IsEmpty ? "has-item" : "")">
					<div class="slot-key">@(i + 1)</div>
					@if ( slot is not null && !slot.IsEmpty )
					{
						<div class="slot-icon" style="background-image: url(@slot.Item.Definition.IconPath);"></div>
						@if ( slot.Item.Count > 1 )
						{
							<div class="slot-count">@slot.Item.Count</div>
						}
					}
				</div>
			}
		</div>
	}
</root>

@code
{
	const int HotbarCount = 9;
	bool IsDead => Player.Local?.IsDead == true;

	int ActiveSlot
	{
		get
		{
			var player = Player.Local;
			if ( player == null ) return -1;
			var index = player.SelectedHotbarSlotIndex;
			return index >= 0 && index < HotbarCount ? index : -1;
		}
	}

	Inventory Inv => Player.Local?.Inventory;

	Slot GetSlot( int index )
	{
		if ( Inv is null ) return null;
		if ( index < 0 || index >= Inv.Slots.Count ) return null;
		return Inv.Slots[index];
	}

	string SlotClass( int index ) => ActiveSlot == index ? "active" : "";

	protected override void OnUpdate()
	{
		if ( IsDead )
			return;

		if ( UiModalManager.HasActiveModal )
			return;

		// Physgun потребляет колёсико ТОЛЬКО когда зажата ЛКМ (режим Physgun-захвата) —
		// в этот момент колёсико регулирует дистанцию удержания. В любое другое время
		// (даже если physgun просто в руках) хотбар должен нормально прокручиваться.
		if ( Player.Local?.CurrentWeapon is Minimal.Weapons.WeaponPhysgun && Input.Down( "Attack1" ) )
			return;

		var wheel = Input.MouseWheel.y;
		if ( wheel > 0f )
			UseHotbarSlotOffset( -1 );
		else if ( wheel < 0f )
			UseHotbarSlotOffset( 1 );
	}

	void UseHotbarSlotOffset( int offset )
	{
		var player = Player.Local;
		if ( player is null )
			return;

		var currentIndex = player.SelectedHotbarSlotIndex;
		if ( currentIndex < 0 || currentIndex >= HotbarCount )
			currentIndex = offset > 0 ? -1 : 0;

		var nextIndex = (currentIndex + offset + HotbarCount) % HotbarCount;
		player.UseInventorySlot( nextIndex );
	}

	protected override int BuildHash()
	{
		var hash = System.HashCode.Combine( IsDead, ActiveSlot );
		if ( Inv is not null )
		{
			for ( int i = 0; i < HotbarCount && i < Inv.Slots.Count; i++ )
			{
				var item = Inv.Slots[i].Item;
				hash = System.HashCode.Combine( hash, item?.Id, item?.Count ?? 0 );
			}
		}

		return hash;
	}
}
