@using Sandbox;
@using Sandbox.UI;
@using Ambi.Storage;
@using System;
@using System.Linq;
@inherits PanelComponent
@namespace Sandbox

<root>
	@if ( IsOpen && UiModalManager.IsActive( ModalId ) )
	{
		<div class="inv-overlay" onmouseup=@((PanelEvent e) => OnOverlayMouseUp( e ))>
			<div class="inv-bg-close" onclick=@Close></div>
			<div class="inv-panel" onclick=@OnPanelClick>
				<div class="inv-header">
					<div class="inv-heading">
						<div class="inv-eyebrow">MINIMAL ROLEPLAY</div>
						<div class="inv-title">@GameLocalization.Phrase( "ui.inventory.title" )</div>
						<div class="inv-subtitle">@GameLocalization.Phrase( "ui.inventory.subtitle", "Personal items and quick access" )</div>
					</div>
					<div class="inv-summary">
						<div class="summary-value">@OccupiedSlotCount<span>/@SlotCount</span></div>
						<div class="summary-label">@GameLocalization.Phrase( "ui.inventory.capacity", "Occupied slots" )</div>
						<div class="summary-track"><div class="summary-fill" style="width: @(CapacityPercent)%;"></div></div>
					</div>
					<button class="inv-close" onclick=@Close>X</button>
				</div>

				<div class="inv-body">
					<div class="inventory-column">
						<div class="section-header">
							<div><div class="inv-section-label">@GameLocalization.Phrase( "ui.inventory.hotbar" )</div><div class="section-note">1—9</div></div>
							<div class="section-hint">@GameLocalization.Phrase( "ui.inventory.quick_access", "Quick access" )</div>
						</div>
						<div class="inv-row hotbar-row">
							@for ( int i = 0; i < HotbarCount; i++ )
							{
								var idx = i;
								var slot = GetSlot( idx );
								<div class="inv-slot @SlotStateClass( idx, slot )"
									 onrightclick=@(() => OnSlotRightClick( idx ))
									 onmousedown=@((PanelEvent e) => OnSlotMouseDown( idx, e ))
									 onmouseup=@((PanelEvent e) => OnSlotMouseUp( e ))
									 onmouseover=@(() => HoverSlotIndex = idx)
									 onmouseout=@(() => { if ( HoverSlotIndex == idx ) HoverSlotIndex = -1; })>
									<div class="slot-key">@(i + 1)</div>
									@if ( slot is not null && !slot.IsEmpty )
									{
										<div class="slot-icon" style="background-image: url(@slot.Item.Definition.IconPath);"></div>
										<div class="slot-name">@GameLocalization.ItemHeader( slot.Item.Definition )</div>
										@if ( slot.Item.Count > 1 )
										{
											<div class="slot-count">@slot.Item.Count</div>
										}
									}
								</div>
							}
						</div>

						<div class="section-header backpack-header">
							<div class="inv-section-label">@GameLocalization.Phrase( "ui.inventory.backpack" )</div>
							<div class="section-hint">@(Math.Max( 0, OccupiedSlotCount - OccupiedHotbarCount ))/@(Math.Max( 0, SlotCount - HotbarCount ))</div>
						</div>
						@{
							int backpackCount = SlotCount - HotbarCount;
							if ( backpackCount < 0 ) backpackCount = 0;
							int rows = (int)Math.Ceiling( backpackCount / (float)SlotsPerRow );
							if ( rows < 1 ) rows = 1;
						}
						@for ( int r = 0; r < rows; r++ )
						{
							<div class="inv-row">
								@for ( int c = 0; c < SlotsPerRow; c++ )
								{
									var globalIndex = HotbarCount + r * SlotsPerRow + c;
									var slot = GetSlot( globalIndex );
									@if ( globalIndex < SlotCount )
									{
										<div class="inv-slot @SlotStateClass( globalIndex, slot )"
											 onrightclick=@(() => OnSlotRightClick( globalIndex ))
											 onmousedown=@((PanelEvent e) => OnSlotMouseDown( globalIndex, e ))
											 onmouseup=@((PanelEvent e) => OnSlotMouseUp( e ))
											 onmouseover=@(() => HoverSlotIndex = globalIndex)
											 onmouseout=@(() => { if ( HoverSlotIndex == globalIndex ) HoverSlotIndex = -1; })>
											@if ( slot is not null && !slot.IsEmpty )
											{
												<div class="slot-icon" style="background-image: url(@slot.Item.Definition.IconPath);"></div>
												<div class="slot-name">@GameLocalization.ItemHeader( slot.Item.Definition )</div>
												@if ( slot.Item.Count > 1 )
												{
													<div class="slot-count">@slot.Item.Count</div>
												}
											}
										</div>
									}
									else
									{
										<div class="inv-slot locked"><div class="lock-mark">×</div></div>
									}
								}
							</div>
						}
					</div>

					<div class="details-column">
						<div class="details-label">@GameLocalization.Phrase( "ui.inventory.selected_item", "Selected item" )</div>
						@if ( SelectedSlot is not null )
						{
							<div class="details-icon-wrap"><div class="details-icon" style="background-image: url(@SelectedSlot.Item.Definition.IconPath);"></div></div>
							<div class="details-category">@GameLocalization.Category( SelectedSlot.Item.Definition.Category )</div>
							<div class="details-name">@GameLocalization.ItemHeader( SelectedSlot.Item.Definition )</div>
							<div class="details-description">@ItemDescription( SelectedSlot )</div>
							<div class="details-meta">
								<div class="meta-label">@GameLocalization.Phrase( "ui.inventory.quantity", "Quantity" )</div>
								<div class="meta-value">@SelectedSlot.Item.Count</div>
							</div>
							<div class="details-actions">
								<button class="detail-btn primary" onclick=@OnUseSelected>@GameLocalization.Phrase( "ui.inventory.use" )</button>
								<button class="detail-btn" onclick=@OnDropSelected>@GameLocalization.Phrase( "ui.inventory.drop" )</button>
								<button class="detail-btn danger" onclick=@OnDropAllSelected>@GameLocalization.Phrase( "ui.inventory.drop_all" )</button>
							</div>
						}
						else
						{
							<div class="details-empty">
								<div class="details-empty-mark">+</div>
								<div class="details-empty-title">@GameLocalization.Phrase( "ui.inventory.select_item", "Select an item" )</div>
								<div class="details-empty-text">@GameLocalization.Phrase( "ui.inventory.select_item_hint", "Hover over or click an item to view its details" )</div>
							</div>
						}
					</div>
				</div>
			</div>

			@if ( CtxVisible && !IsDragging )
			{
				<div class="ctx-menu" style="left: @(CtxX)px; top: @(CtxY)px;">
					<button class="ctx-btn" onclick=@OnUse>@GameLocalization.Phrase( "ui.inventory.use" )</button>
					<button class="ctx-btn" onclick=@OnDrop>@GameLocalization.Phrase( "ui.inventory.drop" )</button>
					<button class="ctx-btn" onclick=@OnDropAll>@GameLocalization.Phrase( "ui.inventory.drop_all" )</button>
				</div>
			}
			@if ( IsDragging && !string.IsNullOrEmpty( DragIconPath ) )
			{
				<div class="inv-drag-ghost" style="left: @(DragX)px; top: @(DragY)px;">
					<div class="slot-icon" style="background-image: url(@DragIconPath);"></div>
					@if ( DragCount > 1 )
					{
						<div class="slot-count">@DragCount</div>
					}
				</div>
			}
		</div>
	}
</root>

@code
{
	const string ModalId = nameof( InventoryPanel );
	bool IsOpen { get; set; }
	bool CtxVisible { get; set; }
	float CtxX { get; set; }
	float CtxY { get; set; }
	int CtxSlotIndex { get; set; } = -1;

	int HoverSlotIndex { get; set; } = -1;
	int FocusedSlotIndex { get; set; } = -1;

	bool IsDragging { get; set; }
	int DragSourceIndex { get; set; } = -1;
	string DragIconPath { get; set; }
	int DragCount { get; set; }
	float DragX { get; set; }
	float DragY { get; set; }

	const float SlotSizePx = 64f;

	const int HotbarCount = 9;
	const int SlotsPerRow = 9;
	// Visual layout keeps the existing 9 + 18 slot model intact.

	Inventory Inv => Player.Local?.Inventory;
	int SlotCount => Inv?.Slots?.Count ?? 0;
	int OccupiedSlotCount => Inv?.Slots?.Count( slot => !slot.IsEmpty ) ?? 0;
	int OccupiedHotbarCount => Inv?.Slots?.Take( HotbarCount ).Count( slot => !slot.IsEmpty ) ?? 0;
	float CapacityPercent => SlotCount <= 0 ? 0f : Math.Clamp( OccupiedSlotCount / (float)SlotCount * 100f, 0f, 100f );
	int HoveredItemSlotIndex
	{
		get
		{
			var slot = GetSlot( HoverSlotIndex );
			return slot is not null && !slot.IsEmpty ? HoverSlotIndex : -1;
		}
	}
	int SelectedSlotIndex => HoveredItemSlotIndex >= 0 ? HoveredItemSlotIndex : FocusedSlotIndex;
	Slot SelectedSlot
	{
		get
		{
			var slot = GetSlot( SelectedSlotIndex );
			return slot is not null && !slot.IsEmpty ? slot : null;
		}
	}
	Slot GetSlot( int index )
	{
		if ( Inv is null ) return null;
		if ( index < 0 || index >= Inv.Slots.Count ) return null;
		return Inv.Slots[index];
	}

	void Open()
	{
		SetOpen( true );

		CtxVisible = false;

		UiModalManager.UpdateMouseVisibility();
	}

	void Close()
	{
		SetOpen( false );

		CtxVisible = false;
		ResetDragState();

		UiModalManager.UpdateMouseVisibility();
	}

	void OnPanelClick()
	{
		CloseContextMenu();
	}

	void OnSlotRightClick( int index )
	{
		var slot = GetSlot( index );
		if ( slot is null || slot.IsEmpty ) return;

		if ( IsDragging )
			ResetDragState();

		FocusedSlotIndex = index;
		CtxSlotIndex = index;
		CtxX = GetMousePanelX();
		CtxY = GetMousePanelY();
		CtxVisible = true;
	}

	void CloseContextMenu()
	{
		CtxVisible = false;
		CtxSlotIndex = -1;
	}

	void OnUse()
	{
		var slot = GetSlot( CtxSlotIndex );
		if ( slot is not null && !slot.IsEmpty )
		{
			Player.Local?.UseInventorySlot( CtxSlotIndex );
		}
		CloseContextMenu();
	}

	void OnDrop()
	{
		var slot = GetSlot( CtxSlotIndex );
		if ( slot is not null && !slot.IsEmpty )
		{
			Player.Local?.DropItem( slot, 1 );
		}
		CloseContextMenu();
	}

	void OnDropAll()
	{
		var slot = GetSlot( CtxSlotIndex );
		if ( slot is not null && !slot.IsEmpty )
		{
			Player.Local?.DropItem( slot, slot.Item.Count );
		}
		CloseContextMenu();
	}

	void OnUseSelected()
	{
		if ( SelectedSlot is not null )
			Player.Local?.UseInventorySlot( SelectedSlotIndex );
	}

	void OnDropSelected()
	{
		var slot = SelectedSlot;
		if ( slot is not null )
			Player.Local?.DropItem( slot, 1 );
	}

	void OnDropAllSelected()
	{
		var slot = SelectedSlot;
		if ( slot is not null )
			Player.Local?.DropItem( slot, slot.Item.Count );
	}

	private void SetOpen( bool open )
	{
		if ( open )
			UiModalManager.Open( ModalId );
		else
			UiModalManager.Close( ModalId );

		IsOpen = open;

		Crosshair.SetBlocked( ModalId, open );
		StateHasChanged();
	}

	private void OnActiveModalChanged( string activeModal )
	{
		if ( activeModal == ModalId || !IsOpen )
			return;

		IsOpen = false;
		CtxVisible = false;
		HoverSlotIndex = -1;
		ResetDragState();
		Crosshair.SetBlocked( ModalId, false );
		StateHasChanged();
	}

	protected override void OnUpdate()
	{
		if ( Input.Pressed( "Inventory" ) )
		{
			if ( IsOpen ) Close();
			else Open();
		}

		if ( IsOpen )
		{
			UiModalManager.UpdateMouseVisibility();

			if ( IsDragging )
				UpdateDragGhostPosition();
		}
		else if ( IsDragging )
		{
			CancelDrag();
		}
	}

	static bool IsLeftMouse( PanelEvent e )
	{
		if ( e is MousePanelEvent mpe )
			return mpe.MouseButton == MouseButtons.Left;

		return string.Equals( e?.Button, "mouseleft", StringComparison.OrdinalIgnoreCase );
	}

	void OnSlotMouseDown( int index, PanelEvent e )
	{
		if ( !IsLeftMouse( e ) ) return;
		if ( !IsOpen ) return;
		if ( IsDragging ) return;
		if ( CtxVisible ) return;
		if ( Player.Local?.InventoryMovePending == true ) return;

		var slot = GetSlot( index );
		if ( slot is null || slot.IsEmpty ) return;

		FocusedSlotIndex = index;
		DragSourceIndex = index;
		DragIconPath = slot.Item.Definition?.IconPath;
		DragCount = slot.Item.Count;
		IsDragging = true;
		HoverSlotIndex = index;
		UpdateDragGhostPosition();
	}

	void OnSlotMouseUp( PanelEvent e )
	{
		if ( !IsLeftMouse( e ) ) return;
		if ( !IsDragging ) return;

		FinishDrag( HoverSlotIndex );
	}

	void OnOverlayMouseUp( PanelEvent e )
	{
		if ( !IsLeftMouse( e ) ) return;
		if ( !IsDragging ) return;

		FinishDrag( HoverSlotIndex );
	}

	void UpdateDragGhostPosition()
	{
		DragX = GetMousePanelX() - SlotSizePx * 0.5f;
		DragY = GetMousePanelY() - SlotSizePx * 0.5f;
	}

	void FinishDrag( int targetIndex )
	{
		var from = DragSourceIndex;
		var to = targetIndex;

		ResetDragState();

		if ( from < 0 ) return;
		if ( to < 0 ) return;
		if ( from == to ) return;
		if ( to >= SlotCount ) return;
		if ( Player.Local?.InventoryMovePending == true ) return;

		Player.Local?.MoveOrSwapInventorySlots( from, to );
	}

	void CancelDrag()
	{
		ResetDragState();
	}

	void ResetDragState()
	{
		IsDragging = false;
		DragSourceIndex = -1;
		DragIconPath = null;
		DragCount = 0;
	}

	string SlotStateClass( int index, Slot slot )
	{
		var result = slot is not null && !slot.IsEmpty ? "has-item" : "empty";
		if ( Player.Local?.CurrentInventorySlotIndex == index ) result += " equipped";
		if ( FocusedSlotIndex == index ) result += " selected";
		if ( IsDragging && DragSourceIndex == index ) result += " dragging-source";
		if ( IsDragging && HoverSlotIndex == index && index != DragSourceIndex ) result += " drag-over";
		return result;
	}

	string ItemDescription( Slot slot )
	{
		var description = GameLocalization.ItemDescription( slot?.Item?.Definition );
		return string.IsNullOrWhiteSpace( description )
			? GameLocalization.Phrase( "common.no_description", "No description" )
			: description;
	}

	protected override void OnDisabled()
	{
		ReleaseCrosshairBlock();
	}

	protected override void OnStart()
	{
		UiModalManager.ActiveModalChanged += OnActiveModalChanged;
	}

	protected override void OnDestroy()
	{
		UiModalManager.ActiveModalChanged -= OnActiveModalChanged;
		ReleaseCrosshairBlock();
	}

	private void ReleaseCrosshairBlock()
	{
		IsOpen = false;
		CtxVisible = false;
		ResetDragState();
		Crosshair.SetBlocked( ModalId, false );
		UiModalManager.Close( ModalId );
	}

	float GetMousePanelX() => Mouse.Position.x * Panel.ScaleFromScreen;
	float GetMousePanelY() => Mouse.Position.y * Panel.ScaleFromScreen;

	protected override int BuildHash()
	{
		if (IsOpen)
			return System.HashCode.Combine(Time.Now, UiModalManager.Version);

		var hashBuilder = new HashCode();
		hashBuilder.Add( IsOpen );
		hashBuilder.Add( UiModalManager.Version );
		hashBuilder.Add( CtxVisible );
		hashBuilder.Add( CtxSlotIndex );
		hashBuilder.Add( CtxX );
		hashBuilder.Add( CtxY );
		hashBuilder.Add( SlotCount );
		hashBuilder.Add( HoverSlotIndex );
		hashBuilder.Add( IsDragging );
		hashBuilder.Add( DragSourceIndex );
		hashBuilder.Add( DragX );
		hashBuilder.Add( DragY );
		hashBuilder.Add( GameLocalization.CurrentCode );

		var hash = hashBuilder.ToHashCode();
		if ( Inv is not null )
		{
			foreach ( var slot in Inv.Slots )
			{
				hash = System.HashCode.Combine( hash, slot.Item?.Id, slot.Item?.Count ?? 0 );
			}
		}
		return hash;
	}
}
