@using Sandbox.UI;
@inherits PanelComponent

<root>
    <div class="sign">
        <div class="sign-line top-line">* * * * * * * * * *</div>
        <div class="sign-title">Press E</div>
        <div class="sign-title accent">To start</div>
        <div class="sign-line bot-line">* * * * * * * * * *</div>
    </div>
</root>

<style>

    root {
        width: 260px;
        pointer-events: none;
    }

    .sign {
        background-color: #000000;
        border: 3px solid #ffffff;
        padding: 14px 18px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        image-rendering: pixelated;
    }

    .sign-title {
        font-family: "Courier New", monospace;
        font-size: 26px;
        font-weight: 700;
        color: #ffffff;
        letter-spacing: 6px;
        text-align: center;
    }

    .accent {
        font-size: 38px;
        letter-spacing: 10px;
        color: #f0d060;
        text-shadow: 2px 2px 0px #a08000, 4px 4px 0px #604000;
    }

    .sign-line {
        font-family: "Courier New", monospace;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 3px;
        color: rgba(255, 255, 255, 0.35);
    }

</style>
