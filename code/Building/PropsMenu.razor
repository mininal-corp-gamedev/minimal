@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Collections.Generic;
@using System.Globalization;
@using System.Linq;
@using System.Text.Json;
@using System.Threading.Tasks;
@using Minimal.Toolgun;
@inherits PanelComponent
@namespace Sandbox

<root>
	@if ( LookedPropName is not null )
	{
		<div class="prop-look-hud">
			<div class="prop-look-title">@LookedPropName</div>
			<div class="prop-look-owner">@GameLocalization.Format( "ui.props.owner", "Owner: {0}", LookedPropOwnerName )</div>
			@if ( LookedPropIsFadingDoor )
			{
				<div class="prop-look-fading-door">Fading Door</div>
			}
			@if ( LookedPropIsTextscreen )
			{
				<div class="prop-look-fading-door">Textscreen</div>
			}
		</div>
	}

	@if ( IsOpen && UiModalManager.IsActive( ModalId ) )
	{
		<div class="overlay" onmouseup=@ClearTextFocus>
			<div class="pm-panel" @ref="FocusSinkRef">
				<div class="props-area">
					<div class="page-head">
						<div onmouseup=@ClearTextFocus>
							<div class="page-title">@GameLocalization.Phrase( "ui.props.title" )</div>
						</div>
						<div class="head-actions">
							<TextEntry @ref="SearchInputRef" class="search-input" Value:bind="@SearchText" Placeholder="@GameLocalization.Phrase( "ui.props.search", "Search props..." )" OnTextEdited=@OnSearchTextEdited onfocus=@OnSearchFocus onblur=@OnSearchBlur />
							<button class="refresh-btn" onclick=@(() => RefreshProps())>@GameLocalization.Phrase( "ui.props.refresh" )</button>
						</div>
					</div>

					@if ( AvailableProps.Count == 0 )
					{
						<div class="empty-state">@GameLocalization.Phrase( "ui.props.empty_assets" )</div>
					}
					else
					{
						var visibleProps = VisibleProps.ToList();

						<div class="catalog-bar" @ref="CatalogBarRef" onmouseup=@ClearTextFocus>
							<button class="catalog-btn @(!SelectedFavoritesOnly && string.IsNullOrWhiteSpace( SelectedCategory ) ? "active" : "")" onclick=@(() => SelectCategory( null ))>
								<div class="catalog-label">@GameLocalization.Phrase( "ui.props.all" )</div>
								<div class="catalog-count">@AvailableProps.Count</div>
							</button>

							<button class="catalog-btn favorite-catalog @(SelectedFavoritesOnly ? "active" : "")" onclick=@(() => SelectFavorites())>
								<div class="catalog-label">@GameLocalization.Phrase( "ui.props.favorites" )</div>
								<div class="catalog-count">@GetFavoritesCount()</div>
							</button>

							@foreach ( var category in AvailableCategories )
							{
								<button class="catalog-btn @(!SelectedFavoritesOnly && IsSelectedCategory( category ) ? "active" : "")" onclick=@(() => SelectCategory( category ))>
									<div class="catalog-label">@category</div>
									<div class="catalog-count">@GetCategoryCount( category )</div>
								</button>
							}
						</div>

						<div class="props-meta" onmouseup=@ClearTextFocus>
							<div class="props-limit">@GameLocalization.Format( "ui.props.limit", "Props limit: {0} / {1}", GetOwnedPropsCount(), GetMaxProps() )</div>
							<div class="props-count">@GameLocalization.Format( "ui.props.shown", "Shown {0} / {1}", visibleProps.Count, AvailableProps.Count )</div>
						</div>

						@if ( visibleProps.Count == 0 )
						{
							<div class="empty-state">@GameLocalization.Phrase( "ui.props.empty_search" )</div>
						}
						else
						{
							<div class="props-scroll-area" onmouseup=@ClearTextFocus>
								<div class="props-list" @ref="PropsListRef" onmouseup=@ClearTextFocus onwheel=@OnPropsListWheel>
									<div class="props-grid">
										@foreach ( var prop in visibleProps )
										{
											var thumbUrl = GetThumbUrl( prop );
											var canSpawn = CanRequestSpawn( prop );
											var isFavorite = IsFavorite( prop );

											<div class="prop-card @(canSpawn ? "" : "disabled") @(isFavorite ? "favorite" : "")">
												<button
													class="prop-hitbox"
													disabled=@(!canSpawn)
													onclick=@(() => RequestSpawn( prop ))>
													<div class="prop-thumb @(string.IsNullOrEmpty( thumbUrl ) ? "loading" : "")">
														@if ( !string.IsNullOrEmpty( thumbUrl ) )
														{
															<img src="@thumbUrl" />
														}
													</div>
													<div class="prop-info">
														<div class="prop-title">@GetPropHeader( prop )</div>
														<div class="prop-category">@GetPropCategory( prop )</div>
													</div>
												</button>

												<button
													class="favorite-btn @(isFavorite ? "active" : "")"
													onclick=@(() => ToggleFavorite( prop ))>
													@(isFavorite ? "♥" : "♡")
												</button>
											</div>
										}
										<div class="props-grid-spacer"></div>
									</div>
								</div>
								<div class="scrollbar-placeholder"></div>
							</div>
						}
					}
				</div>

				<div class="tool-strip">
					@foreach ( var tool in ToolMode.All )
					{
						<button class="tool-btn @(IsActiveTool( tool ) ? "active" : "")" onclick=@(() => SelectTool( tool.Id ))>@GetToolTitle( tool )</button>
					}
				</div>

				<div class="tool-content" onmouseup=@ClearTextFocus>
					@if ( GetActiveTool() is null )
					{
						<div class="tool-title">@GameLocalization.Phrase( "ui.props.tool" )</div>
						<div class="tool-text">@GameLocalization.Phrase( "ui.props.select_tool" )</div>
					}
					else
					{
						var activeTool = GetActiveTool();
						<div class="tool-title">@GetToolTitle( activeTool )</div>
						<div class="tool-text">@GetToolDescription( activeTool )</div>

						@if ( activeTool is TextscreenTool )
						{
							<div class="textscreen-config">
								<div class="textscreen-background-row">
									<div class="tool-config-label">@GameLocalization.Phrase( "tool.textscreen.background", "Background" )</div>
									<button class="tool-toggle @(IsConfigValue( TextscreenTool.BackgroundConfigKey, "true" ) ? "active" : "")" onclick=@(() => ToggleToolBool( TextscreenTool.BackgroundConfigKey ))>
										@(IsConfigValue( TextscreenTool.BackgroundConfigKey, "true" ) ? GameLocalization.Phrase( "ui.common.enabled", "Enabled" ) : GameLocalization.Phrase( "ui.common.disabled", "Disabled" ))
									</button>
								</div>
								@for ( var i = 0; i < TextscreenTool.LineCount; i++ )
								{
									var lineIndex = i;
									<div class="textscreen-line">
										<div class="textscreen-line-head">
											<div class="tool-config-label">@GameLocalization.Format( "tool.textscreen.line", "Line {0}", lineIndex + 1 )</div>
											<button class="line-reset-btn" onclick=@(() => ResetTextscreenLine( lineIndex ))>@GameLocalization.Phrase( "ui.common.reset", "Reset" )</button>
										</div>
										<TextEntry class="tool-input textscreen-text-input" Value="@GetToolConfigValue( TextscreenTool.TextKey( lineIndex ) )" Placeholder="@GameLocalization.Phrase( "tool.textscreen.placeholder", "Text..." )" OnTextEdited=@( (string text) => SetToolConfigValue( TextscreenTool.TextKey( lineIndex ), text ) ) />
										<div class="textscreen-row">
											<div class="textscreen-size-controls">
												<button class="textscreen-size-step" onclick=@(() => StepTextscreenSize( lineIndex, -1 ))>-</button>
												<div class="textscreen-size-value">@GetTextscreenSizeValue( lineIndex )</div>
												<button class="textscreen-size-step" onclick=@(() => StepTextscreenSize( lineIndex, 1 ))>+</button>
											</div>
											<div class="textscreen-colors">
												@foreach ( var option in TextscreenTool.ColorButtons )
												{
													<button class="textscreen-color-btn @(IsConfigValue( TextscreenTool.ColorKey( lineIndex ), option.Value ) ? "active" : "")" style=@($"background-color: {option.Swatch};") onclick=@(() => SetToolConfigValue( TextscreenTool.ColorKey( lineIndex ), option.Value ))></button>
												}
											</div>
										</div>
									</div>
								}
							</div>
						}
						else if ( activeTool.ConfigFields.Count > 0 )
						{
							<div class="tool-config">
								@foreach ( var field in activeTool.ConfigFields )
								{
									<div class="tool-config-field">
										<div class="tool-config-label">@GetToolFieldLabel( activeTool, field )</div>

										@if ( field.Type == ToolConfigType.Button )
										{
											<div class="tool-config-buttons">
												@foreach ( var option in field.Buttons )
												{
													<button class="tool-config-btn @(IsConfigValue( field.Id, option.Value ) ? "active" : "")" onclick=@(() => SetToolConfigValue( field.Id, option.Value ))>
														@if ( !string.IsNullOrWhiteSpace( option.Swatch ) )
														{
															<div class="tool-color-swatch" style=@($"background-color: {option.Swatch};")></div>
														}
														<div class="tool-config-btn-label">@GetToolOptionLabel( activeTool, option )</div>
													</button>
												}
											</div>
										}
										else if ( field.Type == ToolConfigType.Bool )
										{
											<button class="tool-toggle @(IsConfigValue( field.Id, "true" ) ? "active" : "")" onclick=@(() => ToggleToolBool( field.Id ))>
												@(IsConfigValue( field.Id, "true" ) ? GameLocalization.Phrase( "ui.common.enabled", "Enabled" ) : GameLocalization.Phrase( "ui.common.disabled", "Disabled" ))
											</button>
										}
										else if ( field.Type == ToolConfigType.Slider )
										{
											<div class="tool-slider-value">@GetSliderValueText( field )</div>
											<div class="tool-slider-row">
												<button class="tool-slider-step" onclick=@(() => StepSlider( field, -1f ))>-</button>
												<div class="SliderBody tool-slider-body" @ref="SliderBodyRef" onmousedown=@((PanelEvent e) => StartSliderDrag( field, e ))>
													<div class="SliderTrack tool-slider-track">
														<div class="tool-slider-fill" style=@($"width: {GetSliderPercent( field ):0.###}%;")></div>
													</div>
												</div>
												<button class="tool-slider-step" onclick=@(() => StepSlider( field, 1f ))>+</button>
											</div>
										}
										else
										{
											<TextEntry class="tool-input" Value="@GetToolConfigValue( field.Id )" Placeholder="@GetToolFieldLabel( activeTool, field )" OnTextEdited=@( (string text) => SetToolConfigValue( field.Id, text ) ) />
										}
									</div>
								}
							</div>
						}
					}
				</div>
			</div>
		</div>
	}
</root>

@code
{
	const string ModalId = nameof( PropsMenu );
	public static PropsMenu Instance { get; private set; }

	bool IsOpen { get; set; } = false;
	List<PropDefinition> AvailableProps { get; set; } = new();
	List<string> AvailableCategories { get; set; } = new();
	Dictionary<string, string> ThumbUrls { get; set; } = new();
	HashSet<string> FavoritePropIds { get; set; } = new( StringComparer.Ordinal );
	string SelectedCategory { get; set; }
	bool SelectedFavoritesOnly { get; set; }
	string SearchText { get; set; } = "";
	string LastSearchText { get; set; } = "";
	int PropsVersion { get; set; } = 0;
	Panel FocusSinkRef { get; set; }
	TextEntry SearchInputRef { get; set; }
	Panel PropsListRef { get; set; }
	Panel CatalogBarRef { get; set; }
	Panel SliderBodyRef { get; set; }
	bool IsSearchFocused { get; set; }
	bool IsSliderDragging { get; set; }
	ToolConfigField DragSliderField { get; set; }
	float LastSliderMouseX { get; set; }
	IEnumerable<PropDefinition> VisibleProps => GetVisibleProps();

	private const float SpawnTraceDistance = 420f;
	private const float FallbackSpawnDistance = 120f;
	private const float SpawnSurfaceOffset = 24f;
	private const float LookTraceDistance = 200f;
	private const float PropsWheelScrollStep = 74f;
	private const float PropsCardWidth = 180f;
	private const float PropsCardHeight = 182f;
	private const float PropsGridColumnGap = 16f;
	private const float PropsGridRowGap = 16f;
	private const float PropsListVerticalPadding = 12f;
	private const string PropFavoritesFolder = "props_favorites";

	string LookedPropName { get; set; }
	string LookedPropOwnerName { get; set; }
	bool LookedPropIsFadingDoor { get; set; }
	bool LookedPropIsTextscreen { get; set; }

	public sealed class PropFavoritesSaveData
	{
		public long SteamId { get; set; }
		public List<string> PropIds { get; set; } = new();
	}

	private void LoadProps()
	{
		AvailableProps = ResourceLibrary
			.GetAll<PropDefinition>()
			.Where( x => x is not null )
			.OrderBy( x => GetPropCategory( x ) )
			.ThenBy( x => GetPropHeader( x ) )
			.ToList();

		RefreshCategories();

		PropsVersion++;

		_ = LoadThumbnailsAsync();
	}

	private void RefreshProps()
	{
		ClearTextFocus();
		ResetPropsListScroll();
		LoadProps();
	}

	private void RefreshCategories()
	{
		AvailableCategories = AvailableProps
			.Select( GetPropCategory )
			.GroupBy( category => category, StringComparer.OrdinalIgnoreCase )
			.Select( group => group.Key )
			.OrderBy( category => category, StringComparer.OrdinalIgnoreCase )
			.ToList();

		if ( !string.IsNullOrWhiteSpace( SelectedCategory ) && !AvailableCategories.Any( IsSelectedCategory ) )
			SelectedCategory = null;
	}

	private void SelectCategory( string category )
	{
		ClearTextFocus();
		ResetPropsListScroll();
		SelectedFavoritesOnly = false;
		SelectedCategory = string.IsNullOrWhiteSpace( category ) ? null : category;
	}

	private void SelectFavorites()
	{
		ClearTextFocus();
		ResetPropsListScroll();
		SelectedFavoritesOnly = true;
		SelectedCategory = null;
	}

	private void SelectTool( string toolId )
	{
		ClearTextFocus();
		ToolgunClientState.SelectTool( toolId );

		var tool = ToolMode.Get( toolId );
		if ( tool is ColorTool && string.IsNullOrWhiteSpace( ToolgunClientState.GetConfigValue( ColorTool.ColorConfigKey ) ) )
			ToolgunClientState.SetConfigValue( ColorTool.ColorConfigKey, "white" );
	}

	private ToolMode GetActiveTool()
	{
		var tool = ToolgunClientState.SelectedTool;
		ToolgunClientState.EnsureDefaults( tool );
		return tool;
	}

	private static string GetToolTitle( ToolMode tool )
	{
		return tool is null ? string.Empty : GameLocalization.Phrase( $"tool.{tool.Id}.title", tool.Title );
	}

	private static string GetToolDescription( ToolMode tool )
	{
		return tool is null ? string.Empty : GameLocalization.Phrase( $"tool.{tool.Id}.description", tool.Description );
	}

	private static string GetToolFieldLabel( ToolMode tool, ToolConfigField field )
	{
		if ( tool is null || field is null )
			return string.Empty;

		return GameLocalization.Phrase( $"tool.{tool.Id}.field.{field.Id}", field.Label );
	}

	private static string GetToolOptionLabel( ToolMode tool, ToolConfigButton option )
	{
		if ( tool is null || option is null )
			return string.Empty;

		return GameLocalization.Phrase( $"tool.{tool.Id}.option.{option.Value}", option.Label );
	}

	private bool IsActiveTool( ToolMode tool )
	{
		return tool is not null && string.Equals( ToolgunClientState.SelectedToolId, tool.Id, StringComparison.Ordinal );
	}

	private string GetToolConfigValue( string key )
	{
		return ToolgunClientState.GetConfigValue( key ) ?? string.Empty;
	}

	private bool IsConfigValue( string key, string value )
	{
		return string.Equals( ToolgunClientState.GetConfigValue( key ), value, StringComparison.OrdinalIgnoreCase );
	}

	private void SetToolConfigValue( string key, string value )
	{
		ToolgunClientState.SetConfigValue( key, value );
	}

	private void ToggleToolBool( string key )
	{
		ToolgunClientState.SetConfigValue( key, IsConfigValue( key, "true" ) ? "false" : "true" );
	}

	private float GetSliderValue( ToolConfigField field )
	{
		if ( field is null )
			return 0f;

		var raw = ToolgunClientState.GetConfigValue( field.Id ) ?? field.DefaultValue ?? "0";
		if ( !float.TryParse( raw, NumberStyles.Float, CultureInfo.InvariantCulture, out var value ) )
			value = 0f;

		return ClampToSlider( field, value );
	}

	private string GetSliderValueText( ToolConfigField field )
	{
		return GetSliderValue( field ).ToString( "0.###", CultureInfo.InvariantCulture );
	}

	private float GetSliderPercent( ToolConfigField field )
	{
		if ( field is null || MathF.Abs( field.Max - field.Min ) <= 0.001f )
			return 0f;

		return Math.Clamp( (GetSliderValue( field ) - field.Min) / (field.Max - field.Min) * 100f, 0f, 100f );
	}

	private void StepSlider( ToolConfigField field, float direction )
	{
		var step = field.Step <= 0f ? 1f : field.Step;
		SetSliderValue( field, GetSliderValue( field ) + direction * step );
	}

	private void StartSliderDrag( ToolConfigField field, PanelEvent e )
	{
		IsSliderDragging = true;
		DragSliderField = field;
		LastSliderMouseX = GetMousePanelX();
	}

	private void UpdateSliderDrag()
	{
		if ( !IsSliderDragging )
			return;

		if ( !Input.Down( "Attack1" ) )
		{
			IsSliderDragging = false;
			DragSliderField = null;
			return;
		}

		UpdateSliderFromMouseDelta( DragSliderField );
	}

	private void UpdateSliderFromMouseDelta( ToolConfigField field )
	{
		if ( field is null || !SliderBodyRef.IsValid() )
			return;

		var mouseX = GetMousePanelX();
		var deltaX = mouseX - LastSliderMouseX;
		LastSliderMouseX = mouseX;

		if ( MathF.Abs( deltaX ) <= 0.001f )
			return;

		var width = MathF.Max( SliderBodyRef.Box.RectInner.Width, 1f );
		var valueDelta = deltaX / width * (field.Max - field.Min);
		SetSliderValue( field, GetSliderValue( field ) + valueDelta );
	}

	private void SetSliderValue( ToolConfigField field, float value )
	{
		if ( field is null )
			return;

		var clamped = ClampToSlider( field, value );
		ToolgunClientState.SetConfigValue( field.Id, clamped.ToString( "0.###", CultureInfo.InvariantCulture ) );
	}

	private static float ClampToSlider( ToolConfigField field, float value )
	{
		var clamped = Math.Clamp( value, field.Min, field.Max );
		var step = field.Step <= 0f ? 1f : field.Step;
		if ( step > 0f )
			clamped = MathF.Round( clamped / step ) * step;

		return Math.Clamp( clamped, field.Min, field.Max );
	}

	private void ResetTextscreenLine( int lineIndex )
	{
		ToolgunClientState.SetConfigValue( TextscreenTool.TextKey( lineIndex ), string.Empty );
		ToolgunClientState.SetConfigValue( TextscreenTool.SizeKey( lineIndex ), TextscreenTool.DefaultSize.ToString( CultureInfo.InvariantCulture ) );
		ToolgunClientState.SetConfigValue( TextscreenTool.ColorKey( lineIndex ), TextscreenTool.DefaultColor );
	}

	private void StepTextscreenSize( int lineIndex, int direction )
	{
		if ( !IsValidTextscreenLineIndex( lineIndex ) )
			return;

		var size = GetTextscreenSize( lineIndex );
		size = Math.Clamp( size + direction, 1, 40 );
		ToolgunClientState.SetConfigValue( TextscreenTool.SizeKey( lineIndex ), size.ToString( CultureInfo.InvariantCulture ) );
	}

	private string GetTextscreenSizeValue( int lineIndex )
	{
		return GetTextscreenSize( lineIndex ).ToString( CultureInfo.InvariantCulture );
	}

	private int GetTextscreenSize( int lineIndex )
	{
		return IsValidTextscreenLineIndex( lineIndex )
			? ClampTextscreenSize( GetToolConfigValue( TextscreenTool.SizeKey( lineIndex ) ) )
			: TextscreenTool.DefaultSize;
	}

	private static int ClampTextscreenSize( string value )
	{
		var raw = (value ?? string.Empty).Trim();
		if ( !int.TryParse( raw, NumberStyles.Integer, CultureInfo.InvariantCulture, out var size ) )
			size = TextscreenTool.DefaultSize;

		return Math.Clamp( size, 1, 40 );
	}

	private static bool IsValidTextscreenLineIndex( int lineIndex )
	{
		return lineIndex >= 0 && lineIndex < TextscreenTool.LineCount;
	}

	float GetMousePanelX() => Mouse.Position.x * Panel.ScaleFromScreen;

	private void ClearTextFocus()
	{
		SearchInputRef?.Blur();
		FocusSinkRef?.Focus();
	}

	private void OnSearchFocus()
	{
		IsSearchFocused = true;
	}

	private void OnSearchBlur()
	{
		IsSearchFocused = false;
	}

	private void OnSearchTextEdited( string text )
	{
		var previous = LastSearchText ?? string.Empty;
		var next = text ?? string.Empty;

		if ( IsSearchFocused
			&& next.Length == previous.Length + 1
			&& next.EndsWith( "q", StringComparison.OrdinalIgnoreCase ) )
		{
			SearchText = previous;
			LastSearchText = previous;
			if ( SearchInputRef.IsValid() )
				SearchInputRef.Text = previous;

			SetOpen( false );
			return;
		}

		SearchText = next;
		LastSearchText = next;
		ResetPropsListScroll();
	}

	private void ResetPropsListScroll()
	{
		if ( PropsListRef.IsValid() )
		{
			PropsListRef.ScrollVelocity = Vector2.Zero;
			PropsListRef.ScrollOffset = Vector2.Zero;
		}
	}

	private bool IsSelectedCategory( string category )
	{
		return string.Equals( SelectedCategory, category, StringComparison.OrdinalIgnoreCase );
	}

	private int GetCategoryCount( string category )
	{
		return AvailableProps.Count( prop => string.Equals( GetPropCategory( prop ), category, StringComparison.OrdinalIgnoreCase ) );
	}

	private int GetFavoritesCount()
	{
		return AvailableProps.Count( IsFavorite );
	}

	private IEnumerable<PropDefinition> GetVisibleProps()
	{
		IEnumerable<PropDefinition> props = AvailableProps;

		if ( SelectedFavoritesOnly )
			props = props.Where( IsFavorite );
		else if ( !string.IsNullOrWhiteSpace( SelectedCategory ) )
			props = props.Where( prop => string.Equals( GetPropCategory( prop ), SelectedCategory, StringComparison.OrdinalIgnoreCase ) );

		var search = (SearchText ?? string.Empty).Trim();
		if ( !string.IsNullOrWhiteSpace( search ) )
			props = props.Where( prop => MatchesSearch( prop, search ) );

		return props;
	}

	private static bool MatchesSearch( PropDefinition prop, string search )
	{
		if ( prop is null || string.IsNullOrWhiteSpace( search ) )
			return true;

		return ContainsSearch( GetPropHeader( prop ), search )
			|| ContainsSearch( GetPropCategory( prop ), search )
			|| ContainsSearch( prop.Id, search )
			|| ContainsSearch( prop.Ident, search );
	}

	private static bool ContainsSearch( string value, string search )
	{
		return (value ?? string.Empty).IndexOf( search, StringComparison.OrdinalIgnoreCase ) >= 0;
	}

	private bool IsFavorite( PropDefinition prop )
	{
		var id = GetFavoriteId( prop );
		return !string.IsNullOrWhiteSpace( id ) && FavoritePropIds.Contains( id );
	}

	private void ToggleFavorite( PropDefinition prop )
	{
		ClearTextFocus();

		var id = GetFavoriteId( prop );
		if ( string.IsNullOrWhiteSpace( id ) )
			return;

		var shouldFavorite = !FavoritePropIds.Contains( id );
		if ( shouldFavorite )
			FavoritePropIds.Add( id );
		else
			FavoritePropIds.Remove( id );

		PropsVersion++;
		RpcSetPropFavorite( id, shouldFavorite );
	}

	private void ApplyFavoriteIds( IEnumerable<string> ids )
	{
		FavoritePropIds = new HashSet<string>(
			(ids ?? Enumerable.Empty<string>())
				.Where( id => !string.IsNullOrWhiteSpace( id ) )
				.Select( id => id.Trim() ),
			StringComparer.Ordinal );

		PropsVersion++;
	}

	private async Task LoadThumbnailsAsync()
	{
		foreach ( var prop in AvailableProps.ToList() )
		{
			if ( prop is null || string.IsNullOrWhiteSpace( prop.Ident ) )
				continue;
			if ( ThumbUrls.ContainsKey( prop.Ident ) )
				continue;

			try
			{
				var package = await Package.Fetch( prop.Ident, false );
				if ( package is null )
					continue;

				ThumbUrls[prop.Ident] = package.Thumb;
				PropsVersion++;
			}
			catch ( Exception e )
			{
				Log.Warning( $"[PropsMenu] Failed to fetch thumb for '{prop.Ident}': {e.Message}" );
			}
		}
	}

	private string GetThumbUrl( PropDefinition prop )
	{
		if ( prop is null || string.IsNullOrWhiteSpace( prop.Ident ) )
			return null;
		return ThumbUrls.TryGetValue( prop.Ident, out var url ) ? url : null;
	}

	private void RequestSpawn( PropDefinition prop )
	{
		ClearTextFocus();

		if ( !CanRequestSpawn( prop ) )
			return;
		if ( !Player.Local.IsValid() || !Player.Local.Controller.IsValid() )
			return;

		var eye = Player.Local.Controller.EyeTransform;
		RpcRequestSpawnProp( prop.Id, eye.Position, eye.Forward );
	}

	private bool CanRequestSpawn( PropDefinition prop )
	{
		return prop is not null
			&& !string.IsNullOrWhiteSpace( prop.Id )
			&& !string.IsNullOrWhiteSpace(prop.Ident)
			&& Player.Local.IsValid()
			&& GetOwnedPropsCount() < GetMaxProps();
	}

	private int GetOwnedPropsCount()
	{
		return Player.Local?.OwnedPropsCount ?? 0;
	}

	private int GetMaxProps()
	{
		return Math.Max( 0, Player.Local?.MaxProps ?? 0 );
	}

	private static string GetPropHeader( PropDefinition prop )
	{
		if ( prop is null )
			return GameLocalization.Phrase( "common.unknown", "Unknown" );

		if ( !string.IsNullOrWhiteSpace( prop.Header ) )
			return prop.Header;

		return string.IsNullOrWhiteSpace( prop.Id ) ? GameLocalization.Phrase( "common.unknown", "Unknown" ) : prop.Id;
	}

	private static string GetPropCategory( PropDefinition prop )
	{
		var category = (prop?.Category ?? string.Empty).Trim();
		return string.IsNullOrWhiteSpace( category ) ? GameLocalization.Phrase( "category.other", "Other" ) : GameLocalization.Category( category );
	}

	private static string GetFavoriteId( PropDefinition prop )
	{
		return (prop?.Id ?? string.Empty).Trim();
	}

	[Rpc.Host]
	private static void RpcRequestPropFavorites()
	{
#if SERVER
		if ( !Networking.IsHost )
			return;

		var caller = Rpc.Caller;
		if ( caller is null )
			return;

		SendPropFavorites( caller, LoadPropFavorites( caller.SteamId.Value ).PropIds );
#endif
	}

	[Rpc.Host]
	private static void RpcSetPropFavorite( string propId, bool favorite )
	{
#if SERVER
		if ( !Networking.IsHost )
			return;

		var caller = Rpc.Caller;
		if ( caller is null )
			return;

		var normalized = (propId ?? string.Empty).Trim();
		if ( string.IsNullOrWhiteSpace( normalized ) )
			return;

		var data = LoadPropFavorites( caller.SteamId.Value );
		data.SteamId = caller.SteamId.Value;
		data.PropIds ??= new();

		if ( favorite )
		{
			if ( !data.PropIds.Any( id => string.Equals( id, normalized, StringComparison.Ordinal ) ) )
				data.PropIds.Add( normalized );
		}
		else
		{
			data.PropIds.RemoveAll( id => string.Equals( id, normalized, StringComparison.Ordinal ) );
		}

		data.PropIds = data.PropIds
			.Where( id => !string.IsNullOrWhiteSpace( id ) )
			.Select( id => id.Trim() )
			.Distinct( StringComparer.Ordinal )
			.OrderBy( id => id, StringComparer.Ordinal )
			.ToList();

		SavePropFavorites( data );
		SendPropFavorites( caller, data.PropIds );
#endif
	}

#if SERVER
	private static void SendPropFavorites( Connection caller, IEnumerable<string> propIds )
	{
		if ( caller is null )
			return;

		var json = JsonSerializer.Serialize( propIds?.ToList() ?? new List<string>() );
		using ( Rpc.FilterInclude( x => x.SteamId.Value == caller.SteamId.Value ) )
		{
			RpcReceivePropFavorites( json );
		}
	}

	[Rpc.Broadcast]
	private static void RpcReceivePropFavorites( string propIdsJson )
	{
		try
		{
			var ids = JsonSerializer.Deserialize<List<string>>( propIdsJson ?? "[]" ) ?? new();
			Instance?.ApplyFavoriteIds( ids );
		}
		catch ( Exception e )
		{
			Log.Warning( $"[PropsMenu] Failed to receive favorites: {e.Message}" );
		}
	}

	private static void EnsurePropFavoritesFolder()
	{
		FileSystem.Data.CreateDirectory( PropFavoritesFolder );
	}

	private static string GetPropFavoritesPath( long steamId )
	{
		return $"{PropFavoritesFolder}/{steamId}.json";
	}

	private static PropFavoritesSaveData LoadPropFavorites( long steamId )
	{
		EnsurePropFavoritesFolder();

		try
		{
			var path = GetPropFavoritesPath( steamId );
			if ( !FileSystem.Data.FileExists( path ) )
				return new PropFavoritesSaveData { SteamId = steamId };

			var data = FileSystem.Data.ReadJsonOrDefault<PropFavoritesSaveData>( path );
			if ( data is null )
				return new PropFavoritesSaveData { SteamId = steamId };

			data.SteamId = steamId;
			data.PropIds ??= new();
			return data;
		}
		catch ( Exception e )
		{
			Log.Warning( $"[PropsMenu] Failed to load favorites for {steamId}: {e.Message}" );
			return new PropFavoritesSaveData { SteamId = steamId };
		}
	}

	private static void SavePropFavorites( PropFavoritesSaveData data )
	{
		if ( data is null || data.SteamId <= 0 )
			return;

		EnsurePropFavoritesFolder();
		FileSystem.Data.WriteJson( GetPropFavoritesPath( data.SteamId ), data );
	}
#endif

	[Rpc.Host]
	private static void RpcRequestSpawnProp( string propId, Vector3 eyePosition, Vector3 eyeForward )
	{
#if SERVER
		if ( !Networking.IsHost )
			return;

		var caller = Rpc.Caller;
		if ( caller is null )
			return;

		var player = Player.FindPlayerBySteamId( caller.SteamId.Value );
		if ( !player.IsValid() || player.GameObject.Network.Owner != caller || !player.Controller.IsValid() )
		{
			NotifyCaller( caller, GameLocalization.Phrase( "notify.player.not_ready", "Your player is not ready." ), false );
			return;
		}

		if ( player.OwnedPropsCount >= player.MaxProps )
		{
			NotifyCaller( caller, GameLocalization.Format( "notify.props.limit_reached", "Prop limit reached ({0}).", player.MaxProps ), false );
			return;
		}

		var normalized = (propId ?? string.Empty).Trim();
		var prop = ResourceLibrary
			.GetAll<PropDefinition>()
			.FirstOrDefault( x => x is not null && string.Equals( x.Id, normalized, StringComparison.Ordinal ) );

		if ( prop is null )
		{
			NotifyCaller( caller, GameLocalization.Phrase( "notify.props.not_found", "Prop not found." ), false );
			return;
		}

		if ( string.IsNullOrWhiteSpace( prop.Ident ) )
		{
			NotifyCaller( caller, GameLocalization.Phrase( "notify.props.no_cloud_ident", "Prop has no cloud ident." ), false );
			return;
		}

		var forward = eyeForward.LengthSquared > 0.001f ? eyeForward.Normal : player.Controller.EyeTransform.Forward;
		if ( Vector3.DistanceBetween( player.WorldPosition, eyePosition ) > 220f )
			eyePosition = player.Controller.EyeTransform.Position;

		var trace = player.Scene.Trace
			.Ray( eyePosition, eyePosition + forward * SpawnTraceDistance )
			.IgnoreGameObjectHierarchy( player.GameObject )
			.WithoutTags( "player", "bullet" )
			.Run();

		var spawnPosition = trace.Hit
			? trace.HitPosition + trace.Normal * SpawnSurfaceOffset
			: player.WorldPosition + forward * FallbackSpawnDistance + Vector3.Up * SpawnSurfaceOffset;

		var yawForward = new Vector3( forward.x, forward.y, 0f );
		if ( yawForward.LengthSquared <= 0.001f )
			yawForward = player.WorldRotation.Forward;
		yawForward = yawForward.Normal;

		var callerCopy = caller;
		var playerCopy = player;
		var propCopy = prop;
		_ = SpawnCloudPropAsync( callerCopy, playerCopy, propCopy, spawnPosition, Rotation.LookAt( yawForward ) );
#endif
	}

#if SERVER
	private static async Task SpawnCloudPropAsync( Connection caller, Player player, PropDefinition prop, Vector3 position, Rotation rotation )
	{
		try
		{
			var package = await Package.Fetch( prop.Ident, false );
			if ( package is null || package.Revision is null )
			{
				NotifyCaller( caller, GameLocalization.Phrase( "notify.props.cloud_package_not_found", "Cloud package not found." ), false );
				return;
			}

			await package.MountAsync();

			var primaryAsset = package.GetMeta<string>( "PrimaryAsset" );
			if ( string.IsNullOrWhiteSpace( primaryAsset ) )
			{
				NotifyCaller( caller, GameLocalization.Phrase( "notify.props.no_primary_asset", "Package has no primary asset." ), false );
				return;
			}

			var model = Model.Load( primaryAsset );
			if ( model is null || model.IsError )
			{
				NotifyCaller( caller, GameLocalization.Phrase( "notify.props.failed_model", "Failed to load model." ), false );
				return;
			}

			if ( !player.IsValid() )
				return;

			if ( player.OwnedPropsCount >= player.MaxProps )
			{
				NotifyCaller( caller, GameLocalization.Format( "notify.props.limit_reached", "Prop limit reached ({0}).", player.MaxProps ), false );
				return;
			}

			var gameObj = new GameObject( true, GetPropHeader( prop ) );
			gameObj.WorldPosition = position;
			gameObj.WorldRotation = rotation;

			var propComponent = gameObj.Components.Create<Sandbox.Prop>();
			propComponent.Model = model;
			propComponent.Health = 999999f;

			var propCustom = gameObj.Components.Create<PropCustom>();
			propCustom.SetOwner( player );
			player.RegisterSpawnedProp( propCustom );

			gameObj.Tags.Add( "prop" );
			gameObj.NetworkSpawn();
			OwnedPropNetwork.ConfigurePropCustom( gameObj );

			Log.Info( $"[PropsMenu] {caller.DisplayName} spawned cloud prop '{GetPropHeader( prop )}' (ident: {prop.Ident})." );
			NotifyCaller( caller, GameLocalization.Format( "notify.props.spawned", "Spawned: {0}.", GetPropHeader( prop ) ), true );
		}
		catch ( Exception e )
		{
			Log.Warning( $"[PropsMenu] Cloud spawn failed for '{prop?.Ident}': {e.Message}" );
			NotifyCaller( caller, GameLocalization.Phrase( "notify.props.cloud_spawn_failed", "Cloud spawn failed." ), false );
		}
	}

	private static void NotifyCaller( Connection caller, string text, bool success )
	{
		using ( Rpc.FilterInclude( x => x.SteamId.Value == caller.SteamId.Value ) )
		{
			RpcReceiveSpawnResult( text, success );
		}
	}
#endif

	[Rpc.Broadcast]
	private static void RpcReceiveSpawnResult( string text, bool success )
	{
		if ( success )
			Notification.Info( text, 3.5f );
		else
			Notification.Error( text, 3.5f );
	}

	protected override void OnStart()
	{
		UiModalManager.ActiveModalChanged += OnActiveModalChanged;
		Instance = this;
		LoadProps();
		RpcRequestPropFavorites();
	}

	protected override void OnDisabled()
	{
		ReleaseCrosshairBlock();
	}

	protected override void OnDestroy()
	{
		UiModalManager.ActiveModalChanged -= OnActiveModalChanged;
		ReleaseCrosshairBlock();
		if ( Instance == this )
			Instance = null;
	}

	private void ReleaseCrosshairBlock()
	{
		IsOpen = false;
		Crosshair.SetBlocked( ModalId, false );
		UiModalManager.Close( ModalId );
	}

	private void SetOpen( bool open )
	{
		if ( open )
			UiModalManager.Open( ModalId );
		else
			UiModalManager.Close( ModalId );

		IsOpen = open;
		ClearTextFocus();

		Crosshair.SetBlocked( ModalId, open );

		UiModalManager.UpdateMouseVisibility();

		if ( open )
			RpcRequestPropFavorites();

		StateHasChanged();
	}

	private void OnActiveModalChanged( string activeModal )
	{
		if ( activeModal == ModalId || !IsOpen )
			return;

		IsOpen = false;
		ClearTextFocus();
		Crosshair.SetBlocked( ModalId, false );
		StateHasChanged();
	}

	protected override void OnFixedUpdate()
	{
		if ( Input.Pressed( "PropsMenu" ) )
			SetOpen(!IsOpen);
	}

	protected override void OnUpdate()
	{
		UpdateSliderDrag();
		UpdatePropsListWheelScroll();
		UpdateLookedPropInfo();
	}

	private static void ScrollPanel( Panel panel, float deltaY )
	{
		if ( !panel.IsValid() )
			return;

		var nextY = panel.ScrollOffset.y + deltaY;

		panel.ScrollVelocity = Vector2.Zero;
		panel.ScrollOffset = new Vector2( 0f, nextY );
	}

	private void OnPropsListWheel( Vector2 value )
	{
		ScrollPanel( PropsListRef, -value.y * PropsWheelScrollStep );
	}

	private void UpdatePropsListWheelScroll()
	{
		if ( !IsOpen )
			return;

		var wheelY = Input.MouseWheel.y;
		if ( MathF.Abs( wheelY ) <= 0f )
			return;

		ScrollPanel( PropsListRef, -wheelY * PropsWheelScrollStep );
		Input.MouseWheel = Vector2.Zero;
	}


	private void UpdateLookedPropInfo()
	{
		LookedPropName = null;
		LookedPropOwnerName = null;
		LookedPropIsFadingDoor = false;
		LookedPropIsTextscreen = false;

		var local = Player.Local;
		if ( !local.IsValid() || !local.Controller.IsValid() )
			return;

		var eye = local.Controller.EyeTransform;
		var trace = local.Scene.Trace
			.Ray( eye.Position, eye.Position + eye.Forward * LookTraceDistance )
			.IgnoreGameObjectHierarchy( local.GameObject )
			.WithoutTags( "player", "bullet" )
			.Run();

		if ( !trace.Hit || !trace.GameObject.IsValid() )
			return;

		var prop = trace.GameObject.Components.Get<PropCustom>( FindMode.EverythingInSelfAndAncestors );
		if ( !prop.IsValid() )
			return;

		LookedPropName = string.IsNullOrWhiteSpace( trace.GameObject.Name ) ? GameLocalization.Phrase( "ui.props.prop", "Prop" ) : trace.GameObject.Name;
		LookedPropOwnerName = GetOwnerName( prop.PlayerOwner );
		LookedPropIsFadingDoor = trace.GameObject.Components.Get<global::FadingDoor>( FindMode.EverythingInSelfAndAncestors ).IsValid();
		LookedPropIsTextscreen = trace.GameObject.Components.Get<global::Textscreen>( FindMode.EverythingInSelfAndAncestors ).IsValid();
	}

	private static string GetOwnerName( Player owner )
	{
		if ( !owner.IsValid() )
			return GameLocalization.Phrase( "common.unknown", "Unknown" );

		var displayName = owner.GameObject.Network.Owner?.DisplayName;
		if ( !string.IsNullOrWhiteSpace( displayName ) )
			return displayName;

		return string.IsNullOrWhiteSpace( owner.GameObject.Name ) ? GameLocalization.Phrase( "common.unknown", "Unknown" ) : owner.GameObject.Name;
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( IsOpen );
		hash.Add( UiModalManager.Version );
		hash.Add( GameLocalization.CurrentCode );
		hash.Add( ToolgunClientState.SelectedToolId );
		hash.Add( ToolgunClientState.Version );
		hash.Add( AvailableProps.Count );
		hash.Add( AvailableCategories.Count );
		hash.Add( SelectedCategory );
		hash.Add( SelectedFavoritesOnly );
		hash.Add( SearchText );
		hash.Add( FavoritePropIds.Count );
		hash.Add( PropsVersion );
		hash.Add( Player.Local?.OwnedPropsCount ?? 0 );
		hash.Add( Player.Local?.MaxProps ?? 0 );
		hash.Add( LookedPropName );
		hash.Add( LookedPropOwnerName );
		hash.Add( LookedPropIsFadingDoor );
		hash.Add( LookedPropIsTextscreen );

		foreach ( var favoriteId in FavoritePropIds.OrderBy( id => id, StringComparer.Ordinal ) )
		{
			hash.Add( favoriteId );
		}

		foreach ( var prop in AvailableProps )
		{
			hash.Add( prop.Id );
			hash.Add( prop.Header );
			hash.Add( prop.Category );
			hash.Add( prop.Description );
			hash.Add( prop.Ident );
			hash.Add( GetThumbUrl( prop ) );
		}

		return hash.ToHashCode();
	}
}
