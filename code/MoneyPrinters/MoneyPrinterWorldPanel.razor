@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Globalization;
@inherits PanelComponent
@namespace Sandbox

<root>
	<div class="printer-panel">
		<div class="header">@PrinterName</div>

		<div class="body">
			<div class="rate-label">@GameLocalization.Phrase( "ui.printer.rate" )</div>
			<div class="rate-value">@RateText</div>

			<div class="money-card">
				<div class="money-label">@GameLocalization.Phrase( "ui.printer.stored" )</div>
				<div class="money">@MoneyText</div>
			</div>

			<div class="rate-label">@GameLocalization.Phrase( "ui.printer.health" )</div>
			<div class="rate-value">@HealthText</div>

			@if ( IsFull )
			{
				<div class="status full">@GameLocalization.Phrase( "ui.printer.full" )</div>
			}
		</div>

		<div class="footer">@GameLocalization.Phrase( "ui.common.press_e" )</div>
	</div>
</root>

@code
{
	MoneyPrinterBase Printer => Components.Get<MoneyPrinterBase>( FindMode.EverythingInSelfAndAncestors );

	string PrinterName => string.IsNullOrWhiteSpace( Printer?.PrinterName ) ? GameLocalization.Phrase( "shop.money_printer1.header", "Money Printer" ) : Printer.PrinterName;

	int StoredMoney => Math.Max( 0, Printer?.StoredMoney ?? 0 );
	int MaxMoney => Math.Max( 1, Printer?.MaxMoney ?? 1 );
	bool IsFull => Printer is not null && StoredMoney >= MaxMoney;

	float Health => MathF.Max( 0f, Printer?.Health ?? 0f );
	float MaxHealth => MathF.Max( 1f, Printer?.MaxHealth ?? 1f );
	string HealthText => $"{MathF.Ceiling( Health )} / {MathF.Ceiling( MaxHealth )}";

	float RatePerMinute => Printer is { TickInterval: > 0f } p
		? p.MoneyPerTick * (60f / p.TickInterval)
		: 0f;

	string RateText => IsFull
		? GameLocalization.Phrase( "ui.common.stopped", "Stopped" )
		: $"${RatePerMinute.ToString( "0", CultureInfo.InvariantCulture )}/min.";

	string MoneyText => $"${StoredMoney} / ${MaxMoney}";

	string FooterText
	{
		get
		{
			if ( Printer is null )
				return GameLocalization.Phrase( "ui.printer.no_signal", "No Signal" );

			if ( IsFull )
				return GameLocalization.Phrase( "ui.printer.limit_reached", "Limit reached" );

			if ( !Printer.IsWorking )
				return GameLocalization.Phrase( "ui.common.stopped", "Stopped" );

			if ( Printer.Lifetime <= 0f )
				return GameLocalization.Phrase( "ui.printer.unlimited", "Unlimited" );

			return $"{MathF.Ceiling( Printer.TimeLeft )}s left";
		}
	}

	protected override int BuildHash() => HashCode.Combine(
		PrinterName,
		StoredMoney,
		MaxMoney,
		IsFull,
		RatePerMinute,
		FooterText,
		HealthText,
		GameLocalization.CurrentCode );
}
