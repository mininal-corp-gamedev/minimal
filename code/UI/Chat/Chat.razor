@using Sandbox
@using Sandbox.UI
@using System
@using System.Collections.Generic
@using System.Linq
@inherits PanelComponent
@namespace Sandbox

<root class="@(IsChatOpen ? "chat-open" : "chat-closed")">
	<div class="chat-panel @(IsChatOpen ? "chat-panel-open" : "chat-panel-closed")">
		<div class="message-area">
			<div class="message-list" @ref="MessageListRef">
				@foreach ( var message in VisibleMessages )
				{
					<div class="chat-message @(message.IsSystem ? "system-message" : "player-message") @GetMessageTypeClass( message )">
						<div class="message-row">
							@if ( message.Type == ChatMessageType.Ooc )
							{
								<span class="ooc-badge">OOC</span>
							}
							@if ( message.Type != ChatMessageType.Me )
							{
								<span class="message-sender">@GetSenderLabel( message )@GetSenderSeparator( message )</span>
							}
							<span class="message-text">@message.Text</span>
							<span class="message-time">@message.SentAt.ToString( "HH:mm" )</span>
						</div>
					</div>
				}
			</div>
			<div class="scrollbar-placeholder"></div>
		</div>

		@if ( IsChatOpen )
		{
			<div class="chat-input-row">
				<TextEntry @ref="ChatInputRef" class="chat-input" Value:bind="@PendingText" Placeholder="@GameLocalization.Phrase( "ui.chat.placeholder", "Type message..." )" onsubmit="@OnInputSubmit" />
				<button class="send-button" @onclick="OnSendButtonPressed">&gt;&gt;</button>
			</div>
		}
	</div>
</root>

@code
{
	public static Chat Instance { get; private set; }

	[Property] public float ClosedMessageLifetime { get; set; } = 3f;
	[Property] public int MaxMessageLength { get; set; } = 160;
	[Property] public float SendCooldownSeconds { get; set; } = 0.25f;
	[Property] public int MaxStoredMessages { get; set; } = 200;
	[Property] public float MessageRadius { get; set; } = 400f;

	private readonly List<ChatMessage> Messages = new();
	private readonly Dictionary<ulong, double> HostNextAllowedSendAt = new();

	private bool IsChatOpen;
	private bool WasChatOpenLastFrame;
	private string PendingText = "";
	private double LocalNextAllowedSendAt;
	private bool NeedsInputFocus;
	private bool NeedsScrollToBottom;
	private int KeepScrollSnappedFrames;
	private float LastObservedScrollSizeY;
	private TextEntry ChatInputRef;
	private Panel MessageListRef;

	private IEnumerable<ChatMessage> VisibleMessages =>
		IsChatOpen
			? Messages
			: Messages.Where( x => Time.Now - x.CreatedAtSeconds <= ClosedMessageLifetime );

	public void AddLocalSystemMessage( string text )
	{
		var normalized = NormalizeText( text );
		if ( normalized.Length <= 0 )
			return;

		AddMessage( ChatMessage.CreateSystem( normalized ) );
	}

	public void AddLocalMessageFromPlayer( Player sender, string text )
	{
		if ( !sender.IsValid() )
			return;

		var normalized = NormalizeText( text );
		if ( normalized.Length <= 0 )
			return;

		var connection = sender.Network?.Owner;
		var steamId = connection != null ? connection.SteamId : (ulong?)null;
		var name = connection?.DisplayName ?? "Player";

		AddMessage( ChatMessage.CreatePlayer( name, steamId, normalized ) );
	}

	public void AddLocalMessageFromOtherPlayer( string displayName, ulong steamId, string text )
	{
		var normalized = NormalizeText( text );
		if ( normalized.Length <= 0 )
			return;

		AddMessage( ChatMessage.CreatePlayer( displayName, steamId, normalized ) );
	}

	private static string NormalizeText( string text )
	{
		return (text ?? string.Empty).Trim();
	}

	private void AddMessage( ChatMessage message )
	{
		Messages.Add( message );
		NeedsScrollToBottom = true;

		if ( Messages.Count > MaxStoredMessages )
			Messages.RemoveAt( 0 );
	}

	private void OpenChat()
	{
		IsChatOpen = true;
		NeedsInputFocus = true;
		NeedsScrollToBottom = true;
		KeepScrollSnappedFrames = 32;
		LastObservedScrollSizeY = 0f;
		StateHasChanged();
	}

	private void CloseChat()
	{
		IsChatOpen = false;
		PendingText = string.Empty;
		NeedsInputFocus = false;
		NeedsScrollToBottom = true;
		KeepScrollSnappedFrames = 0;
		LastObservedScrollSizeY = 0f;
	}

	private string GetSenderLabel( ChatMessage message )
	{
		return message.SenderName;
	}

	private static string GetSenderSeparator( ChatMessage message )
	{
		return ":";
	}

	private static string GetMessageTypeClass( ChatMessage message ) => message.Type switch
	{
		ChatMessageType.Ooc => "ooc-message",
		ChatMessageType.Me => "me-message",
		ChatMessageType.Roll => "roll-message",
		ChatMessageType.Report => "report-message",
		_ => ""
	};

	private void SubmitOrClose()
	{
		var normalized = NormalizeText( PendingText );

		if ( normalized.Length <= 0 )
		{
			CloseChat();
			return;
		}

		if ( !PassLocalValidation( normalized ) )
		{
			CloseChat();
			return;
		}

		SendChatToHost( normalized );
		CloseChat();
	}

	private bool PassLocalValidation( string message )
	{
		if ( message.Length <= 0 || message.Length > MaxMessageLength )
			return false;

		if ( Time.Now < LocalNextAllowedSendAt )
			return false;

		LocalNextAllowedSendAt = Time.Now + SendCooldownSeconds;
		return true;
	}

	private void OnSendButtonPressed()
	{
		SubmitOrClose();
	}

	private void OnInputSubmit()
	{
		SubmitOrClose();
	}

	[Rpc.Host]
	private void SendChatToHost( string message )
	{
		var caller = Rpc.Caller;
		if ( caller is null )
			return;

		if ( !PassHostValidation( caller, message, out var normalized ) )
			return;

		var sender = FindPlayerBySteamId( caller.SteamId.Value );
		if ( !sender.IsValid() )
			return;

		if ( normalized.StartsWith( "/" ) )
			HandleHostCommand( caller, sender, normalized );
		else
			SendLocalMessage( caller, sender, normalized, ChatMessageType.Local );
	}

	[Rpc.Broadcast]
	private void BroadcastChatMessage( string senderName, long steamId, string message, ChatMessageType type )
	{
		if ( type == ChatMessageType.System )
		{
			AddMessage( ChatMessage.CreateSystem( message ) );
			return;
		}

		var safeSteamId = steamId > 0 ? (ulong?)steamId : null;
		AddMessage( ChatMessage.CreatePlayer( senderName, safeSteamId, message, type ) );
	}

	private void HandleHostCommand( Connection caller, Player sender, string message )
	{
		var commandLine = message[1..].TrimStart();
		if ( commandLine.Length <= 0 )
			return;

		if ( commandLine.StartsWith( "/" ) )
		{
			SendGlobalMessage( caller, commandLine[1..].Trim(), ChatMessageType.Ooc );
			return;
		}

		var parts = commandLine.Split( ' ', 2, StringSplitOptions.RemoveEmptyEntries );
		var command = parts.Length > 0 ? parts[0].ToLowerInvariant() : "";
		var args = parts.Length > 1 ? parts[1].Trim() : "";

		switch ( command )
		{
			case "ooc":
				SendGlobalMessage( caller, args, ChatMessageType.Ooc );
				break;
			case "me":
				if ( args.Length <= 0 )
					return;

				SendLocalMessage( caller, sender, $"{caller.DisplayName} {args}", ChatMessageType.Me );
				break;
			case "roll":
				var roll = Game.Random.Int( 0, 100 );
				SendLocalMessage( caller, sender, $"rolls {roll}/100", ChatMessageType.Roll );
				break;
			case "report":
				SendReportMessage( caller, args );
				break;
			default:
				SendToCaller( caller, GameLocalization.Phrase( "notify.chat.unknown_command", "Unknown command." ), ChatMessageType.System );
				break;
		}
	}

	private void SendGlobalMessage( Connection caller, string message, ChatMessageType type )
	{
		var normalized = NormalizeText( message );
		if ( normalized.Length <= 0 )
			return;

		BroadcastChatMessage( caller.DisplayName, caller.SteamId.Value, normalized, type );
	}

	private void SendLocalMessage( Connection caller, Player sender, string message, ChatMessageType type )
	{
		var normalized = NormalizeText( message );
		if ( normalized.Length <= 0 )
			return;

		var recipients = GetPlayersInMessageRadius( sender )
			.Select( x => x.GameObject.Network.Owner?.SteamId.Value ?? 0L )
			.Where( x => x > 0L )
			.ToHashSet();

		using ( Rpc.FilterInclude( connection => recipients.Contains( connection.SteamId.Value ) ) )
		{
			BroadcastChatMessage( caller.DisplayName, caller.SteamId.Value, normalized, type );
		}
	}

	private void SendReportMessage( Connection caller, string reason )
	{
		var text = GameLocalization.Format( "notify.chat.report_called", "SteamId {0} ({1}) called for help.", caller.SteamId.Value, caller.DisplayName );
		var normalizedReason = NormalizeText( reason );
		if ( normalizedReason.Length > 0 )
			text += GameLocalization.Format( "notify.chat.report_reason", " Reason: {0}", normalizedReason );

		var recipients = GetAllPlayers()
			.Where( x => x.AdminRank > 0 )
			.Select( x => x.GameObject.Network.Owner?.SteamId.Value ?? 0L )
			.Where( x => x > 0L )
			.ToHashSet();

		using ( Rpc.FilterInclude( connection => recipients.Contains( connection.SteamId.Value ) ) )
		{
		BroadcastChatMessage( GameLocalization.Phrase( "ui.chat.report", "Report" ), caller.SteamId.Value, text, ChatMessageType.Report );
		}

		SendToCaller( caller, GameLocalization.Phrase( "notify.chat.report_sent", "Report sent." ), ChatMessageType.System );
	}

	private void SendToCaller( Connection caller, string message, ChatMessageType type )
	{
		using ( Rpc.FilterInclude( connection => connection.SteamId == caller.SteamId ) )
		{
			BroadcastChatMessage( GameLocalization.Phrase( "ui.chat.system", "System" ), 0L, message, type );
		}
	}

	private IEnumerable<Player> GetPlayersInMessageRadius( Player sender )
	{
		var radius = MathF.Max( 1f, MessageRadius );
		foreach ( var player in GetAllPlayers() )
		{
			if ( !player.IsValid() || player.GameObject.Network.Owner is null )
				continue;

			if ( Vector3.DistanceBetween( sender.WorldPosition, player.WorldPosition ) <= radius )
				yield return player;
		}
	}

	private static IEnumerable<Player> GetAllPlayers()
	{
		var scene = Game.ActiveScene;
		if ( scene is null )
			yield break;

		foreach ( var player in scene.GetAllComponents<Player>() )
			yield return player;
	}

	private static Player FindPlayerBySteamId( long steamId )
	{
		foreach ( var player in GetAllPlayers() )
		{
			if ( player.GameObject.Network.Owner?.SteamId.Value == steamId )
				return player;
		}

		return null;
	}

	private bool PassHostValidation( Connection caller, string message, out string normalized )
	{
		normalized = NormalizeText( message );

		if ( normalized.Length <= 0 || normalized.Length > MaxMessageLength )
			return false;

		var steamId = caller.SteamId;
		if ( HostNextAllowedSendAt.TryGetValue( steamId, out var nextAllowedAt ) && Time.Now < nextAllowedAt )
			return false;

		HostNextAllowedSendAt[steamId] = Time.Now + SendCooldownSeconds;
		return true;
	}

	private void SnapScrollToBottom()
	{
		if ( !MessageListRef.IsValid() )
			return;

		MessageListRef.ScrollVelocity = Vector2.Zero;
		MessageListRef.ScrollOffset = MessageListRef.ScrollSize;
		MessageListRef.TryScrollToBottom();
	}

	protected override void OnStart()
	{
		Instance = this;
	}

	protected override void OnFixedUpdate()
	{
		if ( Input.Pressed( "Chat" ) )
		{
			if ( IsChatOpen )
				SubmitOrClose();
			else
				OpenChat();
		}

		if ( IsChatOpen && !WasChatOpenLastFrame )
		{
			NeedsScrollToBottom = true;
			KeepScrollSnappedFrames = Math.Max( KeepScrollSnappedFrames, 32 );
			LastObservedScrollSizeY = 0f;
			StateHasChanged();
		}

		if ( IsChatOpen && Input.EscapePressed )
		{
			CloseChat();
		}

		if ( IsChatOpen && NeedsInputFocus && ChatInputRef.IsValid() )
		{
			ChatInputRef.Focus();
			NeedsInputFocus = false;
			NeedsScrollToBottom = true;
			KeepScrollSnappedFrames = Math.Max( KeepScrollSnappedFrames, 32 );
			StateHasChanged();
		}

		WasChatOpenLastFrame = IsChatOpen;
	}

	protected override void OnUpdate()
	{
		if ( IsChatOpen && MessageListRef.IsValid() )
		{
			var currentScrollSizeY = MessageListRef.ScrollSize.y;
			if ( currentScrollSizeY > LastObservedScrollSizeY + 0.5f )
				KeepScrollSnappedFrames = Math.Max( KeepScrollSnappedFrames, 12 );

			LastObservedScrollSizeY = currentScrollSizeY;
		}

		if ( NeedsScrollToBottom && MessageListRef.IsValid() )
		{
			StateHasChanged();
			SnapScrollToBottom();
			NeedsScrollToBottom = false;
		}

		if ( IsChatOpen && KeepScrollSnappedFrames > 0 && MessageListRef.IsValid() )
		{
			StateHasChanged();
			SnapScrollToBottom();
			KeepScrollSnappedFrames--;
		}
	}

	protected override void OnDestroy()
	{
		if ( Instance == this )
			Instance = null;
	}

	protected override int BuildHash()
	{
		return HashCode.Combine(
			IsChatOpen,
			PendingText,
			GameLocalization.CurrentCode,
			Messages.Count,
			Messages.Count > 0 ? Messages[^1].BuildHash() : 0,
			VisibleMessages.Count()
		);
	}
}
