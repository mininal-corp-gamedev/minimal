@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Collections.Generic;
@using System.Linq;
@using Minimal.Shop;
@using Ambi.Storage;
@inherits PanelComponent
@namespace Sandbox

<root>
	@if ( IsOpen )
	{
		<div class="overlay">
			<div class="tm-panel">

				<div class="sidebar">
					<div class="sidebar-profile">
						<div class="sb-name">@(Connection.Local?.DisplayName ?? "—")</div>
						<div class="sb-job">@(Player.Local?.Job?.JobDefinition?.Header ?? "No Job")</div>
						<div class="sb-money">$@(Player.Local?.Money ?? 0)</div>
					</div>
					<div class="sidebar-nav">
						<button class="tab-btn @(ActiveTab == 0 ? "active" : "")" onclick=@(() => ActiveTab = 0)>Jobs</button>
						<button class="tab-btn @(ActiveTab == 1 ? "active" : "")" onclick=@(() => ActiveTab = 1)>Shop</button>
						<button class="tab-btn @(ActiveTab == 2 ? "active" : "")" onclick=@(() => SelectPlayersTab())>Players</button>
						<button class="tab-btn @(ActiveTab == 3 ? "active" : "")" onclick=@(() => ActiveTab = 3)>Help</button>
					</div>
					<div class="sidebar-spacer"></div>
					<div class="sidebar-bottom">
						<button class="bottom-btn">Rules</button>
						<button class="bottom-btn">Donate</button>
						<button class="bottom-btn">Discord</button>
					</div>
				</div>

				<div class="content-area">

					@if ( ActiveTab == 0 )
					{
						<div class="page">
							<div class="page-title">Jobs</div>
							<div class="jobs-grid">
								@foreach ( var job in AvailableJobs )
								{
									var count = GetJobPlayersCount( job.Id );
									var isLimited = job.MaxCount > 0;
									var atLimit = isLimited && count >= job.MaxCount;
									var isCurrent = string.Equals( Player.Local?.Job?.JobId, job.Id, StringComparison.Ordinal );
									var isArrested = Player.Local?.IsArrested == true;
									var shortDescription = GetShortDescription( job.Description );

									<div class="job-card @(isCurrent ? "current" : "")">
										<div class="job-head">
											<div class="job-title">@job.Header</div>
											<div class="job-limit">@(isLimited ? $"{count}/{job.MaxCount}" : "No limit")</div>
										</div>
										<div class="job-description">@shortDescription</div>
										<button
											class="job-take-btn"
											disabled=@(isCurrent || atLimit || isArrested)
											onclick=@(() => RequestJoinJob( job.Id ))>
											@(isCurrent ? "Current" : (isArrested ? "Arrested" : "Take"))
										</button>
									</div>
								}
							</div>
						</div>
					}
					else if ( ActiveTab == 1 )
					{
						<div class="page">
							<div class="page-title">Shop</div>
							<div class="shop-grid">
								@foreach ( var shop in VisibleShopItems )
								{
									var canAfford = (Player.Local?.Money ?? 0) >= shop.Price;
									var canFitItem = CanFitShopItem( shop );
									var hasPurchaseAction = HasShopPurchaseAction( shop );
									var disabled = !canAfford || !canFitItem || !hasPurchaseAction;
									var shortDescription = GetShortDescription( shop.Description );
									var status = GetShopStatus( shop, canAfford, canFitItem, hasPurchaseAction );

									<div class="shop-card @(disabled ? "locked" : "")">
										<div class="shop-card-main">
											<div class="shop-icon" style="@(GetShopIconStyle( shop ))"></div>
											<div class="shop-info">
												<div class="shop-head">
													<div class="shop-title">@shop.Header</div>
													<div class="shop-price">$@shop.Price</div>
												</div>
												<div class="shop-category">@shop.Category</div>
												<div class="shop-description">@shortDescription</div>
											</div>
										</div>
										<div class="shop-actions">
											<div class="shop-status @(disabled ? "bad" : "good")">@status</div>
											<button
												class="shop-buy-btn"
												disabled=@disabled
												onclick=@(() => RequestPurchase( shop ))>
												Buy
											</button>
										</div>
									</div>
								}
							</div>
						</div>
					}
					else if ( ActiveTab == 2 )
					{
						<div class="page">
							<div class="page-title">Players</div>
							<div class="players-count">Online: @CachedPlayers.Count</div>
							<div class="player-list">
								@foreach ( var conn in CachedPlayers )
								{
									var jobName = GetPlayerJobName( conn );

									<div class="player-row">
										<div class="player-avatar" style="background-image: url( avatar:@conn.SteamId.Value )"></div>
										<div class="player-info">
											<div class="player-name">@conn.DisplayName</div>
											<div class="player-job">@jobName</div>
										</div>
										<div class="player-ping">@conn.Ping ms</div>
									</div>
								}
							</div>
						</div>
					}
					else if ( ActiveTab == 3 )
					{
						<div class="page">
							<div class="page-title">Help</div>
							<div class="help-list">
								<div class="help-row"><div class="help-key">Tab</div><div class="help-desc">Open / Close this menu</div></div>
								<div class="help-row"><div class="help-key">WASD</div><div class="help-desc">Movement</div></div>
								<div class="help-row"><div class="help-key">Space</div><div class="help-desc">Jump</div></div>
								<div class="help-row"><div class="help-key">F</div><div class="help-desc">Interact</div></div>
								<div class="help-row"><div class="help-key">1 – 9</div><div class="help-desc">Use hotbar item</div></div>
								<div class="help-row"><div class="help-key">Enter</div><div class="help-desc">Open chat</div></div>
							</div>
						</div>
					}

				</div>
			</div>
		</div>
	}
</root>

@code
{
	bool IsOpen { get; set; } = false;
	int ActiveTab { get; set; } = 0;
	List<Connection> CachedPlayers { get; set; } = new();
	List<JobDefinition> AvailableJobs { get; set; } = new();
	List<ShopDefinition> AvailableShopItems { get; set; } = new();
	IEnumerable<ShopDefinition> VisibleShopItems => AvailableShopItems.Where( IsShopAllowed );
	int PlayersVersion { get; set; } = 0;
	int JobsVersion { get; set; } = 0;
	int ShopVersion { get; set; } = 0;

	void SelectPlayersTab()
	{
		ActiveTab = 2;
		CachedPlayers = Connection.All.ToList();
		PlayersVersion++;
	}

	private void LoadJobs()
	{
		AvailableJobs = ResourceLibrary
			.GetAll<JobDefinition>()
			.OrderBy( x => x.Category )
			.ThenBy( x => x.Header )
			.ToList();

		JobsVersion++;
	}

	private void LoadShop()
	{
		AvailableShopItems = ResourceLibrary
			.GetAll<ShopDefinition>()
			.OrderBy( x => x.Category )
			.ThenBy( x => x.Header )
			.ToList();

		ShopVersion++;
	}

	private static string GetShortDescription( string description )
	{
		var text = (description ?? string.Empty).Trim();
		if ( text.Length <= 0 )
			return "No description";

		const int maxLen = 110;
		return text.Length <= maxLen ? text : $"{text[..maxLen]}...";
	}

	private int GetJobPlayersCount( string jobId )
	{
		var scene = Game.ActiveScene;
		if ( scene is null || string.IsNullOrWhiteSpace( jobId ) )
			return 0;

		var count = 0;
		foreach ( var player in scene.GetAllComponents<Player>() )
		{
			if ( string.Equals( player?.Job?.JobId, jobId, StringComparison.Ordinal ) )
				count++;
		}

		return count;
	}

	private int GetJobsPopulationHash()
	{
		var hash = 17;
		foreach ( var job in AvailableJobs )
		{
			hash = HashCode.Combine( hash, job.Id, GetJobPlayersCount( job.Id ) );
		}

		return hash;
	}

	private string GetPlayerJobName( Connection connection )
	{
		if ( connection is null )
			return "No Job";

		return FindPlayerBySteamId( connection.SteamId.Value )?.Job?.JobDefinition?.Header ?? "No Job";
	}

	private int GetPlayersJobHash()
	{
		var hash = 17;
		foreach ( var connection in CachedPlayers )
		{
			hash = HashCode.Combine( hash, connection.SteamId.Value, GetPlayerJobName( connection ) );
		}

		return hash;
	}

	private void RequestJoinJob( string jobId )
	{
		var normalized = (jobId ?? string.Empty).Trim();
		if ( normalized.Length <= 0 )
			return;

		RpcRequestJoinJob( normalized );
	}

	private bool IsShopAllowed( ShopDefinition shop )
	{
		if ( shop is null )
			return false;

		if ( shop.IsAllowEveryone )
			return true;

		var localJob = Player.Local?.Job?.JobDefinition;
		if ( localJob is null || shop.JobsAllow is null || shop.JobsAllow.Count == 0 )
			return false;

		return shop.JobsAllow.Any( x => x is not null && string.Equals( x.Id, localJob.Id, StringComparison.Ordinal ) );
	}

	private bool CanFitShopItem( ShopDefinition shop )
	{
		var itemId = shop?.ItemDefinition?.Id;
		if ( string.IsNullOrWhiteSpace( itemId ) )
			return true;

		return Player.Local?.Inventory?.CanAddItem( itemId, 1 ) ?? false;
	}

	private bool HasShopPurchaseAction( ShopDefinition shop )
	{
		return shop is not null && (shop.ItemDefinition is not null || shop.HasPostPurchased);
	}

	private string GetShopStatus( ShopDefinition shop, bool canAfford, bool canFitItem, bool hasPurchaseAction )
	{
		if ( !canAfford )
			return "Not enough money";

		if ( !canFitItem )
			return "Inventory full";

		if ( !hasPurchaseAction )
			return "Unavailable";

		if ( shop?.HasPostPurchased == true && shop.ItemDefinition is null )
			return "Spawns in world";

		return "Available";
	}

	private string GetShopIconStyle( ShopDefinition shop )
	{
		var icon = string.IsNullOrWhiteSpace( shop?.IconPath ) ? "icons/items/default.vtex" : shop.IconPath;
		return $"background-image: url({icon})";
	}

	private int GetInventoryHash()
	{
		var inventory = Player.Local?.Inventory;
		if ( inventory is null )
			return 0;

		var hash = 17;
		foreach ( var slot in inventory.Slots )
		{
			hash = HashCode.Combine( hash, slot.Item?.Id, slot.Item?.Count ?? 0 );
		}

		return hash;
	}

	private void RequestPurchase( ShopDefinition shop )
	{
		var normalized = (shop?.Id ?? string.Empty).Trim();
		if ( normalized.Length <= 0 )
			return;

		if ( !IsShopAllowed( shop ) )
		{
			Notification.Error( "Your job cannot buy this.", 3.5f );
			return;
		}

		if ( (Player.Local?.Money ?? 0) < shop.Price )
		{
			Notification.Error( $"Need ${shop.Price}.", 3.5f );
			return;
		}

		if ( !CanFitShopItem( shop ) )
		{
			Notification.Error( "Inventory is full.", 3.5f );
			return;
		}

		if ( !HasShopPurchaseAction( shop ) )
		{
			Notification.Error( "Shop item is unavailable.", 3.5f );
			return;
		}

		ShopManager.RpcRequestPurchase( normalized );
	}

	[Rpc.Host]
	private static void RpcRequestJoinJob( string jobId )
	{
		var caller = Rpc.Caller;
		if ( caller is null )
			return;

		var normalized = (jobId ?? string.Empty).Trim();
		if ( string.IsNullOrEmpty( normalized ) )
		{
			NotifyCaller( caller, "Job id is empty.", false );
			return;
		}

		var jobDefinition = JobDatabase.Get( normalized );
		if ( jobDefinition is null )
		{
			NotifyCaller( caller, "Job not found.", false );
			return;
		}

		var callerPlayer = FindPlayerBySteamId( caller.SteamId.Value );
		if ( !callerPlayer.IsValid() || !callerPlayer.Job.IsValid() )
		{
			NotifyCaller( caller, "Your player is not ready.", false );
			return;
		}

		if ( callerPlayer.IsArrested )
		{
			NotifyCaller( caller, "You are arrested.", false );
			return;
		}

		if ( string.Equals( callerPlayer.Job.JobId, normalized, StringComparison.Ordinal ) )
		{
			NotifyCaller( caller, "You already have this job.", true );
			return;
		}

		if ( jobDefinition.MaxCount > 0 )
		{
			var usedSlots = 0;
			var scene = Game.ActiveScene;
			if ( scene is not null )
			{
				foreach ( var player in scene.GetAllComponents<Player>() )
				{
					if ( string.Equals( player?.Job?.JobId, normalized, StringComparison.Ordinal ) )
						usedSlots++;
				}
			}

			if ( usedSlots >= jobDefinition.MaxCount )
			{
				NotifyCaller( caller, $"No free slots for {jobDefinition.Header}.", false );
				return;
			}
		}

		callerPlayer.Job.SetJob( normalized );
		NotifyCaller( caller, $"You joined: {jobDefinition.Header}.", true );
	}

	private static Player FindPlayerBySteamId( long steamId )
	{
		var scene = Game.ActiveScene;
		if ( scene is null )
			return null;

		foreach ( var player in scene.GetAllComponents<Player>() )
		{
			if ( player.GameObject.Network.Owner?.SteamId.Value == steamId )
				return player;
		}

		return null;
	}

	private static void NotifyCaller( Connection caller, string text, bool success )
	{
		using ( Rpc.FilterInclude( x => x.SteamId.Value == caller.SteamId.Value ) )
		{
			RpcReceiveJoinJobResult( text, success );
		}
	}

	[Rpc.Broadcast]
	private static void RpcReceiveJoinJobResult( string text, bool success )
	{
		if ( success )
			Notification.Info( text, 3.5f );
		else
			Notification.Error( text, 3.5f );
	}

	protected override void OnStart()
	{
		LoadJobs();
		LoadShop();
	}

	private void SetOpen( bool open )
	{
		IsOpen = open;

		var crosshair = Scene.GetAllComponents<Crosshair>().FirstOrDefault();
		if ( crosshair is not null )
			crosshair.SetVisible( !IsOpen );
	}

		protected override void OnUpdate()
	{
		if ( Input.Pressed( "Score" ) )
			SetOpen( !IsOpen );

#pragma warning disable CS0612
	Mouse.Visible = IsOpen;
#pragma warning restore CS0612
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( IsOpen );
		hash.Add( ActiveTab );
		hash.Add( Player.Local?.Money ?? 0 );
		hash.Add( Player.Local?.Job?.JobId );
		hash.Add( Player.Local?.Job?.JobDefinition?.Header );
		hash.Add( GetInventoryHash() );
		hash.Add( Connection.Local?.DisplayName );
		hash.Add( Connection.All.Count );
		hash.Add( GetJobsPopulationHash() );
		hash.Add( GetPlayersJobHash() );
		hash.Add( AvailableJobs.Count );
		hash.Add( AvailableShopItems.Count );
		hash.Add( VisibleShopItems.Count() );
		hash.Add( JobsVersion );
		hash.Add( ShopVersion );
		hash.Add( PlayersVersion );
		return hash.ToHashCode();
	}
}
