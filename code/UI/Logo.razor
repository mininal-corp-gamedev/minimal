@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent
@namespace Sandbox

<root>
	@if ( Player.Local?.IsDead != true )
	{
		<div class="logo" style="background-image: url('@LogoPath');"></div>
	}
</root>

@code
{
	[Property] public string LogoPath { get; set; } = "textures/logo_1024_512.vtex";

	protected override int BuildHash() => System.HashCode.Combine( LogoPath, Player.Local?.IsDead ?? false );
}
