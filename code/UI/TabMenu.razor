@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Collections.Generic;
@using System.Globalization;
@using System.Linq;
@using Minimal.Shop;
@using Ambi.Storage;
@using Minimal.Clan;
@inherits PanelComponent
@namespace Sandbox

<root>
	@if ( IsDiscordOpening )
	{
		<WebPanel class="discord-webpanel" Url="https://discord.gg/azPnN8F7xQ" />
	}
	@if ( IsOpen && UiModalManager.IsActive( ModalId ) )
	{
		<div class="overlay">
			<div class="tm-panel">

				<div class="sidebar">
					<div class="sidebar-profile">
						<div class="sb-name">@(Connection.Local?.DisplayName ?? "-")</div>
						<div class="sb-job">@GetLocalJobName()</div>
						<div class="sb-money">$@(Player.Local?.Money ?? 0)</div>
					</div>
					<div class="sidebar-nav">
						<button class="tab-btn @(ActiveTab == 0 ? "active" : "")" onclick=@(() => SelectJobsTab())>@GameLocalization.Phrase( "ui.tab.jobs" )</button>
						<button class="tab-btn @(ActiveTab == 1 ? "active" : "")" onclick=@SelectShopTab>@GameLocalization.Phrase( "ui.tab.shop" )</button>
						<button class="tab-btn @(ActiveTab == 2 ? "active" : "")" onclick=@(() => SelectPlayersTab())>@GameLocalization.Phrase( "ui.tab.players" )</button>
						<button class="tab-btn @(ActiveTab == 3 ? "active" : "")" onclick=@(() => SelectClanTab())>Clan</button>
						<button class="tab-btn @(ActiveTab == 4 ? "active" : "")" onclick=@SelectHelpTab>@GameLocalization.Phrase( "ui.tab.help" )</button>
					</div>
					<div class="sidebar-spacer"></div>
					<div class="sidebar-bottom">
						<button class="bottom-btn">@GameLocalization.Phrase( "ui.sidebar.rules" )</button>
						<button class="bottom-btn">@GameLocalization.Phrase( "ui.sidebar.donate" )</button>
						<button class="bottom-btn" onclick=@OpenDiscord>Discord</button>
						<div class="language-switcher">
							<button class="language-btn @(IsLanguage( GameLocalization.EnglishCode ) ? "active" : "")" onmousedown=@(() => SetLanguage( GameLocalization.EnglishCode )) onclick=@(() => SetLanguage( GameLocalization.EnglishCode ))>EN</button>
							<button class="language-btn @(IsLanguage( GameLocalization.RussianCode ) ? "active" : "")" onmousedown=@(() => SetLanguage( GameLocalization.RussianCode )) onclick=@(() => SetLanguage( GameLocalization.RussianCode ))>RU</button>
						</div>
					</div>
				</div>

				<div class="content-area">

					@if ( ActiveTab == 0 )
					{
						<div class="page">
							<div class="page-title">@GameLocalization.Phrase( "ui.tab.jobs" )</div>
							<div class="jobs-grid">
								@foreach ( var job in VisibleJobs )
								{
									var count = GetJobPlayersCount( job.Id );
									var isLimited = job.MaxCount > 0;
									var atLimit = isLimited && count >= job.MaxCount;
									var isCurrent = string.Equals( Player.Local?.Job?.JobId, job.Id, StringComparison.Ordinal );
									var isArrested = Player.Local?.IsArrested == true;
									var jobHeader = GameLocalization.JobHeader( job );
									var shortDescription = GetShortDescription( GameLocalization.JobDescription( job ) );

									<div class="job-card @(isCurrent ? "current" : "")">
										<div class="job-head">
											<div class="job-title">@jobHeader</div>
											<div class="job-limit">@(isLimited ? $"{count}/{job.MaxCount}" : GameLocalization.Phrase( "ui.jobs.no_limit", "No limit" ))</div>
										</div>
										<div class="job-description">@shortDescription</div>
										<button
											class="job-take-btn"
											disabled=@(isCurrent || atLimit || isArrested)
											onclick=@(() => RequestJoinJob( job.Id ))>
											@(isCurrent ? GameLocalization.Phrase( "ui.jobs.current", "Current" ) : (isArrested ? GameLocalization.Phrase( "ui.jobs.arrested", "Arrested" ) : GameLocalization.Phrase( "ui.jobs.take", "Take" )))
										</button>
									</div>
								}
							</div>
						</div>
					}
					else if ( ActiveTab == 1 )
					{
						<div class="page">
							<div class="page-title">@GameLocalization.Phrase( "ui.tab.shop" )</div>
							<div class="shop-grid">
								@foreach ( var shop in VisibleShopItems )
								{
									var canAfford = (Player.Local?.Money ?? 0) >= shop.Price;
									var canFitItem = CanFitShopItem( shop );
									var hasPurchaseAction = HasShopPurchaseAction( shop );
									var disabled = !canAfford || !canFitItem || !hasPurchaseAction;
									var shopHeader = GameLocalization.ShopHeader( shop );
									var shopCategory = GameLocalization.Category( shop.Category );
									var shortDescription = GetShortDescription( GameLocalization.ShopDescription( shop ) );
									var status = GetShopStatus( shop, canAfford, canFitItem, hasPurchaseAction );

									<div class="shop-card @(disabled ? "locked" : "")">
										<div class="shop-card-main">
											<div class="shop-icon" style="@(GetShopIconStyle( shop ))"></div>
											<div class="shop-info">
												<div class="shop-head">
													<div class="shop-title">@shopHeader</div>
													<div class="shop-price">$@shop.Price</div>
												</div>
												<div class="shop-category">@shopCategory</div>
												<div class="shop-description">@shortDescription</div>
											</div>
										</div>
										<div class="shop-actions">
											<div class="shop-status @(disabled ? "bad" : "good")">@status</div>
											<button
												class="shop-buy-btn"
												disabled=@disabled
												onclick=@(() => RequestPurchase( shop ))>
												@GameLocalization.Phrase( "ui.shop.buy" )
											</button>
										</div>
									</div>
								}
							</div>
						</div>
					}
					else if ( ActiveTab == 2 )
					{
						<div class="page">
							<div class="page-title">@GameLocalization.Phrase( "ui.tab.players" )</div>
							<div class="players-count">@GameLocalization.Format( "ui.players.online", "Online: {0}", CachedPlayers.Count )</div>
							<div class="player-list">
								@foreach ( var conn in CachedPlayers )
								{
									var jobName = GetPlayerJobName( conn );

									<div class="player-row">
										<div class="player-avatar" style="background-image: url( avatar:@conn.SteamId.Value )" onclick=@(() => Game.Overlay.ShowPlayer( conn.SteamId.Value, "" ))></div>
										<div class="player-info">
											<div class="player-name">@conn.DisplayName</div>
											<div class="player-job">@jobName</div>
										</div>
										<div class="player-ping">@conn.Ping ms</div>
									</div>
								}
							</div>
						</div>
					}
					else if ( ActiveTab == 3 )
					{
						var inviteClanId = ClanManager.Instance?.PendingInviteClanId ?? -1;
						var localClan = GetLocalClanSummary();
						var hasClan = (Player.Local?.ClanId ?? -1) >= 0;

						<div class="page clan-page">
							<div class="page-title">Clan</div>

							@if ( inviteClanId >= 0 )
							{
								<div class="clan-invite">
									<div class="clan-section-title">Invite</div>
									<div class="clan-muted">@(ClanManager.Instance?.PendingInviteInviterName ?? "") invited you to @(ClanManager.Instance?.PendingInviteClanHeader ?? "a clan").</div>
									<div class="clan-actions">
										<button class="clan-btn primary" onclick=@AcceptClanInvite>Accept</button>
										<button class="clan-btn" onclick=@DeclineClanInvite>Decline</button>
									</div>
								</div>
							}

							@if ( hasClan )
							{
								<div class="clan-layout">
									<div class="clan-main">
										<div class="clan-header-row">
											<div class="clan-logo-preview @GetClanLogoBackgroundClass( localClan.Logo )" style="@GetClanLogoStyle( localClan.Logo, localClan.ColorId )">
												@foreach ( var paneStyle in GetClanLogoPaneStyles( localClan.Logo ) )
												{
													<div class="clan-logo-pane" style="@paneStyle"></div>
												}
												@if ( !string.IsNullOrWhiteSpace( localClan.Logo?.IconPath ) )
												{
													<div class="clan-logo-icon" style="@GetClanIconStyle( localClan.Logo.IconPath, localClan.ColorId )"></div>
												}
											</div>
											<div class="clan-title-block">
												<div class="clan-title" style="color: @ColorCss( localClan.ColorId );">@localClan.Header</div>
												<div class="clan-muted">@GetRankName( Player.Local?.ClanRank ?? ClanRank.Soldier )</div>
												<div class="clan-description">@localClan.Description</div>
											</div>
										</div>

										<div class="clan-stats">
											<div class="clan-stat"><div class="clan-stat-label">Id</div><div class="clan-stat-value">#@localClan.Id</div></div>
											<div class="clan-stat"><div class="clan-stat-label">Balance</div><div class="clan-stat-value">$@localClan.Balance</div></div>
											<div class="clan-stat"><div class="clan-stat-label">Members</div><div class="clan-stat-value">@localClan.MemberCount</div></div>
											<div class="clan-stat"><div class="clan-stat-label">Kills</div><div class="clan-stat-value">@localClan.Kills</div></div>
											<div class="clan-stat"><div class="clan-stat-label">Leader</div><div class="clan-stat-value">@(localClan.LeaderOnline ? "Online" : "Offline")</div></div>
										</div>

										<div class="clan-meta">
											<div>Leader SteamID: @localClan.LeaderSteamId</div>
											<div>Leader last seen: @FormatClanDate( localClan.LeaderLastSeenRaw )</div>
										</div>

										<div class="clan-section-title">Online clanmates</div>
										<div class="clan-member-list">
											@foreach ( var member in localClan.OnlineMembers )
											{
												<div class="clan-member-row">
													<div class="clan-member-avatar" style="background-image: url( avatar:@member.SteamId )"></div>
													<div class="clan-member-info">
														<div class="clan-member-name">@member.Name</div>
														<div class="clan-muted">@GetRankName( member.Rank )</div>
													</div>
													@if ( CanManageClanMember( member ) )
													{
														<div class="clan-member-actions">
															<button class="clan-mini-btn" onclick=@(() => PromoteClanMember( member )) disabled=@(!CanPromoteClanMember( member ))>+</button>
															<button class="clan-mini-btn" onclick=@(() => DemoteClanMember( member )) disabled=@(!CanDemoteClanMember( member ))>-</button>
															<button class="clan-mini-btn danger" onclick=@(() => KickClanMember( member.SteamId ))>Kick</button>
														</div>
													}
												</div>
											}
										</div>

										<div class="clan-actions">
											<button class="clan-btn" onclick=@LeaveClan>Leave</button>
											@if ( Player.Local?.ClanRank == ClanRank.Leader )
											{
												<button class="clan-btn danger" onclick=@DeleteClan>Delete Clan</button>
											}
										</div>
									</div>

									@if ( ClanManager.CanEditSettingsRank( Player.Local?.ClanRank ?? ClanRank.Soldier ) )
									{
										<div class="clan-settings">
											<div class="clan-section-title">Settings</div>
											<TextEntry class="clan-input" Value="@EditClanDescription" Placeholder="Description" OnTextEdited=@(( string text ) => UpdateEditDescription( text )) />
											<div class="clan-section-title small">Clan color</div>
											<div class="clan-color-row">
												@foreach ( var color in ClanPalette.Colors )
												{
													<button class="clan-color-btn @(IsColorSelected( EditClanColorId, color.Value ) ? "active" : "")" style=@($"background-color: {color.Swatch};") onclick=@(() => SetEditClanColor( color.Value ))></button>
												}
											</div>
											<div class="clan-section-title small">Logo</div>
											<div class="clan-logo-grid">
												@foreach ( var icon in ClanLogoCatalog.Icons )
												{
													<button class="clan-logo-option @(IsIconSelected( EditClanIconPath, icon.Path ) ? "active" : "")" onclick=@(() => SetEditClanIcon( icon.Path ))>
														@if ( string.IsNullOrWhiteSpace( icon.Path ) )
														{
															<span>None</span>
														}
														else
														{
															<div class="clan-logo-option-icon" style=@($"background-image: url({icon.Path});")></div>
														}
													</button>
												}
											</div>
											<div class="clan-section-title small">Background</div>
											<div class="clan-bg-row">
												@foreach ( var bgType in BackgroundTypes )
												{
													<button class="clan-bg-btn @(EditClanBackgroundType == bgType ? "active" : "")" onclick=@(() => SetEditClanBackgroundType( bgType ))>@bgType</button>
												}
											</div>
											@for ( var i = 1; i <= 4; i++ )
											{
												var colorIndex = i;
												<div class="clan-bg-color-line">
													<div class="clan-muted narrow">BG @colorIndex</div>
													<div class="clan-color-row small">
														@foreach ( var color in ClanPalette.Colors )
														{
															<button class="clan-color-btn small @(IsColorSelected( GetEditBackgroundColor( colorIndex ), color.Value ) ? "active" : "")" style=@($"background-color: {color.Swatch};") onclick=@(() => SetEditBackgroundColor( colorIndex, color.Value ))></button>
														}
													</div>
												</div>
											}
										</div>
									}
								</div>
							}
							else if ( inviteClanId < 0 )
							{
								<div class="clan-create">
									<div class="clan-create-form">
										<div class="clan-muted">Create a clan for $@ClanManager.CreatePrice. Header cannot be changed later.</div>
										<div class="clan-warning">Warning: Header is permanent after creation.</div>
										<TextEntry class="clan-input" Value="@CreateClanHeader" Placeholder="Header" OnTextEdited=@SetCreateClanHeader />
										<TextEntry class="clan-input" Value="@CreateClanDescription" Placeholder="Description" OnTextEdited=@SetCreateClanDescription />
										<div class="clan-section-title small">Clan color</div>
										<div class="clan-color-row">
											@foreach ( var color in ClanPalette.Colors )
											{
												<button class="clan-color-btn @(IsColorSelected( CreateClanColorId, color.Value ) ? "active" : "")" style=@($"background-color: {color.Swatch};") onclick=@(() => SetCreateClanColor( color.Value ))></button>
											}
										</div>
										<div class="clan-section-title small">Logo</div>
										<div class="clan-logo-grid">
											@foreach ( var icon in ClanLogoCatalog.Icons )
											{
												<button class="clan-logo-option @(IsIconSelected( CreateClanIconPath, icon.Path ) ? "active" : "")" onclick=@(() => SetCreateClanIcon( icon.Path ))>
													@if ( string.IsNullOrWhiteSpace( icon.Path ) )
													{
														<span>None</span>
													}
													else
													{
														<div class="clan-logo-option-icon" style=@($"background-image: url({icon.Path});")></div>
													}
												</button>
											}
										</div>
										<div class="clan-section-title small">Background</div>
										<div class="clan-bg-row">
											@foreach ( var bgType in BackgroundTypes )
											{
												<button class="clan-bg-btn @(CreateClanBackgroundType == bgType ? "active" : "")" onclick=@(() => SetCreateClanBackgroundType( bgType ))>@bgType</button>
											}
										</div>
										@for ( var i = 1; i <= 4; i++ )
										{
											var colorIndex = i;
											<div class="clan-bg-color-line">
												<div class="clan-muted narrow">BG @colorIndex</div>
												<div class="clan-color-row small">
													@foreach ( var color in ClanPalette.Colors )
													{
														<button class="clan-color-btn small @(IsColorSelected( GetCreateBackgroundColor( colorIndex ), color.Value ) ? "active" : "")" style=@($"background-color: {color.Swatch};") onclick=@(() => SetCreateBackgroundColor( colorIndex, color.Value ))></button>
													}
												</div>
											</div>
										}
										<button class="clan-btn primary create" onclick=@CreateClan disabled=@((Player.Local?.Money ?? 0) < ClanManager.CreatePrice)>Create $@ClanManager.CreatePrice</button>
										@if ( !string.IsNullOrWhiteSpace( CreateClanError ) )
										{
											<div class="clan-create-error">@CreateClanError</div>
										}
									</div>
									<div class="clan-create-preview">
										<div class="clan-logo-preview large @GetClanLogoBackgroundClass( CreateClanBackgroundType )" style="@GetClanLogoStyle( CreateClanBackgroundType, CreateClanBackgroundColor1, CreateClanBackgroundColor2, CreateClanBackgroundColor3, CreateClanBackgroundColor4 )">
											@foreach ( var paneStyle in GetClanLogoPaneStyles( CreateClanBackgroundType, CreateClanBackgroundColor1, CreateClanBackgroundColor2, CreateClanBackgroundColor3, CreateClanBackgroundColor4 ) )
											{
												<div class="clan-logo-pane" style="@paneStyle"></div>
											}
											@if ( !string.IsNullOrWhiteSpace( CreateClanIconPath ) )
											{
												<div class="clan-logo-icon large" style="@GetClanIconStyle( CreateClanIconPath, CreateClanColorId )"></div>
											}
										</div>
										<div class="clan-title" style="color: @ColorCss( CreateClanColorId );">@GetPreviewHeader()</div>
									</div>
								</div>
							}
						</div>
					}
					else if ( ActiveTab == 4 )
					{
						<div class="page">
							<div class="page-title">@GameLocalization.Phrase( "ui.tab.help" )</div>
							<div class="help-list">
								<div class="help-row"><div class="help-key">Tab</div><div class="help-desc">@GameLocalization.Phrase( "ui.help.menu" )</div></div>
								<div class="help-row"><div class="help-key">WASD</div><div class="help-desc">@GameLocalization.Phrase( "ui.help.movement" )</div></div>
								<div class="help-row"><div class="help-key">Space</div><div class="help-desc">@GameLocalization.Phrase( "ui.help.jump" )</div></div>
								<div class="help-row"><div class="help-key">F</div><div class="help-desc">@GameLocalization.Phrase( "ui.help.interact" )</div></div>
								<div class="help-row"><div class="help-key">1-9</div><div class="help-desc">@GameLocalization.Phrase( "ui.help.hotbar" )</div></div>
								<div class="help-row"><div class="help-key">Enter</div><div class="help-desc">@GameLocalization.Phrase( "ui.help.chat" )</div></div>
							</div>
						</div>
					}

				</div>
			</div>
		</div>
	}
</root>

@code
{
	const string ModalId = nameof( TabMenu );
	bool IsOpen { get; set; } = false;
	TimeUntil DiscordCloseAt { get; set; } = 0f;
	bool IsDiscordOpening { get; set; } = false;

	private void OpenDiscord()
	{
		IsDiscordOpening = true;
		DiscordCloseAt = 5f;
		StateHasChanged();
	}
	int ActiveTab { get; set; } = 0;
	List<Connection> CachedPlayers { get; set; } = new();
	List<JobDefinition> AvailableJobs { get; set; } = new();
	List<ShopDefinition> AvailableShopItems { get; set; } = new();
	IEnumerable<JobDefinition> VisibleJobs => AvailableJobs.Where( CanLocalSeeJob );
	IEnumerable<ShopDefinition> VisibleShopItems => AvailableShopItems.Where( IsShopAllowed );
	int PlayersVersion { get; set; } = 0;
	int JobsVersion { get; set; } = 0;
	int ShopVersion { get; set; } = 0;
	static readonly ClanBackgroundType[] BackgroundTypes =
	{
		ClanBackgroundType.Mono,
		ClanBackgroundType.VerticalTwo,
		ClanBackgroundType.VerticalThree,
		ClanBackgroundType.Quarter,
		ClanBackgroundType.HorizontalTwo,
		ClanBackgroundType.HorizontalThree
	};
	string CreateClanHeader { get; set; } = "";
	string CreateClanDescription { get; set; } = "";
	string CreateClanColorId { get; set; } = ClanPalette.DefaultColorId;
	string CreateClanIconPath { get; set; } = "";
	ClanBackgroundType CreateClanBackgroundType { get; set; } = ClanBackgroundType.Mono;
	string CreateClanBackgroundColor1 { get; set; } = "black";
	string CreateClanBackgroundColor2 { get; set; } = "black";
	string CreateClanBackgroundColor3 { get; set; } = "black";
	string CreateClanBackgroundColor4 { get; set; } = "black";
	string CreateClanError { get; set; } = "";
	int LastEditClanId { get; set; } = -1;
	string EditClanDescription { get; set; } = "";
	string EditClanColorId { get; set; } = ClanPalette.DefaultColorId;
	string EditClanIconPath { get; set; } = "";
	ClanBackgroundType EditClanBackgroundType { get; set; } = ClanBackgroundType.Mono;
	string EditClanBackgroundColor1 { get; set; } = "black";
	string EditClanBackgroundColor2 { get; set; } = "black";
	string EditClanBackgroundColor3 { get; set; } = "black";
	string EditClanBackgroundColor4 { get; set; } = "black";

	private bool IsLanguage( string code ) => string.Equals( GameLocalization.CurrentCode, code, StringComparison.OrdinalIgnoreCase );

	private void SetLanguage( string code )
	{
		GameLocalization.SetLanguage( code );
		StateHasChanged();
	}

	private string GetLocalJobName()
	{
		return GameLocalization.JobHeader( Player.Local?.Job?.JobDefinition );
	}

	void SelectPlayersTab()
	{
		ActiveTab = 2;
		CachedPlayers = Connection.All.ToList();
		PlayersVersion++;
	}

	void SelectShopTab()
	{
		ActiveTab = 1;
	}

	void SelectClanTab()
	{
		ActiveTab = 3;
		SyncEditClanState();
	}

	void SelectHelpTab()
	{
		ActiveTab = 4;
	}

	void SelectJobsTab()
	{
		ActiveTab = 0;
		LoadJobs();
	}

	private void LoadJobs()
	{
		AvailableJobs = ResourceLibrary
			.GetAll<JobDefinition>()
			.OrderBy( x => GameLocalization.Category( x.Category ) )
			.ThenBy( GameLocalization.JobHeader )
			.ToList();

		JobsVersion++;
	}

	private void LoadShop()
	{
		AvailableShopItems = ResourceLibrary
			.GetAll<ShopDefinition>()
			.OrderBy( x => GameLocalization.Category( x.Category ) )
			.ThenBy( GameLocalization.ShopHeader )
			.ToList();

		ShopVersion++;
	}

	private static string GetShortDescription( string description )
	{
		var text = (description ?? string.Empty).Trim();
		if ( text.Length <= 0 )
			return GameLocalization.Phrase( "common.no_description", "No description" );

		const int maxLen = 110;
		return text.Length <= maxLen ? text : $"{text[..maxLen]}...";
	}

	private int GetJobPlayersCount( string jobId )
	{
		var scene = Game.ActiveScene;
		if ( scene is null || string.IsNullOrWhiteSpace( jobId ) )
			return 0;

		var count = 0;
		foreach ( var player in scene.GetAllComponents<Player>() )
		{
			if ( string.Equals( player?.Job?.JobId, jobId, StringComparison.Ordinal ) )
				count++;
		}

		return count;
	}

	private int GetJobsPopulationHash()
	{
		var hash = 17;
		foreach ( var job in VisibleJobs )
		{
			hash = HashCode.Combine( hash, job.Id, GetJobPlayersCount( job.Id ) );
		}

		return hash;
	}

	private bool CanLocalSeeJob( JobDefinition job )
	{
		if ( job is null )
			return false;

		if ( job.FromJobs is null || job.FromJobs.Count <= 0 )
			return true;

		var localJobId = Player.Local?.Job?.JobId;
		if ( string.IsNullOrWhiteSpace( localJobId ) )
			return false;

		return job.FromJobs.Any( allowedJob => allowedJob is not null && string.Equals( allowedJob.Id, localJobId, StringComparison.Ordinal ) );
	}

	private string GetPlayerJobName( Connection connection )
	{
		if ( connection is null )
			return GameLocalization.Phrase( "common.no_job", "No Job" );

		return GameLocalization.JobHeader( FindPlayerBySteamId( connection.SteamId.Value )?.Job?.JobDefinition );
	}

	private int GetPlayersJobHash()
	{
		var hash = 17;
		foreach ( var connection in CachedPlayers )
		{
			hash = HashCode.Combine( hash, connection.SteamId.Value, GetPlayerJobName( connection ) );
		}

		return hash;
	}

	private void RequestJoinJob( string jobId )
	{
		var normalized = (jobId ?? string.Empty).Trim();
		if ( normalized.Length <= 0 )
			return;

		var job = AvailableJobs.FirstOrDefault( x => x is not null && string.Equals( x.Id, normalized, StringComparison.Ordinal ) );
		if ( job is not null && !CanLocalSeeJob( job ) )
		{
			Notification.Error( GameLocalization.Phrase( "notify.jobs.not_allowed_from_job", "This job is not available to you." ), 3.5f );
			return;
		}

		RpcRequestJoinJob( normalized );
	}

	private bool IsShopAllowed( ShopDefinition shop )
	{
		if ( shop is null )
			return false;

		if ( shop.IsAllowEveryone )
			return true;

		var localJob = Player.Local?.Job?.JobDefinition;
		if ( localJob is null || shop.JobsAllow is null || shop.JobsAllow.Count == 0 )
			return false;

		return shop.JobsAllow.Any( x => x is not null && string.Equals( x.Id, localJob.Id, StringComparison.Ordinal ) );
	}

	private bool CanFitShopItem( ShopDefinition shop )
	{
		var itemId = shop?.ItemDefinition?.Id;
		if ( string.IsNullOrWhiteSpace( itemId ) )
			return true;

		return Player.Local?.Inventory?.CanAddItem( itemId, 1 ) ?? false;
	}

	private bool HasShopPurchaseAction( ShopDefinition shop )
	{
		return shop is not null && (shop.ItemDefinition is not null || shop.HasPostPurchased);
	}

	private string GetShopStatus( ShopDefinition shop, bool canAfford, bool canFitItem, bool hasPurchaseAction )
	{
		if ( !canAfford )
			return GameLocalization.Phrase( "ui.shop.not_enough_money", "Not enough money" );

		if ( !canFitItem )
			return GameLocalization.Phrase( "ui.shop.inventory_full", "Inventory full" );

		if ( !hasPurchaseAction )
			return GameLocalization.Phrase( "ui.shop.unavailable", "Unavailable" );

		if ( shop?.HasPostPurchased == true && shop.ItemDefinition is null )
			return GameLocalization.Phrase( "ui.shop.spawns_in_world", "Spawns in world" );

		return GameLocalization.Phrase( "ui.shop.available", "Available" );
	}

	private string GetShopIconStyle( ShopDefinition shop )
	{
		var icon = string.IsNullOrWhiteSpace( shop?.IconPath ) ? "icons/items/default.vtex" : shop.IconPath;
		return $"background-image: url({icon})";
	}

	private int GetInventoryHash()
	{
		var inventory = Player.Local?.Inventory;
		if ( inventory is null )
			return 0;

		var hash = 17;
		foreach ( var slot in inventory.Slots )
		{
			hash = HashCode.Combine( hash, slot.Item?.Id, slot.Item?.Count ?? 0 );
		}

		return hash;
	}

	private void RequestPurchase( ShopDefinition shop )
	{
		var normalized = (shop?.Id ?? string.Empty).Trim();
		if ( normalized.Length <= 0 )
			return;

		if ( !IsShopAllowed( shop ) )
		{
			Notification.Error( GameLocalization.Phrase( "notify.shop.job_cannot_buy", "Your job cannot buy this." ), 3.5f );
			return;
		}

		if ( (Player.Local?.Money ?? 0) < shop.Price )
		{
			Notification.Error( GameLocalization.Format( "notify.shop.need_money", "Need ${0}.", shop.Price ), 3.5f );
			return;
		}

		if ( !CanFitShopItem( shop ) )
		{
			Notification.Error( GameLocalization.Phrase( "notify.inventory.full", "Inventory is full." ), 3.5f );
			return;
		}

		if ( !HasShopPurchaseAction( shop ) )
		{
			Notification.Error( GameLocalization.Phrase( "notify.shop.unavailable", "Shop item is unavailable." ), 3.5f );
			return;
		}

		ShopManager.RpcRequestPurchase( normalized );
	}

	private ClanSummary GetLocalClanSummary()
	{
		var clanId = Player.Local?.ClanId ?? -1;
		if ( clanId < 0 )
			return null;

		var summary = ClanManager.Instance?.GetClanSummary( clanId );
		if ( summary is not null )
			return summary;

		return new ClanSummary
		{
			Id = clanId,
			Header = Player.Local?.ClanHeader ?? "",
			ColorId = Player.Local?.ClanColorId ?? ClanPalette.DefaultColorId,
			Description = "",
			Logo = new ClanLogo(),
			MemberCount = 1,
			LeaderSteamId = Connection.Local?.SteamId.Value ?? 0L,
			LeaderOnline = (Player.Local?.ClanRank ?? ClanRank.Soldier) == ClanRank.Leader,
			OnlineMembers = new List<ClanMemberSummary>
			{
				new()
				{
					SteamId = Connection.Local?.SteamId.Value ?? 0L,
					Name = Connection.Local?.DisplayName ?? "",
					Rank = Player.Local?.ClanRank ?? ClanRank.Soldier
				}
			}
		};
	}

	private void SyncEditClanState()
	{
		var clan = GetLocalClanSummary();
		if ( clan is null || clan.Id == LastEditClanId )
			return;

		LastEditClanId = clan.Id;
		EditClanDescription = clan.Description ?? "";
		EditClanColorId = ClanPalette.NormalizeColorId( clan.ColorId );
		EditClanIconPath = ClanLogoCatalog.NormalizeIconPath( clan.Logo?.IconPath );
		EditClanBackgroundType = clan.Logo?.BackgroundType ?? ClanBackgroundType.Mono;
		EditClanBackgroundColor1 = ClanPalette.NormalizeColorId( clan.Logo?.BackgroundColor1, "black" );
		EditClanBackgroundColor2 = ClanPalette.NormalizeColorId( clan.Logo?.BackgroundColor2, "black" );
		EditClanBackgroundColor3 = ClanPalette.NormalizeColorId( clan.Logo?.BackgroundColor3, "black" );
		EditClanBackgroundColor4 = ClanPalette.NormalizeColorId( clan.Logo?.BackgroundColor4, "black" );
	}

	private void CreateClan()
	{
		ClearCreateClanError();

		if ( ClanText.NormalizeHeader( CreateClanHeader ).Length <= 0 )
		{
			SetCreateClanError( "Clan header is empty." );
			Notification.Error( "Clan header is empty.", 3f );
			return;
		}

		if ( CreateClanHeader.Length > ClanText.HeaderMaxLength )
		{
			SetCreateClanError( $"Clan header limit is {ClanText.HeaderMaxLength} characters." );
			Notification.Error( $"Clan header limit is {ClanText.HeaderMaxLength} characters.", 3f );
			return;
		}

		if ( CreateClanDescription.Length > ClanText.DescriptionMaxLength )
		{
			SetCreateClanError( $"Clan description limit is {ClanText.DescriptionMaxLength} characters." );
			Notification.Error( $"Clan description limit is {ClanText.DescriptionMaxLength} characters.", 3f );
			return;
		}

		ClanManager.RpcRequestCreateClan( CreateClanHeader, CreateClanDescription, CreateClanColorId, CreateClanIconPath, CreateClanBackgroundType.ToString(), CreateClanBackgroundColor1, CreateClanBackgroundColor2, CreateClanBackgroundColor3, CreateClanBackgroundColor4 );
	}

