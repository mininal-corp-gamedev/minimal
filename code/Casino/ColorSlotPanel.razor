@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent

<root>
    @{
        var s = ColorSlotState.Instance;
    }

    @if ( s is not null && s.IsOpen )
    {
        <div class="modal">

            @* ── Шапка ── *@
            <div class="modal-header">
                <div class="header-text">
                    <div class="modal-title">COLOR SLOT</div>
                    <div class="modal-sub">Pick your color — double or nothing</div>
                </div>
                <div class="close-btn" onclick=@Close>X</div>
            </div>

            @* ── Ставка ── *@
            <div class="bet-banner">
                <span class="bet-label">FIXED BET</span>
                <span class="bet-value">$@( s.ActiveSlot?.BetAmount ?? 0 )</span>
                <span class="bet-win">WIN: $@( (s.ActiveSlot?.BetAmount ?? 0) * 2 )</span>
            </div>

            @* ── Область результата ── *@
            <div class="result-area @ResultAreaClass(s)">
                @if ( s.IsWaiting )
                {
                    <div class="res-wait">Rolling...</div>
                }
                else if ( s.NoMoney )
                {
                    <div class="res-nomoney">NOT ENOUGH MONEY</div>
                }
                else if ( s.HasResult )
                {
                    <div class="res-color-dot @( s.ResultGreen ? "dot-green" : "dot-red" )"></div>
                    <div class="res-color-label">@( s.ResultGreen ? "GREEN" : "RED" )</div>
                    <div class="res-outcome @( s.ResultWon ? "res-win" : "res-lose" )">
                        @( s.ResultWon ? "YOU WIN" : "YOU LOSE" )
                    </div>
                    @if ( s.ResultWon )
                    {
                        <div class="res-payout">+$@( (s.ActiveSlot?.BetAmount ?? 0) * 2 )</div>
                    }
                }
                else
                {
                    <div class="res-idle-icon">?</div>
                    <div class="res-idle-text">Place your bet to play</div>
                }
            </div>

            @* ── Кнопки ── *@
            <div class="btn-row">
                <div class="btn btn-green @( s.IsWaiting ? "btn-off" : "" )"
                     onclick=@BetGreen>
                    <div class="btn-dot dot-green-sm"></div>
                    <div class="btn-label">GREEN</div>
                    <div class="btn-odds">x2</div>
                </div>
                <div class="btn btn-red @( s.IsWaiting ? "btn-off" : "" )"
                     onclick=@BetRed>
                    <div class="btn-dot dot-red-sm"></div>
                    <div class="btn-label">RED</div>
                    <div class="btn-odds">x2</div>
                </div>
            </div>

            @* ── Футер ── *@
            <div class="modal-footer">
                50 / 50 chance  —  Fair random roll
            </div>

        </div>
    }

</root>

@code {
    private void Close()    => ColorSlotState.Instance?.Close();
    private void BetGreen() => ColorSlotState.Instance?.PlaceBet( true );
    private void BetRed()   => ColorSlotState.Instance?.PlaceBet( false );

    private string ResultAreaClass( ColorSlotState s )
    {
        if ( !s.HasResult || s.NoMoney ) return "";
        return s.ResultGreen ? "area-green" : "area-red";
    }

    protected override int BuildHash()
    {
        var s = ColorSlotState.Instance;
        if ( s is null ) return 0;
        return System.HashCode.Combine(
            s.IsOpen,
            s.IsWaiting,
            s.HasResult,
            s.ResultWon,
            s.ResultGreen,
            s.NoMoney
        );
    }
}

<style>

    root {
        width: 100%;
        height: 100%;
        position: absolute;
        pointer-events: none;
        background-color: transparent;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal {
        width: 560px;
        background-color: #0a0a12;
        border: 1px solid rgba(255,255,255,0.10);
        border-radius: 14px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        font-family: "Roboto Mono", monospace;
        pointer-events: all;
    }

    /* ── Шапка ── */
    .modal-header {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        padding: 22px 24px 20px 24px;
        background-color: #0d0d1a;
        border-bottom: 1px solid rgba(255,255,255,0.07);
    }

    .modal-title {
        font-size: 18px;
        font-weight: 700;
        letter-spacing: 4px;
        color: rgba(255,255,255,0.90);
    }

    .modal-sub {
        font-size: 11px;
        letter-spacing: 1px;
        color: rgba(255,255,255,0.32);
        margin-top: 4px;
    }

    .close-btn {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 8px;
        font-size: 15px;
        font-weight: 700;
        color: rgba(255,255,255,0.45);
        cursor: pointer;
        pointer-events: all;
    }

    .close-btn:hover {
        background-color: rgba(200,30,30,0.60);
        border-color: rgba(220,50,50,0.40);
        color: white;
    }

    /* ── Баннер ставки ── */
    .bet-banner {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        padding: 16px 24px;
        background-color: rgba(240,208,96,0.04);
        border-bottom: 1px solid rgba(240,208,96,0.10);
    }

    .bet-label {
        font-size: 11px;
        letter-spacing: 2px;
        color: rgba(255,255,255,0.30);
    }

    .bet-value {
        font-size: 28px;
        font-weight: 700;
        color: #f0d060;
    }

    .bet-win {
        font-size: 13px;
        font-weight: 700;
        color: rgba(80,255,128,0.65);
        letter-spacing: 1px;
    }

    /* ── Результат ── */
    .result-area {
        min-height: 180px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 24px;
        background-color: #0c0c16;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .area-green { background-color: rgba(10,80,30,0.65); }
    .area-red   { background-color: rgba(80,10,10,0.65); }

    .res-color-dot {
        width: 24px;
        height: 24px;
        border-radius: 50%;
    }

    .dot-green { background-color: #40dd70; }
    .dot-red   { background-color: #dd4040; }

    .res-color-label {
        font-size: 28px;
        font-weight: 700;
        letter-spacing: 4px;
        color: white;
    }

    .res-outcome {
        font-size: 16px;
        font-weight: 700;
        letter-spacing: 2px;
    }

    .res-win  { color: #50ff80; }
    .res-lose { color: #ff5050; }

    .res-payout {
        font-size: 22px;
        font-weight: 700;
        color: #f0d060;
    }

    .res-wait {
        font-size: 15px;
        letter-spacing: 3px;
        color: rgba(255,255,255,0.40);
    }

    .res-nomoney {
        font-size: 14px;
        letter-spacing: 2px;
        color: #f09040;
        font-weight: 700;
    }

    .res-idle-icon {
        font-size: 52px;
        color: rgba(255,255,255,0.07);
        font-weight: 700;
    }

    .res-idle-text {
        font-size: 12px;
        letter-spacing: 1px;
        color: rgba(255,255,255,0.22);
    }

    /* ── Кнопки ── */
    .btn-row {
        display: flex;
        flex-direction: row;
        gap: 14px;
        padding: 20px 24px;
    }

    .btn {
        flex: 1;
        height: 64px;
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        gap: 10px;
        border-radius: 10px;
        cursor: pointer;
        pointer-events: all;
    }

    .btn-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .dot-green-sm { background-color: #50ff80; }
    .dot-red-sm   { background-color: #ff5050; }

    .btn-label {
        font-size: 15px;
        font-weight: 700;
        letter-spacing: 3px;
    }

    .btn-odds {
        font-size: 12px;
        font-weight: 700;
        opacity: 0.50;
        letter-spacing: 1px;
    }

    .btn-green {
        background-color: rgba(15,90,35,0.90);
        border: 1px solid rgba(40,180,70,0.25);
        color: #60ff90;
    }

    .btn-green:hover {
        background-color: rgba(20,120,48,1);
        border-color: rgba(50,210,80,0.55);
    }

    .btn-red {
        background-color: rgba(90,15,15,0.90);
        border: 1px solid rgba(180,40,40,0.25);
        color: #ff6060;
    }

    .btn-red:hover {
        background-color: rgba(120,20,20,1);
        border-color: rgba(210,50,50,0.55);
    }

    .btn-off {
        opacity: 0.25;
        pointer-events: none;
    }

    /* ── Футер ── */
    .modal-footer {
        padding: 12px 24px;
        font-size: 11px;
        letter-spacing: 1px;
        color: rgba(255,255,255,0.20);
        text-align: center;
        background-color: #0d0d1a;
        border-top: 1px solid rgba(255,255,255,0.05);
    }

</style>
