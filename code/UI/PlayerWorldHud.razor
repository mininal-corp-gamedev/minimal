@using Sandbox;
@using Sandbox.UI;
@using System;
@inherits PanelComponent
@namespace Sandbox

<root>
	@if ( ShouldShow )
	{
		<div class="title">@Name</div>
		@if ( !string.IsNullOrWhiteSpace( JobName ) )
		{
			<div class="job">@JobName</div>
		}
		<div class="health-bar">
			<div class="health-fill" style="width: @(HealthPercent)%;"></div>
			<div class="health-text">@HealthDisplay / @MaxHealthDisplay</div>
		</div>
	}
</root>

@code
{
	[Sync] public string Name { get; set; } = "";

	Player TargetPlayer => Components.Get<Player>( FindMode.EverythingInSelfAndAncestors );

	bool ShouldShow => TargetPlayer is null || (!TargetPlayer.IsLocalPlayer && !TargetPlayer.IsDead);

	float HealthValue => TargetPlayer?.Health ?? 0f;
	float MaxHealthValue => TargetPlayer is { MaxHealth: > 0f } p ? p.MaxHealth : 1f;
	string JobName => TargetPlayer?.Job?.JobDefinition is null ? "" : GameLocalization.JobHeader( TargetPlayer.Job.JobDefinition );

	float HealthPercent => Math.Clamp( HealthValue / MaxHealthValue * 100f, 0f, 100f );

	int HealthDisplay => (int)MathF.Round( HealthValue );
	int MaxHealthDisplay => (int)MathF.Round( MaxHealthValue );

	public void WorldHudRefresh() => StateHasChanged();

	protected override int BuildHash() => System.HashCode.Combine( ShouldShow, Name, JobName, HealthValue, MaxHealthValue, GameLocalization.CurrentCode );
}
