@using Sandbox;
@using Sandbox.UI;
@using System;
@inherits PanelComponent
@namespace Sandbox

<root>
	@if ( IsOpen && UiModalManager.IsActive( ModalId ) )
	{
		<div class="context-overlay">
			<div class="context-wheel">
				<div class="wheel-ring"></div>
				@foreach ( var action in Actions )
				{
					<button class="context-action @action.PositionClass @(ActiveAction == action.Id ? "active" : "")" onmouseover=@(() => ActiveAction = action.Id) onclick=@(() => RunAction( action.Id ))>
						<div class="action-icon @action.IconClass"></div>
						<div class="action-title">@action.Title</div>
						<div class="action-subtitle">@action.Subtitle</div>
					</button>
				}

				<div class="center-info">
					<div class="center-label">Действие</div>
				</div>
			</div>

			<div class="context-hint">Нажми действие или C, чтобы закрыть.</div>
		</div>

		@if ( VotePanel.HasOpenVote )
		{
			<div class="context-vote-panel">
				<div class="context-vote-header">@VotePanel.CurrentHeader</div>

				@if ( VotePanel.CanAnswer )
				{
					<div class="context-vote-actions">
						<button class="vote-yes" onclick=@(() => VotePanel.SubmitCurrent( true ))>Yes</button>
						<button class="vote-no" onclick=@(() => VotePanel.SubmitCurrent( false ))>No</button>
					</div>
				}
			</div>
		}
	}
</root>

@code
{
	const string ModalId = nameof( ContextMenu );
	bool IsOpen { get; set; }
	string ActiveAction { get; set; } = "drop_money";

	static readonly ContextAction[] Actions =
	{
		new( "drop_money", "Выкинуть деньги", "Наличные", "pos-left", "money" ),
		new( "transfer_money", "Передать деньги", "Игрок напротив", "pos-right", "money" ),
		new( "demote", "Уволить", "Голосование", "pos-bottom", "job" )
	};

	void RunAction( string id )
	{
		ActiveAction = id;
		Close();

		if ( id == "drop_money" )
		{
			DropMoneyConfirmPanel.Open();
			return;
		}

		if ( id == "transfer_money" )
			TransferMoneyConfirmPanel.TryOpenForLookTarget();

		if ( id == "demote" )
			DemotePanel.Open();
	}

	void Close()
	{
		SetOpen( false );
	}

		private void SetOpen( bool open )
	{
		if ( open )
			UiModalManager.Open( ModalId );
		else
			UiModalManager.Close( ModalId );

		IsOpen = open;

		Crosshair.SetBlocked( ModalId, open );

		UiModalManager.UpdateMouseVisibility();
		StateHasChanged();
	}

	private void OnActiveModalChanged( string activeModal )
	{
		if ( activeModal == ModalId || !IsOpen )
			return;

		IsOpen = false;
		Crosshair.SetBlocked( ModalId, false );
		StateHasChanged();
	}

	protected override void OnUpdate()
	{
		if ( Input.Pressed( "Context" ) )
		{
			SetOpen( !IsOpen );
		}

		if ( IsOpen )
		{
			UiModalManager.UpdateMouseVisibility();
		}
	}

	protected override void OnStart()
	{
		UiModalManager.ActiveModalChanged += OnActiveModalChanged;
	}

	protected override void OnDisabled()
	{
		ReleaseCrosshairBlock();
	}

	protected override void OnDestroy()
	{
		UiModalManager.ActiveModalChanged -= OnActiveModalChanged;
		ReleaseCrosshairBlock();
	}

	private void ReleaseCrosshairBlock()
	{
		IsOpen = false;
		Crosshair.SetBlocked( ModalId, false );
		UiModalManager.Close( ModalId );
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( IsOpen );
		hash.Add( UiModalManager.Version );
		hash.Add( ActiveAction );
		hash.Add( Player.Local?.Money ?? 0 );
		hash.Add( Player.Local?.Job?.JobDefinition?.Header );
		hash.Add( Player.Local?.Health ?? 0f );
		hash.Add( VotePanel.HasOpenVote );
		hash.Add( VotePanel.CanAnswer );
		hash.Add( VotePanel.CurrentHeader );
		return hash.ToHashCode();
	}

	sealed class ContextAction
	{
		public string Id { get; }
		public string Title { get; }
		public string Subtitle { get; }
		public string PositionClass { get; }
		public string IconClass { get; }

		public ContextAction( string id, string title, string subtitle, string positionClass, string iconClass )
		{
			Id = id;
			Title = title;
			Subtitle = subtitle;
			PositionClass = positionClass;
			IconClass = iconClass;
		}
	}
}
