@using Sandbox
@using Sandbox.UI
@using System
@inherits PanelComponent
@namespace Sandbox

<root>
	<div class="boombox-world">
		<div class="owner">@OwnerTitle</div>
		<div class="status @(IsRadioEnabled ? "on" : "off")">@StatusText</div>
		<div class="health">@HealthText</div>
	</div>
</root>

@code
{
	private Boombox TargetBoombox => Components.Get<Boombox>( FindMode.EverythingInSelfAndAncestors );

	private ShopObject ParentShopObject => GameObject?.Parent?.Components.Get<ShopObject>( FindMode.EverythingInSelfAndAncestors );

	private bool IsRadioEnabled => TargetBoombox?.IsRadioEnabled ?? false;

	private float Health => MathF.Max( 0f, TargetBoombox?.Health ?? 0f );

	private float MaxHealth => MathF.Max( 1f, TargetBoombox?.MaxHealth ?? 1f );

	private string OwnerTitle
	{
		get
		{
			var owner = ParentShopObject?.PlayerOwner;
			if ( owner.IsValid() )
			{
				var name = owner.GameObject.Network.Owner?.DisplayName;
				if ( !string.IsNullOrWhiteSpace( name ) )
					return name;
			}

			return "Boombox";
		}
	}

	private string StatusText => IsRadioEnabled ? "Radio On" : "Radio Off";

	private string HealthText => $"HP {MathF.Ceiling( Health )} / {MathF.Ceiling( MaxHealth )}";

	protected override int BuildHash()
	{
		return HashCode.Combine(
			OwnerTitle,
			IsRadioEnabled,
			Health,
			MaxHealth,
			GameLocalization.CurrentCode );
	}
}
