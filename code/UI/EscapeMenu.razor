@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Collections.Generic;
@using System.Linq;
@inherits PanelComponent
@namespace Sandbox

<root>
	@if ( IsDiscordOpening )
	{
		<WebPanel class="discord-webpanel" Url="@DiscordInviteUrl" />
	}
	@if ( IsVisible && UiModalManager.IsActive( ModalId ) )
	{
		<div class="overlay" style="opacity: @OpacityCss">
			<div class="em-panel">

				<div class="sidebar">
					<div class="sidebar-logo">
						<div class="logo-image" style="background-image: url('@LogoPath');"></div>
					</div>

					<div class="sidebar-nav">
						<button class="tab-btn" onclick=@OnPlayClicked>@GameLocalization.Phrase( "ui.escape.play", "Resume" )</button>
						<button class="tab-btn @(ActiveSection == 1 ? "active" : "")" onclick=@OnSettingsClicked>@GameLocalization.Phrase( "ui.escape.settings", "Settings" )</button>
						<button class="tab-btn" onclick=@OnSandboxSettingsClicked>@GameLocalization.Phrase( "ui.escape.sandbox_settings", "s&box settings" )</button>
						<button class="tab-btn" onclick=@OnReviewClicked>@GameLocalization.Phrase( "ui.escape.review", "Review" )</button>
						<button class="tab-btn" onclick=@OnPlayersClicked>@GameLocalization.Phrase( "ui.escape.players", "Players" )</button>
						<button class="tab-btn danger" onclick=@OnExitClicked>@GameLocalization.Phrase( "ui.escape.exit", "Exit" )</button>
					</div>

					<div class="sidebar-spacer"></div>

					<div class="sidebar-bottom-row">
						<button class="discord-btn" onclick=@OpenDiscord>@GameLocalization.Phrase( "ui.escape.discord", "Discord" )</button>
						<button class="discord-btn ghost" onclick=@OpenDiscord>@GameLocalization.Phrase( "ui.escape.server", "Server" )</button>
					</div>

					<div class="language-switcher">
						<button class="language-btn @(IsLanguage( GameLocalization.EnglishCode ) ? "active" : "")" onmousedown=@(() => SetLanguage( GameLocalization.EnglishCode )) onclick=@(() => SetLanguage( GameLocalization.EnglishCode ))>EN</button>
						<button class="language-btn @(IsLanguage( GameLocalization.RussianCode ) ? "active" : "")" onmousedown=@(() => SetLanguage( GameLocalization.RussianCode )) onclick=@(() => SetLanguage( GameLocalization.RussianCode ))>RU</button>
					</div>
				</div>

				<div class="content-area">
					@if ( ActiveSection == 1 )
					{
						<div class="settings-page">
							<div class="page-title">@GameLocalization.Phrase( "ui.escape.settings", "Settings" )</div>
							<button class="settings-btn" onclick=@OnPropProtectionClicked>@GameLocalization.Phrase( "ui.escape.prop_protection", "Add to Prop Protection" )</button>
							@if ( ShowPropProtectionList )
							{
								<div class="prop-protection-list">
									<div class="prop-protection-header">@GameLocalization.Phrase( "ui.escape.prop_protection_title", "Prop Protection" )</div>
									@foreach ( var conn in PropProtectionPlayers )
									{
										var sid = conn.SteamId.Value;
										var localSteamId = Player.Local?.GameObject.Network.Owner?.SteamId.Value ?? 0L;
										var isSelf = sid == localSteamId;
										var isProtected = !isSelf && Player.Local.IsValid() && Player.Local.IsInPropProtection( sid );
										<div class="prop-protection-row">
											<div class="prop-protection-avatar" style="background-image: url( avatar:@sid )"></div>
											<div class="prop-protection-info">
												<div class="prop-protection-name">@conn.DisplayName</div>
												<div class="prop-protection-job">@GetPlayerJobName( conn )</div>
											</div>
											@if ( isSelf )
											{
											}
											else if ( isProtected )
											{
												<button class="prop-protection-del-btn" onclick=@(() => OnRemovePropProtection( conn ))>@GameLocalization.Phrase( "ui.common.delete" )</button>
											}
											else
											{
												<button class="prop-protection-add-btn" onclick=@(() => OnAddPropProtection( conn ))>@GameLocalization.Phrase( "ui.common.add" )</button>
											}
										</div>
									}
								</div>
							}
						</div>
					}
					else
					{
						<div class="web-frame">
							<WebPanel class="right-web" Url="https://google.com" />
						</div>
					}
				</div>

			</div>
		</div>
	}
</root>

@code
{
	const string ModalId = nameof( EscapeMenu );
	const float AnimDuration = 0.25f;
	const string DiscordInviteUrl = "https://discord.gg/azPnN8F7xQ";

	[Property] public string LogoPath { get; set; } = "icons/logos/logo_small_dark2.vtex";

	bool IsOpen { get; set; } = false;
	bool IsVisible { get; set; } = false;
	bool IsOpening { get; set; } = false;
	TimeUntil AnimUntil { get; set; } = 0f;

	int ActiveSection { get; set; } = 0;

	bool IsDiscordOpening { get; set; } = false;
	TimeUntil DiscordCloseAt { get; set; } = 0f;
	bool ShowPropProtectionList { get; set; } = false;
	List<Connection> PropProtectionPlayers { get; set; } = new();

	float Progress
	{
		get
		{
			var remaining = MathF.Max( 0f, (float)AnimUntil );
			var t = 1f - (remaining / AnimDuration);
			return Math.Clamp( t, 0f, 1f );
		}
	}

	float Opacity => IsOpening ? Progress : (1f - Progress);

	string OpacityCss => Opacity.ToString( "0.###", System.Globalization.CultureInfo.InvariantCulture );

	private void StartOpen()
	{
		IsOpen = true;
		IsVisible = true;
		IsOpening = true;
		AnimUntil = AnimDuration;
		ActiveSection = 0;
		UiModalManager.Open( ModalId );
		Crosshair.SetBlocked( ModalId, true );
		UiModalManager.UpdateMouseVisibility();
		StateHasChanged();
	}

	private void StartClose()
	{
		if ( !IsOpen )
			return;

		IsOpen = false;
		IsOpening = false;
		AnimUntil = AnimDuration;
		UiModalManager.Close( ModalId );
		Crosshair.SetBlocked( ModalId, false );
		UiModalManager.UpdateMouseVisibility();
		StateHasChanged();
	}

	private void Toggle()
	{
		if ( IsOpen )
			StartClose();
		else
			StartOpen();
	}

	private void OnPlayClicked()
	{
		StartClose();
	}

	private void OnSettingsClicked()
	{
		ActiveSection = ActiveSection == 1 ? 0 : 1;
		if ( ActiveSection != 1 )
			ShowPropProtectionList = false;
		StateHasChanged();
	}

	private void OnPropProtectionClicked()
	{
		ShowPropProtectionList = !ShowPropProtectionList;
		if ( ShowPropProtectionList )
			RefreshPropProtectionPlayers();
		StateHasChanged();
	}

	private void RefreshPropProtectionPlayers()
	{
		var localSteamId = Player.Local?.GameObject.Network.Owner?.SteamId.Value ?? 0L;
		PropProtectionPlayers = Connection.All
			.Where( c => c is not null )
			.OrderByDescending( c => c.SteamId.Value == localSteamId )
			.ThenBy( c => c.DisplayName )
			.ToList();
	}

	private void OnAddPropProtection( Connection conn )
	{
		if ( conn is null || !Player.Local.IsValid() )
			return;

		Player.Local.RpcRequestAddPropProtection( conn.SteamId.Value );
		RefreshPropProtectionPlayers();
		StateHasChanged();
	}

	private void OnRemovePropProtection( Connection conn )
	{
		if ( conn is null || !Player.Local.IsValid() )
			return;

		Player.Local.RpcRequestRemovePropProtection( conn.SteamId.Value );
		RefreshPropProtectionPlayers();
		StateHasChanged();
	}

	private static string GetPlayerJobName( Connection connection )
	{
		if ( connection is null )
			return GameLocalization.Phrase( "common.no_job", "No Job" );

		return GameLocalization.JobHeader( FindPlayerBySteamId( connection.SteamId.Value )?.Job?.JobDefinition );
	}

	private static Player FindPlayerBySteamId( long steamId ) => Player.FindPlayerBySteamId( steamId );

	private void OnSandboxSettingsClicked()
	{
		Game.Overlay.ShowSettingsModal();
	}

	private void OnReviewClicked()
	{
		_ = ShowReviewAsync();
	}

	private static async System.Threading.Tasks.Task ShowReviewAsync()
	{
		try
		{
			Package package = null;

			// На хосте/в редакторе можно взять пакет из текущего проекта напрямую.
			var project = Project.Current;
			if ( project is not null )
				package = project.Package;

			// На клиенте Project.Current == null — тянем пакет по идентификатору игры.
			if ( package is null )
			{
				package = await Package.FetchAsync( "minimalinc.mrp", false );
			}

			if ( package is null )
			{
				Log.Warning( "EscapeMenu: не удалось получить Package для Review modal." );
				return;
			}

			Game.Overlay.ShowReviewModal( package );
		}
		catch ( System.Exception ex )
		{
			Log.Warning( $"EscapeMenu: ошибка открытия Review modal: {ex.Message}" );
		}
	}

	private void OnPlayersClicked()
	{
		Game.Overlay.ShowPlayerList();
	}

	private void OnExitClicked()
	{
		Game.Close();
	}

	private void OpenDiscord()
	{
		IsDiscordOpening = true;
		DiscordCloseAt = 5f;
		StateHasChanged();
	}

	protected override void OnStart()
	{
		UiModalManager.ActiveModalChanged += OnActiveModalChanged;
	}

	private bool IsLanguage( string code ) => string.Equals( GameLocalization.CurrentCode, code, StringComparison.OrdinalIgnoreCase );

	private void SetLanguage( string code )
	{
		GameLocalization.SetLanguage( code );
		StateHasChanged();
	}

	protected override void OnDestroy()
	{
		UiModalManager.ActiveModalChanged -= OnActiveModalChanged;
		if ( UiModalManager.IsActive( ModalId ) )
			UiModalManager.Close( ModalId );
		Crosshair.SetBlocked( ModalId, false );
	}

	private void OnActiveModalChanged( string activeModal )
	{
		if ( activeModal == ModalId || !IsOpen )
			return;

		IsOpen = false;
		IsOpening = false;
		AnimUntil = AnimDuration;
		Crosshair.SetBlocked( ModalId, false );
		StateHasChanged();
	}

	protected override void OnUpdate()
	{
		if ( Input.EscapePressed )
		{
			Input.EscapePressed = false;
			Toggle();
		}

		if ( IsVisible && !IsOpen && !IsOpening && AnimUntil <= 0f )
		{
			IsVisible = false;
			StateHasChanged();
		}

		if ( IsDiscordOpening && DiscordCloseAt <= 0f )
		{
			IsDiscordOpening = false;
			StateHasChanged();
		}

		UiModalManager.UpdateMouseVisibility();
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( IsVisible );
		hash.Add( IsOpen );
		hash.Add( IsOpening );
		hash.Add( ActiveSection );
		hash.Add( IsDiscordOpening );
		hash.Add( UiModalManager.Version );
		hash.Add( GameLocalization.CurrentCode );
		hash.Add( GameLocalization.Version );
		hash.Add( ShowPropProtectionList );
		hash.Add( PropProtectionPlayers.Count );
		hash.Add( Player.Local?.PropProtectionIdsSerialized );

		// Перерисовываем каждый кадр во время анимации, чтобы плавно менять opacity.
		if ( IsVisible && AnimUntil > 0f )
			hash.Add( Time.Now );

		return hash.ToHashCode();
	}
}
